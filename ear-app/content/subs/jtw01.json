{
 "id": "jtw01",
 "title": "The Monkey",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 17.679,
   "end": 19.179,
   "en": "",
   "zh": "从时间开始"
  },
  {
   "i": 2,
   "start": 19.179,
   "end": 22.39,
   "en": "",
   "zh": "一块岩石高高耸立在山顶上"
  },
  {
   "i": 3,
   "start": 22.39,
   "end": 23.31,
   "en": "",
   "zh": "太阳"
  },
  {
   "i": 4,
   "start": 23.31,
   "end": 24.15,
   "en": "",
   "zh": "月亮"
  },
  {
   "i": 5,
   "start": 24.15,
   "end": 27.42,
   "en": "",
   "zh": "天地万物都在岩石上施展魔法"
  },
  {
   "i": 6,
   "start": 28.899,
   "end": 31.28,
   "en": "",
   "zh": "有一天岩石裂开了"
  },
  {
   "i": 7,
   "start": 33.76,
   "end": 35.699,
   "en": "",
   "zh": "里面是一只猴子"
  },
  {
   "i": 8,
   "start": 38.86,
   "end": 41.22,
   "en": "",
   "zh": "猴子站起来伸了个懒腰"
  },
  {
   "i": 9,
   "start": 45.04,
   "end": 48.459,
   "en": "",
   "zh": "突然从他的眼睛里射出强大的光"
  },
  {
   "i": 10,
   "start": 52.08,
   "end": 55.66,
   "en": "",
   "zh": "刹那间，光明照到了天上的云宫"
  },
  {
   "i": 11,
   "start": 57.0,
   "end": 60.12,
   "en": "",
   "zh": "玉皇大帝坐了起来"
  },
  {
   "i": 12,
   "start": 60.46,
   "end": 64.06,
   "en": "",
   "zh": "他转向站在附近的一个船长"
  },
  {
   "i": 13,
   "start": 65.14,
   "end": 66.96,
   "en": "",
   "zh": "找出是什么导致了那道光"
  },
  {
   "i": 14,
   "start": 66.96,
   "end": 67.7,
   "en": "",
   "zh": "皇帝说"
  },
  {
   "i": 15,
   "start": 68.9,
   "end": 69.1,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 16,
   "start": 69.1,
   "end": 71.039,
   "en": "",
   "zh": "“陛下，”船长说"
  },
  {
   "i": 17,
   "start": 72.7,
   "end": 74.899,
   "en": "",
   "zh": "船长冲出大厅"
  },
  {
   "i": 18,
   "start": 76.6,
   "end": 78.66,
   "en": "",
   "zh": "他望着天堂的南门"
  },
  {
   "i": 19,
   "start": 78.66,
   "end": 83.14,
   "en": "",
   "zh": "看到光下的地球上的猴子不见了"
  },
  {
   "i": 20,
   "start": 83.44,
   "end": 85.6,
   "en": "",
   "zh": "但船长有神奇的视力"
  },
  {
   "i": 21,
   "start": 86.6,
   "end": 91.08,
   "en": "",
   "zh": "他能看到刚刚发生的一切有趣的事情"
  },
  {
   "i": 22,
   "start": 91.08,
   "end": 92.46,
   "en": "",
   "zh": "船长说"
  },
  {
   "i": 23,
   "start": 94.68,
   "end": 96.74,
   "en": "",
   "zh": "玉皇大帝说得好"
  },
  {
   "i": 24,
   "start": 96.74,
   "end": 97.84,
   "en": "",
   "zh": "当船长回来的时候"
  },
  {
   "i": 25,
   "start": 98.88,
   "end": 100.34,
   "en": "",
   "zh": "是什么导致了光"
  },
  {
   "i": 26,
   "start": 101.34,
   "end": 102.5,
   "en": "",
   "zh": "是一只猴子"
  },
  {
   "i": 27,
   "start": 102.5,
   "end": 103.14,
   "en": "",
   "zh": "船长说"
  },
  {
   "i": 28,
   "start": 104.42,
   "end": 106.92,
   "en": "",
   "zh": "一只猴子问玉皇大帝"
  },
  {
   "i": 29,
   "start": 107.36,
   "end": 107.96,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 30,
   "start": 107.96,
   "end": 109.08,
   "en": "",
   "zh": "船长说"
  },
  {
   "i": 31,
   "start": 109.08,
   "end": 112.28,
   "en": "",
   "zh": "他在地球上的花果山上"
  },
  {
   "i": 32,
   "start": 112.8,
   "end": 115.02,
   "en": "",
   "zh": "山上有一块石头"
  },
  {
   "i": 33,
   "start": 116.08,
   "end": 118.12,
   "en": "",
   "zh": "猴子从岩石里出来了"
  },
  {
   "i": 34,
   "start": 118.12,
   "end": 121.02,
   "en": "",
   "zh": "光线从猴子的眼睛里射出来"
  },
  {
   "i": 35,
   "start": 123.2,
   "end": 124.98,
   "en": "",
   "zh": "皇帝想了一会儿"
  },
  {
   "i": 36,
   "start": 124.98,
   "end": 126.16,
   "en": "",
   "zh": "然后耸耸肩"
  },
  {
   "i": 37,
   "start": 127.42,
   "end": 128.78,
   "en": "",
   "zh": "我并不感到惊讶"
  },
  {
   "i": 38,
   "start": 128.78,
   "end": 129.86,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 39,
   "start": 130.919,
   "end": 134.24,
   "en": "",
   "zh": "当天地一起工作时，惊人的事情就会发生"
  },
  {
   "i": 40,
   "start": 147.239,
   "end": 148.699,
   "en": "",
   "zh": "随着时间的流逝"
  },
  {
   "i": 41,
   "start": 148.699,
   "end": 150.479,
   "en": "",
   "zh": "猴子学会了走路"
  },
  {
   "i": 42,
   "start": 150.479,
   "end": 152.48,
   "en": "",
   "zh": "奔跑和攀登"
  },
  {
   "i": 43,
   "start": 154.859,
   "end": 156.319,
   "en": "",
   "zh": "他喝小溪里的水"
  },
  {
   "i": 44,
   "start": 156.319,
   "end": 158.0,
   "en": "",
   "zh": "吃草和树叶"
  },
  {
   "i": 45,
   "start": 160.439,
   "end": 164.18,
   "en": "",
   "zh": "他采集水果，探索洞穴和山顶"
  },
  {
   "i": 46,
   "start": 168.879,
   "end": 174.16,
   "en": "",
   "zh": "他在晚上和所有其他猴子和猿猴成了朋友"
  },
  {
   "i": 47,
   "start": 174.16,
   "end": 176.08,
   "en": "",
   "zh": "他睡在悬崖下"
  },
  {
   "i": 48,
   "start": 177.28,
   "end": 179.1,
   "en": "",
   "zh": "一个非常热的早晨"
  },
  {
   "i": 49,
   "start": 179.1,
   "end": 182.38,
   "en": "",
   "zh": "所有的猴子和猿猴都在树荫下玩耍"
  },
  {
   "i": 50,
   "start": 183.4,
   "end": 185.68,
   "en": "",
   "zh": "今天太热了"
  },
  {
   "i": 51,
   "start": 185.68,
   "end": 187.34,
   "en": "",
   "zh": "一只猴子叫道"
  },
  {
   "i": 52,
   "start": 188.44,
   "end": 190.38,
   "en": "",
   "zh": "让我们在小溪里玩"
  },
  {
   "i": 53,
   "start": 190.88,
   "end": 191.88,
   "en": "",
   "zh": "好主意"
  },
  {
   "i": 54,
   "start": 191.88,
   "end": 193.36,
   "en": "",
   "zh": "另一只猴子说"
  },
  {
   "i": 55,
   "start": 193.36,
   "end": 195.64,
   "en": "",
   "zh": "猴子和猿跑向小溪"
  },
  {
   "i": 56,
   "start": 196.68,
   "end": 199.16,
   "en": "",
   "zh": "水在岩石上滚来滚去"
  },
  {
   "i": 57,
   "start": 201.06,
   "end": 203.84,
   "en": "",
   "zh": "猴子跳入清凉的水中"
  },
  {
   "i": 58,
   "start": 205.499,
   "end": 209.419,
   "en": "",
   "zh": "几分钟后，每个人都溅起了水花，玩了起来"
  },
  {
   "i": 59,
   "start": 209.419,
   "end": 211.62,
   "en": "",
   "zh": "一只猴子挠了挠头"
  },
  {
   "i": 60,
   "start": 212.2,
   "end": 214.06,
   "en": "",
   "zh": "我们都喜欢这条小溪"
  },
  {
   "i": 61,
   "start": 214.06,
   "end": 217.34,
   "en": "",
   "zh": "她说我们用它喝水"
  },
  {
   "i": 62,
   "start": 217.34,
   "end": 218.62,
   "en": "",
   "zh": "我们在里面游泳"
  },
  {
   "i": 63,
   "start": 218.62,
   "end": 221.94,
   "en": "",
   "zh": "我们知道它一直流向海洋"
  },
  {
   "i": 64,
   "start": 222.26,
   "end": 225.34,
   "en": "",
   "zh": "但有人知道小溪从哪里开始吗"
  },
  {
   "i": 65,
   "start": 226.139,
   "end": 228.98,
   "en": "",
   "zh": "他们面面相觑，摇摇头"
  },
  {
   "i": 66,
   "start": 230.62,
   "end": 232.82,
   "en": "",
   "zh": "我们今天无事可做"
  },
  {
   "i": 67,
   "start": 232.82,
   "end": 233.9,
   "en": "",
   "zh": "猴子继续说"
  },
  {
   "i": 68,
   "start": 234.94,
   "end": 238.36,
   "en": "",
   "zh": "我们何不顺流而下，寻找源头呢？"
  },
  {
   "i": 69,
   "start": 238.919,
   "end": 240.339,
   "en": "",
   "zh": "听起来很有趣"
  },
  {
   "i": 70,
   "start": 240.339,
   "end": 241.519,
   "en": "",
   "zh": "另一只猴子说"
  },
  {
   "i": 71,
   "start": 242.519,
   "end": 243.219,
   "en": "",
   "zh": "我们走吧"
  },
  {
   "i": 72,
   "start": 243.219,
   "end": 244.96,
   "en": "",
   "zh": "第三只猴子说"
  },
  {
   "i": 73,
   "start": 245.54,
   "end": 247.42,
   "en": "",
   "zh": "大家都跃出水面"
  },
  {
   "i": 74,
   "start": 247.42,
   "end": 249.52,
   "en": "",
   "zh": "他们沿着小溪奔跑"
  },
  {
   "i": 75,
   "start": 249.52,
   "end": 252.04,
   "en": "",
   "zh": "从一棵树荡到另一棵树"
  },
  {
   "i": 76,
   "start": 252.2,
   "end": 256.279,
   "en": "",
   "zh": "他们跳过岩石，爬上陡峭的悬崖"
  },
  {
   "i": 77,
   "start": 256.44,
   "end": 257.519,
   "en": "",
   "zh": "越来越高"
  },
  {
   "i": 78,
   "start": 257.519,
   "end": 261.959,
   "en": "",
   "zh": "他们上山直到到达一个巨大的瀑布"
  },
  {
   "i": 79,
   "start": 262.06,
   "end": 263.98,
   "en": "",
   "zh": "空气中弥漫着薄雾"
  },
  {
   "i": 80,
   "start": 263.98,
   "end": 265.76,
   "en": "",
   "zh": "水哗啦啦地流下来"
  },
  {
   "i": 81,
   "start": 265.76,
   "end": 267.58,
   "en": "",
   "zh": "轰鸣如雷"
  },
  {
   "i": 82,
   "start": 270.179,
   "end": 272.379,
   "en": "",
   "zh": "我想知道瀑布后面是什么"
  },
  {
   "i": 83,
   "start": 272.379,
   "end": 273.499,
   "en": "",
   "zh": "一只猴子说"
  },
  {
   "i": 84,
   "start": 274.499,
   "end": 277.019,
   "en": "",
   "zh": "第二只猴子说"
  },
  {
   "i": 85,
   "start": 277.019,
   "end": 279.48,
   "en": "",
   "zh": "但没人能跳过去"
  },
  {
   "i": 86,
   "start": 280.16,
   "end": 282.54,
   "en": "",
   "zh": "谁能跳过去活着回来"
  },
  {
   "i": 87,
   "start": 282.54,
   "end": 283.54,
   "en": "",
   "zh": "将成为我们的国王"
  },
  {
   "i": 88,
   "start": 283.54,
   "end": 284.84,
   "en": "",
   "zh": "一只长臂猿说"
  },
  {
   "i": 89,
   "start": 284.84,
   "end": 287.18,
   "en": "",
   "zh": "有没有人有足够的勇气去尝试"
  },
  {
   "i": 90,
   "start": 287.479,
   "end": 289.999,
   "en": "",
   "zh": "所有的猴子和猿都面面相觑"
  },
  {
   "i": 91,
   "start": 290.999,
   "end": 292.879,
   "en": "",
   "zh": "他们摇摇头"
  },
  {
   "i": 92,
   "start": 294.56,
   "end": 296.58,
   "en": "",
   "zh": "我不打算尝试"
  },
  {
   "i": 93,
   "start": 296.58,
   "end": 298.38,
   "en": "",
   "zh": "一只高猴子说"
  },
  {
   "i": 94,
   "start": 300.14,
   "end": 302.84,
   "en": "",
   "zh": "一只矮猴子说"
  },
  {
   "i": 95,
   "start": 302.84,
   "end": 304.6,
   "en": "",
   "zh": "一个声音喊道"
  },
  {
   "i": 96,
   "start": 304.6,
   "end": 305.82,
   "en": "",
   "zh": "我来做"
  },
  {
   "i": 97,
   "start": 306.579,
   "end": 308.159,
   "en": "",
   "zh": "大家都让开了"
  },
  {
   "i": 98,
   "start": 308.159,
   "end": 309.619,
   "en": "",
   "zh": "当演讲者走上前去时"
  },
  {
   "i": 99,
   "start": 310.979,
   "end": 312.42,
   "en": "",
   "zh": "是猴子"
  },
  {
   "i": 100,
   "start": 312.9,
   "end": 315.28,
   "en": "",
   "zh": "你确定长臂猿问"
  },
  {
   "i": 101,
   "start": 315.28,
   "end": 317.38,
   "en": "",
   "zh": "看起来很危险"
  },
  {
   "i": 102,
   "start": 317.72,
   "end": 318.6,
   "en": "",
   "zh": "猴子笑了"
  },
  {
   "i": 103,
   "start": 319.88,
   "end": 321.34,
   "en": "",
   "zh": "我什么都不怕"
  },
  {
   "i": 104,
   "start": 321.34,
   "end": 322.64,
   "en": "",
   "zh": "当我回来的时候"
  },
  {
   "i": 105,
   "start": 322.64,
   "end": 323.98,
   "en": "",
   "zh": "我将成为国王"
  },
  {
   "i": 106,
   "start": 324.3,
   "end": 328.22,
   "en": "",
   "zh": "猴子深吸一口气，跳入瀑布"
  },
  {
   "i": 107,
   "start": 337.179,
   "end": 341.22,
   "en": "",
   "zh": "一只猴子飞溅着穿过瀑布，落在一个大洞穴里"
  },
  {
   "i": 108,
   "start": 343.599,
   "end": 345.42,
   "en": "",
   "zh": "他的眼睛睁得大大的"
  },
  {
   "i": 109,
   "start": 345.78,
   "end": 349.86,
   "en": "",
   "zh": "山洞里长满了竹树和美丽的花朵"
  }
 ]
}
