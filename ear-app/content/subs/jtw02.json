 "lines": [
  {
   "i": 1,
   "start": 2.38,
   "end": 3.8,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 3.8,
   "end": 5.14,
   "en": "",
   "zh": "第二章"
  },
  {
   "i": 3,
   "start": 5.14,
   "end": 8.06,
   "en": "",
   "zh": "瀑布洞"
  },
  {
   "i": 4,
   "start": 13.32,
   "end": 17.36,
   "en": "",
   "zh": "猴子们溅起水花穿过瀑布，落在一个大洞穴里"
  },
  {
   "i": 5,
   "start": 19.719,
   "end": 21.62,
   "en": "",
   "zh": "他的眼睛睁得大大的"
  },
  {
   "i": 6,
   "start": 21.9,
   "end": 26.74,
   "en": "",
   "zh": "山洞里长满了竹树和美丽的花朵"
  },
  {
   "i": 7,
   "start": 27.599,
   "end": 29.36,
   "en": "",
   "zh": "苔藓覆盖了墙壁"
  },
  {
   "i": 8,
   "start": 31.16,
   "end": 33.18,
   "en": "",
   "zh": "一条小溪从山洞里流过"
  },
  {
   "i": 9,
   "start": 33.18,
   "end": 36.08,
   "en": "",
   "zh": "空气中弥漫着发光的光和薄雾"
  },
  {
   "i": 10,
   "start": 38.06,
   "end": 40.58,
   "en": "",
   "zh": "猴子发现了一张长桌和碗"
  },
  {
   "i": 11,
   "start": 40.58,
   "end": 41.959,
   "en": "",
   "zh": "杯子和盘子"
  },
  {
   "i": 12,
   "start": 42.4,
   "end": 45.059,
   "en": "",
   "zh": "壁炉靠着一面墙"
  },
  {
   "i": 13,
   "start": 46.86,
   "end": 48.28,
   "en": "",
   "zh": "在洞穴深处"
  },
  {
   "i": 14,
   "start": 48.28,
   "end": 53.08,
   "en": "",
   "zh": "猴子发现卧室外面有舒适的床"
  },
  {
   "i": 15,
   "start": 53.08,
   "end": 56.26,
   "en": "",
   "zh": "其他猴子和猿都在看瀑布"
  },
  {
   "i": 16,
   "start": 56.8,
   "end": 58.48,
   "en": "",
   "zh": "你觉得他挺过来了吗"
  },
  {
   "i": 17,
   "start": 58.48,
   "end": 61.32,
   "en": "",
   "zh": "一只猴子问"
  },
  {
   "i": 18,
   "start": 61.32,
   "end": 63.019,
   "en": "",
   "zh": "另一只猴子说"
  },
  {
   "i": 19,
   "start": 63.24,
   "end": 66.32,
   "en": "",
   "zh": "他可能被水冲走了"
  },
  {
   "i": 20,
   "start": 68.32,
   "end": 74.74,
   "en": "",
   "zh": "突然飞溅的猴子从瀑布中冲了出来，落在了一群人的面前"
  },
  {
   "i": 21,
   "start": 76.58,
   "end": 77.74,
   "en": "",
   "zh": "你还活着"
  },
  {
   "i": 22,
   "start": 77.74,
   "end": 79.22,
   "en": "",
   "zh": "猴子说"
  },
  {
   "i": 23,
   "start": 79.22,
   "end": 80.26,
   "en": "",
   "zh": "猴子笑了"
  },
  {
   "i": 24,
   "start": 81.86,
   "end": 82.26,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 25,
   "start": 82.26,
   "end": 84.3,
   "en": "",
   "zh": "我们很幸运"
  },
  {
   "i": 26,
   "start": 84.72,
   "end": 86.08,
   "en": "",
   "zh": "我找到了一个完美的家"
  },
  {
   "i": 27,
   "start": 86.08,
   "end": 88.36,
   "en": "",
   "zh": "因为我们所有人都跟着我"
  },
  {
   "i": 28,
   "start": 89.36,
   "end": 91.44,
   "en": "",
   "zh": "猴子从水里跳了回来"
  },
  {
   "i": 29,
   "start": 93.36,
   "end": 95.52,
   "en": "",
   "zh": "有些猴子挠挠头"
  },
  {
   "i": 30,
   "start": 96.14,
   "end": 98.12,
   "en": "",
   "zh": "看起来还是很危险"
  },
  {
   "i": 31,
   "start": 98.12,
   "end": 99.82,
   "en": "",
   "zh": "一只猴子说"
  },
  {
   "i": 32,
   "start": 100.92,
   "end": 101.8,
   "en": "",
   "zh": "我们走吧"
  },
  {
   "i": 33,
   "start": 101.8,
   "end": 103.08,
   "en": "",
   "zh": "长臂猿说"
  },
  {
   "i": 34,
   "start": 103.08,
   "end": 105.52,
   "en": "",
   "zh": "他跳过瀑布"
  },
  {
   "i": 35,
   "start": 105.98,
   "end": 106.94,
   "en": "",
   "zh": "之后呢"
  },
  {
   "i": 36,
   "start": 106.94,
   "end": 109.1,
   "en": "",
   "zh": "另一只猴子跳了过去"
  },
  {
   "i": 37,
   "start": 110.82,
   "end": 112.86,
   "en": "",
   "zh": "然后又有一些人跳了起来"
  },
  {
   "i": 38,
   "start": 115.24,
   "end": 118.38,
   "en": "",
   "zh": "很快所有的猴子和猿都进了山洞"
  },
  {
   "i": 39,
   "start": 119.36,
   "end": 122.58,
   "en": "",
   "zh": "每个人都跑来跑去看所有精彩的东西"
  },
  {
   "i": 40,
   "start": 124.04,
   "end": 125.48,
   "en": "",
   "zh": "这个洞穴很漂亮"
  },
  {
   "i": 41,
   "start": 125.48,
   "end": 127.11,
   "en": "",
   "zh": "长臂猿说"
  },
  {
   "i": 42,
   "start": 127.11,
   "end": 130.07,
   "en": "",
   "zh": "一些猴子和猿开始打架和争吵"
  },
  {
   "i": 43,
   "start": 131.19,
   "end": 134.18,
   "en": "",
   "zh": "他们互相抢夺盘子和碗"
  },
  {
   "i": 44,
   "start": 134.4,
   "end": 136.92,
   "en": "",
   "zh": "其他人争夺卧室"
  },
  {
   "i": 45,
   "start": 137.679,
   "end": 138.839,
   "en": "",
   "zh": "我看到这张床"
  },
  {
   "i": 46,
   "start": 138.839,
   "end": 140.559,
   "en": "",
   "zh": "一只猴子首先喊道"
  },
  {
   "i": 47,
   "start": 141.679,
   "end": 143.699,
   "en": "",
   "zh": "不，另一只猴子叫道"
  },
  {
   "i": 48,
   "start": 143.699,
   "end": 145.939,
   "en": "",
   "zh": "我做了猴子"
  },
  {
   "i": 49,
   "start": 145.939,
   "end": 147.439,
   "en": "",
   "zh": "看了一会儿他的朋友们"
  },
  {
   "i": 50,
   "start": 147.439,
   "end": 148.939,
   "en": "",
   "zh": "然后双臂交叉"
  },
  {
   "i": 51,
   "start": 150.419,
   "end": 154.819,
   "en": "",
   "zh": "呵呵，他叫了所有的猴子和猿停止了他们正在做的事情"
  },
  {
   "i": 52,
   "start": 155.859,
   "end": 157.34,
   "en": "",
   "zh": "他们看着猴子"
  },
  {
   "i": 53,
   "start": 157.9,
   "end": 159.66,
   "en": "",
   "zh": "我为我们找到了这个洞穴"
  },
  {
   "i": 54,
   "start": 159.66,
   "end": 160.86,
   "en": "",
   "zh": "猴子说"
  },
  {
   "i": 55,
   "start": 161.179,
   "end": 161.959,
   "en": "",
   "zh": "就是说"
  },
  {
   "i": 56,
   "start": 161.959,
   "end": 163.179,
   "en": "",
   "zh": "我现在是你的国王"
  },
  {
   "i": 57,
   "start": 163.179,
   "end": 164.499,
   "en": "",
   "zh": "你为什么不向我鞠躬？"
  },
  {
   "i": 58,
   "start": 165.699,
   "end": 166.379,
   "en": "",
   "zh": "他是对的"
  },
  {
   "i": 59,
   "start": 166.379,
   "end": 167.62,
   "en": "",
   "zh": "长臂猿说"
  },
  {
   "i": 60,
   "start": 167.859,
   "end": 169.419,
   "en": "",
   "zh": "他向猴子鞠躬"
  },
  {
   "i": 61,
   "start": 169.419,
   "end": 172.08,
   "en": "",
   "zh": "说猴王万岁"
  },
  {
   "i": 62,
   "start": 173.04,
   "end": 174.84,
   "en": "",
   "zh": "其他人都向"
  },
  {
   "i": 63,
   "start": 183.7,
   "end": 185.46,
   "en": "",
   "zh": "许多年过去了"
  },
  {
   "i": 64,
   "start": 186.119,
   "end": 190.26,
   "en": "",
   "zh": "白天猴子和猿在森林和小溪里玩耍"
  },
  {
   "i": 65,
   "start": 190.58,
   "end": 193.68,
   "en": "",
   "zh": "每天晚上他们都在洞穴里安然入睡"
  },
  {
   "i": 66,
   "start": 195.179,
   "end": 197.939,
   "en": "",
   "zh": "一天晚上，猴子和猿类吃了一顿丰盛的盛宴"
  },
  {
   "i": 67,
   "start": 199.139,
   "end": 201.46,
   "en": "",
   "zh": "水果和坚果摆满了桌子"
  },
  {
   "i": 68,
   "start": 201.859,
   "end": 204.339,
   "en": "",
   "zh": "猴子和猿载歌载舞"
  },
  {
   "i": 69,
   "start": 204.339,
   "end": 205.96,
   "en": "",
   "zh": "当音乐响起"
  },
  {
   "i": 70,
   "start": 206.419,
   "end": 208.619,
   "en": "",
   "zh": "猴子坐在他的宝座上微笑着"
  },
  {
   "i": 71,
   "start": 209.699,
   "end": 211.719,
   "en": "",
   "zh": "但后来他的笑容消失了"
  },
  {
   "i": 72,
   "start": 211.719,
   "end": 213.72,
   "en": "",
   "zh": "很快他就皱起了眉头"
  },
  {
   "i": 73,
   "start": 213.959,
   "end": 216.919,
   "en": "",
   "zh": "长臂猿看到猴子就冲了过来"
  },
  {
   "i": 74,
   "start": 219.08,
   "end": 221.3,
   "en": "",
   "zh": "陛下，长臂猿说"
  },
  {
   "i": 75,
   "start": 221.3,
   "end": 222.68,
   "en": "",
   "zh": "你看起来很悲伤"
  },
  {
   "i": 76,
   "start": 222.68,
   "end": 223.82,
   "en": "",
   "zh": "怎么了？"
  },
  {
   "i": 77,
   "start": 225.139,
   "end": 226.599,
   "en": "",
   "zh": "猴子叹了口气"
  },
  {
   "i": 78,
   "start": 226.599,
   "end": 228.019,
   "en": "",
   "zh": "我们在这里的生活很完美"
  },
  {
   "i": 79,
   "start": 229.299,
   "end": 229.559,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 80,
   "start": 229.559,
   "end": 230.299,
   "en": "",
   "zh": "那倒是真的"
  },
  {
   "i": 81,
   "start": 230.299,
   "end": 231.479,
   "en": "",
   "zh": "长臂猿说"
  },
  {
   "i": 82,
   "start": 231.479,
   "end": 233.16,
   "en": "",
   "zh": "那你为什么悲伤"
  },
  {
   "i": 83,
   "start": 233.799,
   "end": 236.04,
   "en": "",
   "zh": "猴子安静了一会儿"
  },
  {
   "i": 84,
   "start": 236.479,
   "end": 237.499,
   "en": "",
   "zh": "然后他说"
  },
  {
   "i": 85,
   "start": 237.499,
   "end": 239.399,
   "en": "",
   "zh": "总有一天我们的生命会结束"
  },
  {
   "i": 86,
   "start": 239.399,
   "end": 242.14,
   "en": "",
   "zh": "我希望这种完美的生活能永远持续下去"
  },
  {
   "i": 87,
   "start": 242.439,
   "end": 244.3,
   "en": "",
   "zh": "长臂猿的眼睛亮了起来"
  },
  {
   "i": 88,
   "start": 245.28,
   "end": 247.64,
   "en": "",
   "zh": "他说你想长生不老"
  },
  {
   "i": 89,
   "start": 248.84,
   "end": 249.86,
   "en": "",
   "zh": "我确实说过"
  },
  {
   "i": 90,
   "start": 249.86,
   "end": 250.64,
   "en": "",
   "zh": "猴子"
  },
  {
   "i": 91,
   "start": 251.019,
   "end": 252.659,
   "en": "",
   "zh": "长臂猿揉着下巴"
  },
  {
   "i": 92,
   "start": 253.859,
   "end": 255.7,
   "en": "",
   "zh": "那你就得跟圣人学习"
  },
  {
   "i": 93,
   "start": 256.519,
   "end": 257.879,
   "en": "",
   "zh": "圣贤是非常明智的"
  },
  {
   "i": 94,
   "start": 257.879,
   "end": 258.159,
   "en": "",
   "zh": "人"
  },
  {
   "i": 95,
   "start": 260.199,
   "end": 262.079,
   "en": "",
   "zh": "它们可以把自己变成其他动物"
  },
  {
   "i": 96,
   "start": 263.199,
   "end": 265.06,
   "en": "",
   "zh": "它们可以在天空中飞翔"
  },
  {
   "i": 97,
   "start": 265.679,
   "end": 267.98,
   "en": "",
   "zh": "他们知道如何永生"
  },
  {
   "i": 98,
   "start": 269.5,
   "end": 271.02,
   "en": "",
   "zh": "猴子又笑了"
  },
  {
   "i": 99,
   "start": 272.1,
   "end": 273.44,
   "en": "",
   "zh": "我在哪里可以找到圣人"
  },
  {
   "i": 100,
   "start": 273.44,
   "end": 274.42,
   "en": "",
   "zh": "他问"
  },
  {
   "i": 101,
   "start": 275.08,
   "end": 277.14,
   "en": "",
   "zh": "你必须找到一片有人类的土地"
  },
  {
   "i": 102,
   "start": 277.14,
   "end": 280.66,
   "en": "",
   "zh": "长臂猿说，在那里你会找到一个圣人"
  },
  {
   "i": 103,
   "start": 282.299,
   "end": 283.399,
   "en": "",
   "zh": "第二天早上"
  },
  {
   "i": 104,
   "start": 283.399,
   "end": 286.86,
   "en": "",
   "zh": "猴子造了一个木筏，把食物装上木筏"
  },
  {
   "i": 105,
   "start": 288.38,
   "end": 290.4,
   "en": "",
   "zh": "他把木筏推到河里"
  },
  {
   "i": 106,
   "start": 290.4,
   "end": 291.68,
   "en": "",
   "zh": "跳了上去"
  },
  {
   "i": 107,
   "start": 292.3,
   "end": 294.56,
   "en": "",
   "zh": "当木筏开始飘走时"
  },
  {
   "i": 108,
   "start": 294.56,
   "end": 297.26,
   "en": "",
   "zh": "猴子向他的朋友们挥手"
  },
  {
   "i": 109,
   "start": 298.08,
   "end": 298.96,
   "en": "",
   "zh": "别担心"
  },
  {
   "i": 110,
   "start": 298.96,
   "end": 302.14,
   "en": "",
   "zh": "在我学会如何永生之后，他叫道"
  },
  {
   "i": 111,
   "start": 302.14,
   "end": 304.04,
   "en": "",
   "zh": "我会回来的"
  },
  {
   "i": 112,
   "start": 317.04,
   "end": 318.52,
   "en": "",
   "zh": "从时间开始"
  },
  {
   "i": 113,
   "start": 318.52,
   "end": 320.36,
   "en": "",
   "zh": "一块石头高高耸立在上面"
  }
 ]
}
