{
 "id": "jtw03",
 "title": "Subodhi",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 2.6,
   "end": 3.82,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 3.82,
   "end": 5.2,
   "en": "",
   "zh": "第三章"
  },
  {
   "i": 3,
   "start": 5.2,
   "end": 6.58,
   "en": "",
   "zh": "苏博迪"
  },
  {
   "i": 4,
   "start": 14.96,
   "end": 18.14,
   "en": "",
   "zh": "猴子在海洋上航行了很长时间"
  },
  {
   "i": 5,
   "start": 18.76,
   "end": 21.5,
   "en": "",
   "zh": "最后他到达了一个新的地方"
  },
  {
   "i": 6,
   "start": 22.839,
   "end": 24.579,
   "en": "",
   "zh": "他走了很多年"
  },
  {
   "i": 7,
   "start": 24.579,
   "end": 27.06,
   "en": "",
   "zh": "访问城镇和会见人们"
  },
  {
   "i": 8,
   "start": 27.279,
   "end": 30.28,
   "en": "",
   "zh": "但他在任何地方都没有找到圣人"
  },
  {
   "i": 9,
   "start": 30.92,
   "end": 34.3,
   "en": "",
   "zh": "最终他来到了森林茂密的山区"
  },
  {
   "i": 10,
   "start": 36.2,
   "end": 38.14,
   "en": "",
   "zh": "他沿着陡峭的山间小路走去"
  },
  {
   "i": 11,
   "start": 38.14,
   "end": 40.14,
   "en": "",
   "zh": "很快就听到了砍的声音"
  },
  {
   "i": 12,
   "start": 41.2,
   "end": 43.919,
   "en": "",
   "zh": "一个樵夫正在劈柴"
  },
  {
   "i": 13,
   "start": 44.9,
   "end": 46.66,
   "en": "",
   "zh": "你好猴子说"
  },
  {
   "i": 14,
   "start": 46.66,
   "end": 48.94,
   "en": "",
   "zh": "这些山里有圣贤吗"
  },
  {
   "i": 15,
   "start": 48.94,
   "end": 51.22,
   "en": "",
   "zh": "樵夫放下斧头"
  },
  {
   "i": 16,
   "start": 52.8,
   "end": 54.94,
   "en": "",
   "zh": "你是只猴子"
  },
  {
   "i": 17,
   "start": 54.94,
   "end": 55.52,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 18,
   "start": 56.92,
   "end": 58.239,
   "en": "",
   "zh": "你在说话"
  },
  {
   "i": 19,
   "start": 58.64,
   "end": 59.16,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 20,
   "start": 59.16,
   "end": 61.099,
   "en": "",
   "zh": "我是说猴子"
  },
  {
   "i": 21,
   "start": 61.14,
   "end": 62.8,
   "en": "",
   "zh": "我想永远活下去"
  },
  {
   "i": 22,
   "start": 62.8,
   "end": 63.6,
   "en": "",
   "zh": "你知不知道"
  },
  {
   "i": 23,
   "start": 63.6,
   "end": 64.7,
   "en": "",
   "zh": "在那里我可以找到一个圣人"
  },
  {
   "i": 24,
   "start": 65.7,
   "end": 67.58,
   "en": "",
   "zh": "樵夫挠了挠头"
  },
  {
   "i": 25,
   "start": 67.58,
   "end": 68.32,
   "en": "",
   "zh": "嗯"
  },
  {
   "i": 26,
   "start": 68.32,
   "end": 68.92,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 27,
   "start": 68.92,
   "end": 70.22,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 28,
   "start": 70.22,
   "end": 73.36,
   "en": "",
   "zh": "一位名叫西奥尼的圣人住在这座山上"
  },
  {
   "i": 29,
   "start": 73.36,
   "end": 75.039,
   "en": "",
   "zh": "他很聪明"
  },
  {
   "i": 30,
   "start": 75.92,
   "end": 77.52,
   "en": "",
   "zh": "猴子很兴奋"
  },
  {
   "i": 31,
   "start": 77.52,
   "end": 79.16,
   "en": "",
   "zh": "我在哪里可以找到他"
  },
  {
   "i": 32,
   "start": 79.42,
   "end": 81.02,
   "en": "",
   "zh": "沿着这条小路"
  },
  {
   "i": 33,
   "start": 81.02,
   "end": 82.64,
   "en": "",
   "zh": "你会去他家"
  },
  {
   "i": 34,
   "start": 82.64,
   "end": 84.2,
   "en": "",
   "zh": "樵夫说"
  },
  {
   "i": 35,
   "start": 84.2,
   "end": 85.32,
   "en": "",
   "zh": "谢谢。"
  },
  {
   "i": 36,
   "start": 85.32,
   "end": 85.72,
   "en": "",
   "zh": "说"
  },
  {
   "i": 37,
   "start": 85.72,
   "end": 86.5,
   "en": "",
   "zh": "猴子"
  },
  {
   "i": 38,
   "start": 89.52,
   "end": 93.02,
   "en": "",
   "zh": "他向樵夫挥手告别，沿着小路跑去"
  },
  {
   "i": 39,
   "start": 93.6,
   "end": 98.2,
   "en": "",
   "zh": "不久，他看到一座寺庙建在山的一边"
  },
  {
   "i": 40,
   "start": 99.2,
   "end": 103.08,
   "en": "",
   "zh": "西博伊和他的学生坐在他寺庙的正厅里"
  },
  {
   "i": 41,
   "start": 103.62,
   "end": 105.5,
   "en": "",
   "zh": "他看着他最大的学生"
  },
  {
   "i": 42,
   "start": 106.98,
   "end": 108.06,
   "en": "",
   "zh": "请到门口去"
  },
  {
   "i": 43,
   "start": 108.06,
   "end": 111.98,
   "en": "",
   "zh": "西博迪说，一个新学生就要来了"
  },
  {
   "i": 44,
   "start": 111.98,
   "end": 113.08,
   "en": "",
   "zh": "让他进来"
  },
  {
   "i": 45,
   "start": 113.64,
   "end": 115.04,
   "en": "",
   "zh": "学生一脸懵逼"
  },
  {
   "i": 46,
   "start": 116.28,
   "end": 116.58,
   "en": "",
   "zh": "好的"
  },
  {
   "i": 47,
   "start": 116.58,
   "end": 117.1,
   "en": "",
   "zh": "师傅"
  },
  {
   "i": 48,
   "start": 117.1,
   "end": 122.16,
   "en": "",
   "zh": "他说学生起身走到寺庙门口"
  },
  {
   "i": 49,
   "start": 125.94,
   "end": 127.06,
   "en": "",
   "zh": "他朝外面看了看"
  },
  {
   "i": 50,
   "start": 128.539,
   "end": 130.22,
   "en": "",
   "zh": "你好叫猴子"
  },
  {
   "i": 51,
   "start": 130.22,
   "end": 132.28,
   "en": "",
   "zh": "我是来见西博伊的"
  },
  {
   "i": 52,
   "start": 134.139,
   "end": 135.139,
   "en": "",
   "zh": "过了一会儿"
  },
  {
   "i": 53,
   "start": 135.139,
   "end": 138.08,
   "en": "",
   "zh": "猴子站在圣人面前"
  },
  {
   "i": 54,
   "start": 138.419,
   "end": 139.999,
   "en": "",
   "zh": "我想做你的学生"
  },
  {
   "i": 55,
   "start": 139.999,
   "end": 141.319,
   "en": "",
   "zh": "猴子说"
  },
  {
   "i": 56,
   "start": 141.319,
   "end": 142.999,
   "en": "",
   "zh": "但你只是只猴子"
  },
  {
   "i": 57,
   "start": 142.999,
   "end": 144.219,
   "en": "",
   "zh": "西波迪说"
  },
  {
   "i": 58,
   "start": 144.219,
   "end": 146.44,
   "en": "",
   "zh": "你怎么能做我的学生"
  },
  {
   "i": 59,
   "start": 147.0,
   "end": 148.0,
   "en": "",
   "zh": "猴子笑"
  },
  {
   "i": 60,
   "start": 149.4,
   "end": 151.0,
   "en": "",
   "zh": "我可能是只猴子"
  },
  {
   "i": 61,
   "start": 151.0,
   "end": 154.24,
   "en": "",
   "zh": "但我可以走路，说话，做很多其他的事情"
  },
  {
   "i": 62,
   "start": 155.54,
   "end": 158.68,
   "en": "",
   "zh": "我旅行了将近13年才来到这里"
  },
  {
   "i": 63,
   "start": 158.68,
   "end": 161.0,
   "en": "",
   "zh": "我相信我能成为你的学生"
  },
  {
   "i": 64,
   "start": 161.54,
   "end": 162.32,
   "en": "",
   "zh": "Siboi"
  },
  {
   "i": 65,
   "start": 162.32,
   "end": 163.62,
   "en": "",
   "zh": "盯着猴子看了一会儿"
  },
  {
   "i": 66,
   "start": 164.9,
   "end": 166.08,
   "en": "",
   "zh": "你的父母是谁"
  },
  {
   "i": 67,
   "start": 166.08,
   "end": 167.12,
   "en": "",
   "zh": "他问"
  },
  {
   "i": 68,
   "start": 168.559,
   "end": 170.44,
   "en": "",
   "zh": "猴子挠了挠头"
  },
  {
   "i": 69,
   "start": 170.7,
   "end": 172.18,
   "en": "",
   "zh": "我没有父母"
  },
  {
   "i": 70,
   "start": 172.18,
   "end": 173.22,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 71,
   "start": 173.22,
   "end": 175.2,
   "en": "",
   "zh": "我出生在岩石上"
  },
  {
   "i": 72,
   "start": 176.02,
   "end": 176.68,
   "en": "",
   "zh": "有趣"
  },
  {
   "i": 73,
   "start": 176.68,
   "end": 178.02,
   "en": "",
   "zh": "西博伊说"
  },
  {
   "i": 74,
   "start": 178.02,
   "end": 180.9,
   "en": "",
   "zh": "你大概是天地万物创造的"
  },
  {
   "i": 75,
   "start": 181.44,
   "end": 183.08,
   "en": "",
   "zh": "你可能是我的学生"
  },
  {
   "i": 76,
   "start": 183.08,
   "end": 184.52,
   "en": "",
   "zh": "你需要一个名字"
  },
  {
   "i": 77,
   "start": 184.92,
   "end": 186.28,
   "en": "",
   "zh": "他想了一会儿"
  },
  {
   "i": 78,
   "start": 187.4,
   "end": 189.76,
   "en": "",
   "zh": "我就叫你孙悟空"
  },
  {
   "i": 79,
   "start": 194.08,
   "end": 195.88,
   "en": "",
   "zh": "在接下来的七年里"
  },
  {
   "i": 80,
   "start": 195.88,
   "end": 198.96,
   "en": "",
   "zh": "孙悟空住在西波帝庙"
  },
  {
   "i": 81,
   "start": 199.34,
   "end": 201.92,
   "en": "",
   "zh": "猴子每天都在冥想"
  },
  {
   "i": 82,
   "start": 201.92,
   "end": 205.6,
   "en": "",
   "zh": "听老师的课，做家务"
  },
  {
   "i": 83,
   "start": 206.959,
   "end": 207.799,
   "en": "",
   "zh": "有一天"
  },
  {
   "i": 84,
   "start": 207.799,
   "end": 209.759,
   "en": "",
   "zh": "当西博伊在上课的时候"
  },
  {
   "i": 85,
   "start": 209.759,
   "end": 212.44,
   "en": "",
   "zh": "悟空开始跳舞"
  },
  {
   "i": 86,
   "start": 214.459,
   "end": 215.899,
   "en": "",
   "zh": "于是博伊站了起来"
  },
  {
   "i": 87,
   "start": 215.899,
   "end": 218.199,
   "en": "",
   "zh": "你怎么敢在我教书的时候跳舞"
  },
  {
   "i": 88,
   "start": 218.199,
   "end": 219.62,
   "en": "",
   "zh": "他喊道"
  },
  {
   "i": 89,
   "start": 222.36,
   "end": 223.2,
   "en": "",
   "zh": "对不起"
  },
  {
   "i": 90,
   "start": 223.2,
   "end": 224.28,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 91,
   "start": 224.28,
   "end": 225.44,
   "en": "",
   "zh": "但我太高兴了"
  },
  {
   "i": 92,
   "start": 225.44,
   "end": 226.92,
   "en": "",
   "zh": "我需要跳舞"
  },
  {
   "i": 93,
   "start": 227.68,
   "end": 229.04,
   "en": "",
   "zh": "博伊冷静下来"
  },
  {
   "i": 94,
   "start": 230.04,
   "end": 231.06,
   "en": "",
   "zh": "你很快乐"
  },
  {
   "i": 95,
   "start": 231.779,
   "end": 232.399,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 96,
   "start": 232.399,
   "end": 233.599,
   "en": "",
   "zh": "猴子说"
  },
  {
   "i": 97,
   "start": 233.599,
   "end": 235.32,
   "en": "",
   "zh": "我喜欢向你学习"
  },
  {
   "i": 98,
   "start": 235.839,
   "end": 236.699,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 99,
   "start": 236.699,
   "end": 238.82,
   "en": "",
   "zh": "你在这里很久了"
  },
  {
   "i": 100,
   "start": 239.38,
   "end": 241.16,
   "en": "",
   "zh": "你想向我学习什么"
  },
  {
   "i": 101,
   "start": 241.16,
   "end": 242.18,
   "en": "",
   "zh": "西波迪问道"
  },
  {
   "i": 102,
   "start": 243.26,
   "end": 244.54,
   "en": "",
   "zh": "悟空耸了耸肩"
  },
  {
   "i": 103,
   "start": 245.28,
   "end": 247.16,
   "en": "",
   "zh": "我不知道你告诉我什么"
  },
  {
   "i": 104,
   "start": 247.16,
   "end": 249.32,
   "en": "",
   "zh": "我应该好好学习"
  },
  {
   "i": 105,
   "start": 249.32,
   "end": 250.64,
   "en": "",
   "zh": "西博特说"
  },
  {
   "i": 106,
   "start": 250.64,
   "end": 252.92,
   "en": "",
   "zh": "我可以教你如何预知未来"
  },
  {
   "i": 107,
   "start": 252.92,
   "end": 254.3,
   "en": "",
   "zh": "你喜欢那样吗"
  },
  {
   "i": 108,
   "start": 255.019,
   "end": 256.918,
   "en": "",
   "zh": "可能是说悟空"
  },
  {
   "i": 109,
   "start": 256.918,
   "end": 258.82,
   "en": "",
   "zh": "它会让我永生吗"
  },
  {
   "i": 110,
   "start": 259.12,
   "end": 260.279,
   "en": "",
   "zh": "当然不是"
  },
  {
   "i": 111,
   "start": 260.279,
   "end": 261.7,
   "en": "",
   "zh": "苏博迪说"
  },
  {
   "i": 112,
   "start": 261.7,
   "end": 263.02,
   "en": "",
   "zh": "那就忘了它吧"
  },
  {
   "i": 113,
   "start": 263.02,
   "end": 264.16,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 114,
   "start": 264.44,
   "end": 265.94,
   "en": "",
   "zh": "教我别的"
  },
  {
   "i": 115,
   "start": 267.64,
   "end": 272.3,
   "en": "",
   "zh": "西博迪说，来点神奇的呼吸练习怎么样"
  },
  {
   "i": 116,
   "start": 272.879,
   "end": 274.539,
   "en": "",
   "zh": "他们会让我永生吗"
  },
  {
   "i": 117,
   "start": 274.539,
   "end": 275.94,
   "en": "",
   "zh": "悟空问道"
  },
  {
   "i": 118,
   "start": 277.56,
   "end": 279.8,
   "en": "",
   "zh": "不，西博伊皱着眉头说"
  },
  {
   "i": 119,
   "start": 281.68,
   "end": 282.68,
   "en": "",
   "zh": "那我就没兴趣了"
  },
  {
   "i": 120,
   "start": 282.68,
   "end": 283.96,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 121,
   "start": 284.599,
   "end": 286.119,
   "en": "",
   "zh": "所以博伊生气了"
  },
  {
   "i": 122,
   "start": 287.639,
   "end": 291.18,
   "en": "",
   "zh": "他站起来在悟空头上敲了三下"
  },
  {
   "i": 123,
   "start": 294.02,
   "end": 295.92,
   "en": "",
   "zh": "然后他离开了房间"
  },
  {
   "i": 124,
   "start": 299.739,
   "end": 302.039,
   "en": "",
   "zh": "悟空说另一个学生"
  },
  {
   "i": 125,
   "start": 302.039,
   "end": 304.34,
   "en": "",
   "zh": "你对主人很粗鲁"
  },
  {
   "i": 126,
   "start": 304.9,
   "end": 307.16,
   "en": "",
   "zh": "其他同学都同意了"
  },
  {
   "i": 127,
   "start": 307.46,
   "end": 309.18,
   "en": "",
   "zh": "悟空却笑了"
  },
  {
   "i": 128,
   "start": 310.42,
   "end": 312.14,
   "en": "",
   "zh": "其他同学都不知道"
  },
  {
   "i": 129,
   "start": 312.14,
   "end": 315.92,
   "en": "",
   "zh": "但苏博伊给了他一个秘密信息"
  },
  {
   "i": 130,
   "start": 324.179,
   "end": 328.24,
   "en": "",
   "zh": "一只猴子飞溅着穿过瀑布，落在一个大洞穴里"
  },
  {
   "i": 131,
   "start": 330.599,
   "end": 332.42,
   "en": "",
   "zh": "他的眼睛睁得大大的"
  },
  {
   "i": 132,
   "start": 332.78,
   "end": 336.86,
   "en": "",
   "zh": "山洞里长满了竹树和美丽的花朵"
  }
 ]
}
