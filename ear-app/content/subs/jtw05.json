 "lines": [
  {
   "i": 1,
   "start": 0.14,
   "end": 2.42,
   "en": "",
   "zh": "向西第五章"
  },
  {
   "i": 2,
   "start": 2.42,
   "end": 4.1,
   "en": "",
   "zh": "混沌的恶魔"
  },
  {
   "i": 3,
   "start": 13.22,
   "end": 14.28,
   "en": "",
   "zh": "这里发生了什么"
  },
  {
   "i": 4,
   "start": 14.28,
   "end": 16.16,
   "en": "",
   "zh": "悟空问长臂猿"
  },
  {
   "i": 5,
   "start": 16.32,
   "end": 19.08,
   "en": "",
   "zh": "又有几只猴子和猿聚集在太阳周围"
  },
  {
   "i": 6,
   "start": 19.08,
   "end": 22.0,
   "en": "",
   "zh": "悟空和长臂猿看起来很害怕"
  },
  {
   "i": 7,
   "start": 23.16,
   "end": 24.34,
   "en": "",
   "zh": "一个恶魔袭击了我们"
  },
  {
   "i": 8,
   "start": 24.34,
   "end": 27.04,
   "en": "",
   "zh": "长臂猿说：“我们想和它搏斗。"
  },
  {
   "i": 9,
   "start": 27.04,
   "end": 28.78,
   "en": "",
   "zh": "但他太强大了"
  },
  {
   "i": 10,
   "start": 29.1,
   "end": 32.64,
   "en": "",
   "zh": "他偷了我们大部分的东西，绑架了我们很多人"
  },
  {
   "i": 11,
   "start": 32.84,
   "end": 34.44,
   "en": "",
   "zh": "悟空大发雷霆"
  },
  {
   "i": 12,
   "start": 35.52,
   "end": 36.12,
   "en": "",
   "zh": "他是谁"
  },
  {
   "i": 13,
   "start": 36.12,
   "end": 36.88,
   "en": "",
   "zh": "他住在哪里"
  },
  {
   "i": 14,
   "start": 37.96,
   "end": 39.76,
   "en": "",
   "zh": "他被称为混沌恶魔"
  },
  {
   "i": 15,
   "start": 39.76,
   "end": 42.919,
   "en": "",
   "zh": "长臂猿说，他是从北方来的"
  },
  {
   "i": 16,
   "start": 44.26,
   "end": 45.04,
   "en": "",
   "zh": "在这里等着"
  },
  {
   "i": 17,
   "start": 45.04,
   "end": 46.42,
   "en": "",
   "zh": "悟空下令"
  },
  {
   "i": 18,
   "start": 46.42,
   "end": 48.54,
   "en": "",
   "zh": "我来对付恶魔"
  },
  {
   "i": 19,
   "start": 49.06,
   "end": 50.62,
   "en": "",
   "zh": "恶魔的力量非常强大"
  },
  {
   "i": 20,
   "start": 50.62,
   "end": 52.08,
   "en": "",
   "zh": "长臂猿警告说"
  },
  {
   "i": 21,
   "start": 52.26,
   "end": 54.44,
   "en": "",
   "zh": "我从圣人那里学到了很多东西"
  },
  {
   "i": 22,
   "start": 54.44,
   "end": 55.58,
   "en": "",
   "zh": "悟空回答"
  },
  {
   "i": 23,
   "start": 56.66,
   "end": 58.919,
   "en": "",
   "zh": "我现在像神一样强大"
  },
  {
   "i": 24,
   "start": 59.46,
   "end": 61.78,
   "en": "",
   "zh": "我什么鬼都不怕"
  },
  {
   "i": 25,
   "start": 61.78,
   "end": 62.74,
   "en": "",
   "zh": "我会回来的"
  },
  {
   "i": 26,
   "start": 62.74,
   "end": 67.44,
   "en": "",
   "zh": "不久，他一跃而起，向北飞去"
  },
  {
   "i": 27,
   "start": 69.34,
   "end": 71.96,
   "en": "",
   "zh": "他的臣民惊讶地盯着看"
  },
  {
   "i": 28,
   "start": 71.96,
   "end": 73.98,
   "en": "",
   "zh": "我们的王会飞说"
  },
  {
   "i": 29,
   "start": 73.98,
   "end": 78.8,
   "en": "",
   "zh": "长臂猿悟空很快就发现了一座阴沉的山"
  },
  {
   "i": 30,
   "start": 80.04,
   "end": 82.22,
   "en": "",
   "zh": "乌云笼罩着它"
  },
  {
   "i": 31,
   "start": 82.92,
   "end": 84.6,
   "en": "",
   "zh": "那看起来像恶魔的家"
  },
  {
   "i": 32,
   "start": 84.6,
   "end": 85.759,
   "en": "",
   "zh": "他想"
  },
  {
   "i": 33,
   "start": 87.98,
   "end": 91.06,
   "en": "",
   "zh": "悟空上山发现了一个山洞"
  },
  {
   "i": 34,
   "start": 91.56,
   "end": 93.74,
   "en": "",
   "zh": "两个警卫站在入口处"
  },
  {
   "i": 35,
   "start": 93.74,
   "end": 95.84,
   "en": "",
   "zh": "练剑"
  },
  {
   "i": 36,
   "start": 96.72,
   "end": 99.68,
   "en": "",
   "zh": "我是花果山之王"
  },
  {
   "i": 37,
   "start": 99.68,
   "end": 100.539,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 38,
   "start": 100.86,
   "end": 103.1,
   "en": "",
   "zh": "混乱的恶魔袭击了我的臣民"
  },
  {
   "i": 39,
   "start": 104.14,
   "end": 105.32,
   "en": "",
   "zh": "我要报仇"
  },
  {
   "i": 40,
   "start": 109.6,
   "end": 112.58,
   "en": "",
   "zh": "守卫们尖叫着跑进了山洞"
  },
  {
   "i": 41,
   "start": 113.76,
   "end": 116.18,
   "en": "",
   "zh": "混乱的恶魔坐在一张桌子旁"
  },
  {
   "i": 42,
   "start": 116.18,
   "end": 116.96,
   "en": "",
   "zh": "吃饭"
  },
  {
   "i": 43,
   "start": 118.28,
   "end": 118.76,
   "en": "",
   "zh": "灾难"
  },
  {
   "i": 44,
   "start": 118.76,
   "end": 120.3,
   "en": "",
   "zh": "一个警卫哭了"
  },
  {
   "i": 45,
   "start": 120.86,
   "end": 122.84,
   "en": "",
   "zh": "什么样的灾难"
  },
  {
   "i": 46,
   "start": 122.84,
   "end": 124.6,
   "en": "",
   "zh": "魔鬼问"
  },
  {
   "i": 47,
   "start": 125.1,
   "end": 126.88,
   "en": "",
   "zh": "外面有只猴子"
  },
  {
   "i": 48,
   "start": 126.88,
   "end": 127.9,
   "en": "",
   "zh": "另一个卫兵说"
  },
  {
   "i": 49,
   "start": 129.02,
   "end": 131.82,
   "en": "",
   "zh": "他说他是花果山之王"
  },
  {
   "i": 50,
   "start": 131.88,
   "end": 133.36,
   "en": "",
   "zh": "你攻击他的臣民"
  },
  {
   "i": 51,
   "start": 134.68,
   "end": 136.72,
   "en": "",
   "zh": "现在他想报仇"
  },
  {
   "i": 52,
   "start": 137.639,
   "end": 140.459,
   "en": "",
   "zh": "猴子和猿被称为国王"
  },
  {
   "i": 53,
   "start": 140.459,
   "end": 141.979,
   "en": "",
   "zh": "魔鬼说"
  },
  {
   "i": 54,
   "start": 141.979,
   "end": 144.199,
   "en": "",
   "zh": "他去找圣人了"
  },
  {
   "i": 55,
   "start": 144.199,
   "end": 146.06,
   "en": "",
   "zh": "我猜他回来了"
  },
  {
   "i": 56,
   "start": 146.919,
   "end": 148.679,
   "en": "",
   "zh": "恶魔站了起来"
  },
  {
   "i": 57,
   "start": 148.679,
   "end": 151.679,
   "en": "",
   "zh": "猴子有武器吗"
  },
  {
   "i": 58,
   "start": 152.299,
   "end": 152.919,
   "en": "",
   "zh": "无"
  },
  {
   "i": 59,
   "start": 152.919,
   "end": 154.18,
   "en": "",
   "zh": "一个卫兵说"
  },
  {
   "i": 60,
   "start": 155.22,
   "end": 155.98,
   "en": "",
   "zh": "他们会抓住我的"
  },
  {
   "i": 61,
   "start": 155.98,
   "end": 157.62,
   "en": "",
   "zh": "我的盔甲和剑"
  },
  {
   "i": 62,
   "start": 157.62,
   "end": 159.16,
   "en": "",
   "zh": "魔鬼说"
  },
  {
   "i": 63,
   "start": 160.299,
   "end": 161.479,
   "en": "",
   "zh": "过了一会儿"
  },
  {
   "i": 64,
   "start": 161.479,
   "end": 164.1,
   "en": "",
   "zh": "混乱的恶魔走到外面"
  },
  {
   "i": 65,
   "start": 166.12,
   "end": 170.18,
   "en": "",
   "zh": "他看着悟空笑了"
  },
  {
   "i": 66,
   "start": 170.7,
   "end": 172.62,
   "en": "",
   "zh": "你只是一只小猴子"
  },
  {
   "i": 67,
   "start": 172.62,
   "end": 173.72,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 68,
   "start": 177.079,
   "end": 178.519,
   "en": "",
   "zh": "我很小"
  },
  {
   "i": 69,
   "start": 178.519,
   "end": 179.399,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 70,
   "start": 179.399,
   "end": 182.54,
   "en": "",
   "zh": "但我比你想象的更强大"
  },
  {
   "i": 71,
   "start": 184.28,
   "end": 186.02,
   "en": "",
   "zh": "我不怕你"
  },
  {
   "i": 72,
   "start": 186.02,
   "end": 187.4,
   "en": "",
   "zh": "魔鬼说"
  },
  {
   "i": 73,
   "start": 187.4,
   "end": 189.5,
   "en": "",
   "zh": "他挥动着剑"
  },
  {
   "i": 74,
   "start": 189.5,
   "end": 190.52,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 75,
   "start": 190.52,
   "end": 191.66,
   "en": "",
   "zh": "跳开了"
  },
  {
   "i": 76,
   "start": 191.66,
   "end": 193.44,
   "en": "",
   "zh": "然后向恶魔飞去"
  },
  {
   "i": 77,
   "start": 194.1,
   "end": 197.6,
   "en": "",
   "zh": "玉康是如何打在恶魔的鼻子上的"
  },
  {
   "i": 78,
   "start": 199.6,
   "end": 201.02,
   "en": "",
   "zh": "魔鬼叫道"
  },
  {
   "i": 79,
   "start": 201.02,
   "end": 205.28,
   "en": "",
   "zh": "悟空掏出一把自己的头发在上面吹气"
  },
  {
   "i": 80,
   "start": 207.54,
   "end": 211.32,
   "en": "",
   "zh": "每一根头发都变成了一只假猴子"
  },
  {
   "i": 81,
   "start": 211.32,
   "end": 213.28,
   "en": "",
   "zh": "跟悟空一模一样"
  },
  {
   "i": 82,
   "start": 214.1,
   "end": 215.06,
   "en": "",
   "zh": "一下子"
  },
  {
   "i": 83,
   "start": 215.06,
   "end": 217.16,
   "en": "",
   "zh": "假猴子袭击了恶魔"
  },
  {
   "i": 84,
   "start": 217.16,
   "end": 218.8,
   "en": "",
   "zh": "对他拳打脚踢"
  },
  {
   "i": 85,
   "start": 219.179,
   "end": 221.539,
   "en": "",
   "zh": "发生什么事了？"
  },
  {
   "i": 86,
   "start": 221.539,
   "end": 222.639,
   "en": "",
   "zh": "魔鬼叫道"
  },
  {
   "i": 87,
   "start": 222.639,
   "end": 225.42,
   "en": "",
   "zh": "试图和所有的假猴子战斗"
  },
  {
   "i": 88,
   "start": 226.26,
   "end": 227.72,
   "en": "",
   "zh": "这是个魔咒"
  },
  {
   "i": 89,
   "start": 227.72,
   "end": 228.54,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 90,
   "start": 229.62,
   "end": 231.7,
   "en": "",
   "zh": "它被称为身体之外的身体"
  },
  {
   "i": 91,
   "start": 237.86,
   "end": 239.74,
   "en": "",
   "zh": "悟空赶走了守卫"
  },
  {
   "i": 92,
   "start": 239.74,
   "end": 242.18,
   "en": "",
   "zh": "然后进了山洞"
  },
  {
   "i": 93,
   "start": 244.419,
   "end": 248.079,
   "en": "",
   "zh": "他找到了恶魔绑架的所有猴子和猿"
  },
  {
   "i": 94,
   "start": 248.079,
   "end": 249.599,
   "en": "",
   "zh": "当他们看到他的时候"
  },
  {
   "i": 95,
   "start": 249.599,
   "end": 250.7,
   "en": "",
   "zh": "他们欢呼起来"
  },
  {
   "i": 96,
   "start": 252.36,
   "end": 254.48,
   "en": "",
   "zh": "陛下哭了"
  },
  {
   "i": 97,
   "start": 254.48,
   "end": 255.98,
   "en": "",
   "zh": "猴子和猿"
  },
  {
   "i": 98,
   "start": 255.98,
   "end": 257.66,
   "en": "",
   "zh": "你回来了"
  },
  {
   "i": 99,
   "start": 258.579,
   "end": 260.279,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 100,
   "start": 260.279,
   "end": 262.079,
   "en": "",
   "zh": "我送你回家"
  },
  {
   "i": 101,
   "start": 265.739,
   "end": 266.799,
   "en": "",
   "zh": "第二天早上"
  },
  {
   "i": 102,
   "start": 266.799,
   "end": 269.0,
   "en": "",
   "zh": "悟空早早醒了"
  },
  {
   "i": 103,
   "start": 270.44,
   "end": 272.32,
   "en": "",
   "zh": "其他恶魔可能会攻击我们"
  },
  {
   "i": 104,
   "start": 272.32,
   "end": 276.4,
   "en": "",
   "zh": "他认为我们必须准备好保护自己"
  },
  {
   "i": 105,
   "start": 278.519,
   "end": 282.239,
   "en": "",
   "zh": "悟空花了一天时间教他的臣民如何战斗"
  },
  {
   "i": 106,
   "start": 283.319,
   "end": 286.14,
   "en": "",
   "zh": "他们用剑和矛练习"
  },
  {
   "i": 107,
   "start": 286.78,
   "end": 287.62,
   "en": "",
   "zh": "不久之后"
  },
  {
   "i": 108,
   "start": 287.62,
   "end": 290.62,
   "en": "",
   "zh": "猴子和猿是一支凶猛的军队"
  },
  {
   "i": 109,
   "start": 291.64,
   "end": 293.96,
   "en": "",
   "zh": "现在没有妖怪敢来骚扰我们了"
  },
  {
   "i": 110,
   "start": 293.96,
   "end": 296.32,
   "en": "",
   "zh": "长臂猿说不"
  },
  {
   "i": 111,
   "start": 296.32,
   "end": 297.62,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 112,
   "start": 297.62,
   "end": 299.38,
   "en": "",
   "zh": "只有一个问题"
  },
  {
   "i": 113,
   "start": 299.38,
   "end": 300.08,
   "en": "",
   "zh": "虽然"
  },
  {
   "i": 114,
   "start": 300.4,
   "end": 302.66,
   "en": "",
   "zh": "长臂猿问：“那是什么？”"
  },
  {
   "i": 115,
   "start": 304.56,
   "end": 306.32,
   "en": "",
   "zh": "我不能使用任何武器"
  },
  {
   "i": 116,
   "start": 306.32,
   "end": 308.0,
   "en": "",
   "zh": "我们说过悟空"
  }
 ]
}
