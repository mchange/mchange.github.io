{
 "id": "jtw06",
 "title": "The Dragon King",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.5,
   "end": 1.84,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 1.84,
   "end": 3.14,
   "en": "",
   "zh": "第六章"
  },
  {
   "i": 3,
   "start": 3.14,
   "end": 4.66,
   "en": "",
   "zh": "龙王"
  },
  {
   "i": 4,
   "start": 11.64,
   "end": 13.82,
   "en": "",
   "zh": "我们的剑和矛怎么了？"
  },
  {
   "i": 5,
   "start": 13.82,
   "end": 15.24,
   "en": "",
   "zh": "长臂猿问"
  },
  {
   "i": 6,
   "start": 15.5,
   "end": 16.84,
   "en": "",
   "zh": "他们是正常的"
  },
  {
   "i": 7,
   "start": 16.84,
   "end": 17.88,
   "en": "",
   "zh": "猴子和猿"
  },
  {
   "i": 8,
   "start": 17.88,
   "end": 19.0,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 9,
   "start": 19.54,
   "end": 21.24,
   "en": "",
   "zh": "但我很强大"
  },
  {
   "i": 10,
   "start": 21.24,
   "end": 23.4,
   "en": "",
   "zh": "我需要更重的武器"
  },
  {
   "i": 11,
   "start": 23.74,
   "end": 26.08,
   "en": "",
   "zh": "长臂猿想了一会儿"
  },
  {
   "i": 12,
   "start": 26.62,
   "end": 29.3,
   "en": "",
   "zh": "东海海底住着一个龙王"
  },
  {
   "i": 13,
   "start": 29.3,
   "end": 30.44,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 14,
   "start": 30.82,
   "end": 32.1,
   "en": "",
   "zh": "可能他有武器"
  },
  {
   "i": 15,
   "start": 32.1,
   "end": 32.58,
   "en": "",
   "zh": "你可以用"
  },
  {
   "i": 16,
   "start": 33.9,
   "end": 34.8,
   "en": "",
   "zh": "那是个好主意"
  },
  {
   "i": 17,
   "start": 34.8,
   "end": 35.94,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 18,
   "start": 35.94,
   "end": 37.44,
   "en": "",
   "zh": "我很快就回来"
  },
  {
   "i": 19,
   "start": 42.16,
   "end": 45.5,
   "en": "",
   "zh": "他设置了一个快速咒语，这样他就可以在水下呼吸"
  },
  {
   "i": 20,
   "start": 47.36,
   "end": 49.419,
   "en": "",
   "zh": "然后他跳进了小溪"
  },
  {
   "i": 21,
   "start": 54.24,
   "end": 55.54,
   "en": "",
   "zh": "他游向大海"
  },
  {
   "i": 22,
   "start": 55.54,
   "end": 57.64,
   "en": "",
   "zh": "越陷越深"
  },
  {
   "i": 23,
   "start": 61.08,
   "end": 63.68,
   "en": "",
   "zh": "不久他来到了一座大宫殿"
  },
  {
   "i": 24,
   "start": 64.62,
   "end": 69.1,
   "en": "",
   "zh": "龙王和龙后坐在桌子旁喝茶"
  },
  {
   "i": 25,
   "start": 69.54,
   "end": 71.18,
   "en": "",
   "zh": "龙王看了看"
  },
  {
   "i": 26,
   "start": 71.18,
   "end": 72.88,
   "en": "",
   "zh": "当悟空走进来"
  },
  {
   "i": 27,
   "start": 73.54,
   "end": 76.179,
   "en": "",
   "zh": "龙王问你是谁"
  },
  {
   "i": 28,
   "start": 76.74,
   "end": 78.9,
   "en": "",
   "zh": "我是花果山之王"
  },
  {
   "i": 29,
   "start": 78.9,
   "end": 79.86,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 30,
   "start": 80.86,
   "end": 81.58,
   "en": "",
   "zh": "我叫孙"
  },
  {
   "i": 31,
   "start": 81.58,
   "end": 82.34,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 32,
   "start": 82.78,
   "end": 84.42,
   "en": "",
   "zh": "很高兴认识你"
  },
  {
   "i": 33,
   "start": 84.42,
   "end": 85.18,
   "en": "",
   "zh": "王后说"
  },
  {
   "i": 34,
   "start": 86.26,
   "end": 87.84,
   "en": "",
   "zh": "你想喝点茶吗？"
  },
  {
   "i": 35,
   "start": 88.66,
   "end": 89.56,
   "en": "",
   "zh": "不用了，谢谢"
  },
  {
   "i": 36,
   "start": 89.56,
   "end": 90.72,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 37,
   "start": 90.72,
   "end": 92.36,
   "en": "",
   "zh": "我需要重型武器"
  },
  {
   "i": 38,
   "start": 92.36,
   "end": 94.82,
   "en": "",
   "zh": "因为我像神一样强壮"
  },
  {
   "i": 39,
   "start": 96.06,
   "end": 97.84,
   "en": "",
   "zh": "我想要一个你的"
  },
  {
   "i": 40,
   "start": 98.52,
   "end": 99.28,
   "en": "",
   "zh": "嗯"
  },
  {
   "i": 41,
   "start": 99.28,
   "end": 101.12,
   "en": "",
   "zh": "龙王说"
  },
  {
   "i": 42,
   "start": 101.12,
   "end": 104.28,
   "en": "",
   "zh": "我想我能帮你找到武器"
  },
  {
   "i": 43,
   "start": 104.7,
   "end": 108.14,
   "en": "",
   "zh": "龙王看着乌龟兵"
  },
  {
   "i": 44,
   "start": 108.64,
   "end": 110.44,
   "en": "",
   "zh": "给太阳找一个重武器"
  },
  {
   "i": 45,
   "start": 110.44,
   "end": 110.96,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 46,
   "start": 112.48,
   "end": 114.28,
   "en": "",
   "zh": "乌龟走出了房间"
  },
  {
   "i": 47,
   "start": 115.56,
   "end": 117.92,
   "en": "",
   "zh": "他很快就慢慢地回来了"
  },
  {
   "i": 48,
   "start": 117.92,
   "end": 120.259,
   "en": "",
   "zh": "拖着一把巨大的剑"
  },
  {
   "i": 49,
   "start": 121.82,
   "end": 122.92,
   "en": "",
   "zh": "他扔下了剑"
  },
  {
   "i": 50,
   "start": 122.92,
   "end": 125.7,
   "en": "",
   "zh": "然后上气不接下气地倒下了"
  },
  {
   "i": 51,
   "start": 129.499,
   "end": 131.119,
   "en": "",
   "zh": "悟空拿起了剑"
  },
  {
   "i": 52,
   "start": 131.119,
   "end": 135.56,
   "en": "",
   "zh": "没有任何麻烦嗖嗖嗖"
  },
  {
   "i": 53,
   "start": 135.56,
   "end": 137.7,
   "en": "",
   "zh": "他在空中挥舞着剑"
  },
  {
   "i": 54,
   "start": 137.7,
   "end": 141.72,
   "en": "",
   "zh": "假装打这把剑太轻了"
  },
  {
   "i": 55,
   "start": 141.72,
   "end": 145.4,
   "en": "",
   "zh": "悟空说给我找个更好的武器"
  },
  {
   "i": 56,
   "start": 146.519,
   "end": 148.559,
   "en": "",
   "zh": "这只猴子很粗鲁"
  },
  {
   "i": 57,
   "start": 148.559,
   "end": 150.879,
   "en": "",
   "zh": "龙皇后对她的丈夫低声说"
  },
  {
   "i": 58,
   "start": 151.959,
   "end": 152.419,
   "en": "",
   "zh": "你说的对"
  },
  {
   "i": 59,
   "start": 152.419,
   "end": 152.879,
   "en": "",
   "zh": "亲爱的"
  },
  {
   "i": 60,
   "start": 152.879,
   "end": 154.98,
   "en": "",
   "zh": "龙王小声回应"
  },
  {
   "i": 61,
   "start": 155.14,
   "end": 156.8,
   "en": "",
   "zh": "让我们快点给他找点东西"
  },
  {
   "i": 62,
   "start": 156.8,
   "end": 158.02,
   "en": "",
   "zh": "所以他会离开"
  },
  {
   "i": 63,
   "start": 159.619,
   "end": 160.979,
   "en": "",
   "zh": "几分钟后"
  },
  {
   "i": 64,
   "start": 160.979,
   "end": 165.64,
   "en": "",
   "zh": "几只乌龟和章鱼拖着一支巨大的长矛进了房间"
  },
  {
   "i": 65,
   "start": 168.22,
   "end": 173.18,
   "en": "",
   "zh": "龙王说，看起来像一件很重的武器"
  },
  {
   "i": 66,
   "start": 173.18,
   "end": 174.5,
   "en": "",
   "zh": "对了悟空"
  },
  {
   "i": 67,
   "start": 176.78,
   "end": 180.52,
   "en": "",
   "zh": "悟空举起长矛开始朝天刺"
  },
  {
   "i": 68,
   "start": 182.699,
   "end": 183.739,
   "en": "",
   "zh": "他摇摇头"
  },
  {
   "i": 69,
   "start": 184.819,
   "end": 186.64,
   "en": "",
   "zh": "他的矛太轻了"
  },
  {
   "i": 70,
   "start": 187.24,
   "end": 189.4,
   "en": "",
   "zh": "龙王哼了一声"
  },
  {
   "i": 71,
   "start": 189.4,
   "end": 191.88,
   "en": "",
   "zh": "那矛很重"
  },
  {
   "i": 72,
   "start": 191.88,
   "end": 195.92,
   "en": "",
   "zh": "你怎么能说它对我来说太轻了"
  },
  {
   "i": 73,
   "start": 195.92,
   "end": 197.0,
   "en": "",
   "zh": "很轻"
  },
  {
   "i": 74,
   "start": 197.0,
   "end": 197.96,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 75,
   "start": 199.68,
   "end": 201.14,
   "en": "",
   "zh": "给我找点别的"
  },
  {
   "i": 76,
   "start": 203.5,
   "end": 205.34,
   "en": "",
   "zh": "我们没有别的了"
  },
  {
   "i": 77,
   "start": 205.34,
   "end": 207.08,
   "en": "",
   "zh": "龙王说"
  },
  {
   "i": 78,
   "start": 207.08,
   "end": 211.48,
   "en": "",
   "zh": "那是我们悟空最重的武器"
  },
  {
   "i": 79,
   "start": 211.48,
   "end": 212.78,
   "en": "",
   "zh": "跺着他的脚"
  },
  {
   "i": 80,
   "start": 212.78,
   "end": 216.46,
   "en": "",
   "zh": "不达目的决不罢休"
  },
  {
   "i": 81,
   "start": 218.34,
   "end": 219.94,
   "en": "",
   "zh": "这是一种暴行"
  },
  {
   "i": 82,
   "start": 219.94,
   "end": 221.1,
   "en": "",
   "zh": "龙王说"
  },
  {
   "i": 83,
   "start": 222.14,
   "end": 224.44,
   "en": "",
   "zh": "王后又低声对他说"
  },
  {
   "i": 84,
   "start": 224.88,
   "end": 227.88,
   "en": "",
   "zh": "金库里的神奇铁棍呢"
  },
  {
   "i": 85,
   "start": 229.08,
   "end": 231.1,
   "en": "",
   "zh": "我想那足够重了"
  },
  {
   "i": 86,
   "start": 231.959,
   "end": 233.719,
   "en": "",
   "zh": "我们不能给他"
  },
  {
   "i": 87,
   "start": 233.719,
   "end": 234.879,
   "en": "",
   "zh": "龙王说"
  },
  {
   "i": 88,
   "start": 235.999,
   "end": 237.88,
   "en": "",
   "zh": "这是天上掉下来的宝贝"
  },
  {
   "i": 89,
   "start": 238.54,
   "end": 239.9,
   "en": "",
   "zh": "谁在乎"
  },
  {
   "i": 90,
   "start": 239.9,
   "end": 241.3,
   "en": "",
   "zh": "王后说"
  },
  {
   "i": 91,
   "start": 241.66,
   "end": 245.16,
   "en": "",
   "zh": "我只想让这只猴子滚出我的宫殿。"
  },
  {
   "i": 92,
   "start": 246.699,
   "end": 250.56,
   "en": "",
   "zh": "龙王身边的悟空"
  },
  {
   "i": 93,
   "start": 250.56,
   "end": 254.8,
   "en": "",
   "zh": "我们可能有足够重的东西给你拿过来"
  },
  {
   "i": 94,
   "start": 254.8,
   "end": 256.019,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 95,
   "start": 256.54,
   "end": 259.0,
   "en": "",
   "zh": "不能说是龙王"
  },
  {
   "i": 96,
   "start": 259.0,
   "end": 261.76,
   "en": "",
   "zh": "它太重了，谁也抬不起来"
  },
  {
   "i": 97,
   "start": 262.12,
   "end": 263.74,
   "en": "",
   "zh": "但如果你能举起它"
  },
  {
   "i": 98,
   "start": 263.74,
   "end": 265.0,
   "en": "",
   "zh": "我们会让你拥有它"
  },
  {
   "i": 99,
   "start": 266.2,
   "end": 272.22,
   "en": "",
   "zh": "告诉我说悟空他们去了金库"
  },
  {
   "i": 100,
   "start": 274.48,
   "end": 278.3,
   "en": "",
   "zh": "房间中央立着一根巨大的铁柱"
  },
  {
   "i": 101,
   "start": 278.8,
   "end": 281.36,
   "en": "",
   "zh": "金光从里面照耀着"
  },
  {
   "i": 102,
   "start": 282.4,
   "end": 285.76,
   "en": "",
   "zh": "那根柱子被用来测量所有的海洋和河流"
  },
  {
   "i": 103,
   "start": 285.76,
   "end": 287.4,
   "en": "",
   "zh": "龙王说"
  },
  {
   "i": 104,
   "start": 289.0,
   "end": 293.3,
   "en": "",
   "zh": "悟空走得更近了，抬头看着那块大铁"
  },
  {
   "i": 105,
   "start": 293.86,
   "end": 296.1,
   "en": "",
   "zh": "龙王双手合十"
  },
  {
   "i": 106,
   "start": 297.42,
   "end": 298.82,
   "en": "",
   "zh": "如果你能把它捡起来"
  },
  {
   "i": 107,
   "start": 298.82,
   "end": 300.32,
   "en": "",
   "zh": "你可以拥有它"
  }
 ]
}
