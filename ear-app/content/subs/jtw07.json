{
 "id": "jtw07",
 "title": "The Land of Darkness",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.0,
   "end": 1.36,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 1.36,
   "end": 2.7,
   "en": "",
   "zh": "第七章"
  },
  {
   "i": 3,
   "start": 2.7,
   "end": 4.88,
   "en": "",
   "zh": "黑暗之地"
  },
  {
   "i": 4,
   "start": 13.4,
   "end": 16.84,
   "en": "",
   "zh": "孙悟空把手放在铁柱上"
  },
  {
   "i": 5,
   "start": 18.46,
   "end": 20.52,
   "en": "",
   "zh": "他感觉到它在动"
  },
  {
   "i": 6,
   "start": 21.499,
   "end": 25.379,
   "en": "",
   "zh": "他觉得这块铁真的很神奇"
  },
  {
   "i": 7,
   "start": 25.379,
   "end": 28.02,
   "en": "",
   "zh": "我打赌它会做我想让它做的任何事情"
  },
  {
   "i": 8,
   "start": 31.559,
   "end": 32.598,
   "en": "",
   "zh": "柱子收缩了"
  },
  {
   "i": 9,
   "start": 33.719,
   "end": 33.959,
   "en": "",
   "zh": "很快"
  },
  {
   "i": 10,
   "start": 33.959,
   "end": 36.459,
   "en": "",
   "zh": "只是比悟空高一点"
  },
  {
   "i": 11,
   "start": 39.36,
   "end": 42.68,
   "en": "",
   "zh": "他把它捡起来，转了一圈"
  },
  {
   "i": 12,
   "start": 44.0,
   "end": 46.12,
   "en": "",
   "zh": "这对我来说是个完美的武器"
  },
  {
   "i": 13,
   "start": 46.12,
   "end": 47.14,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 14,
   "start": 48.26,
   "end": 50.58,
   "en": "",
   "zh": "我真不敢相信他能举起它"
  },
  {
   "i": 15,
   "start": 50.58,
   "end": 55.04,
   "en": "",
   "zh": "说是龙后悟空把酒吧弄得更小了"
  },
  {
   "i": 16,
   "start": 56.36,
   "end": 58.839,
   "en": "",
   "zh": "很快它就没有大头针大了"
  },
  {
   "i": 17,
   "start": 59.06,
   "end": 62.22,
   "en": "",
   "zh": "他把它放在耳朵里"
  },
  {
   "i": 18,
   "start": 64.7,
   "end": 65.94,
   "en": "",
   "zh": "我已经得到了我想要的"
  },
  {
   "i": 19,
   "start": 65.94,
   "end": 67.82,
   "en": "",
   "zh": "说了悟空再见"
  },
  {
   "i": 20,
   "start": 69.02,
   "end": 70.98,
   "en": "",
   "zh": "他转身离开了"
  },
  {
   "i": 21,
   "start": 73.96,
   "end": 75.74,
   "en": "",
   "zh": "他很粗鲁"
  },
  {
   "i": 22,
   "start": 75.74,
   "end": 77.46,
   "en": "",
   "zh": "龙后说"
  },
  {
   "i": 23,
   "start": 77.96,
   "end": 80.4,
   "en": "",
   "zh": "龙王握紧拳头"
  },
  {
   "i": 24,
   "start": 81.4,
   "end": 84.32,
   "en": "",
   "zh": "我要向玉帝告发他"
  },
  {
   "i": 25,
   "start": 88.6,
   "end": 89.4,
   "en": "",
   "zh": "回到家乡"
  },
  {
   "i": 26,
   "start": 89.4,
   "end": 92.88,
   "en": "",
   "zh": "其他人被悟空的新武器惊呆了"
  },
  {
   "i": 27,
   "start": 94.44,
   "end": 98.16,
   "en": "",
   "zh": "再也没有人攻击我们了悟空说"
  },
  {
   "i": 28,
   "start": 99.0,
   "end": 100.6,
   "en": "",
   "zh": "猴子和猿欢呼雀跃"
  },
  {
   "i": 29,
   "start": 101.88,
   "end": 105.38,
   "en": "",
   "zh": "他们举行了一场盛宴，一直持续到深夜"
  },
  {
   "i": 30,
   "start": 109.6,
   "end": 111.18,
   "en": "",
   "zh": "悟空睡觉了"
  },
  {
   "i": 31,
   "start": 111.18,
   "end": 112.02,
   "en": "",
   "zh": "快乐"
  },
  {
   "i": 32,
   "start": 114.78,
   "end": 116.38,
   "en": "",
   "zh": "但当他睡着的时候"
  },
  {
   "i": 33,
   "start": 116.38,
   "end": 118.82,
   "en": "",
   "zh": "两个鬼魂抓住了他"
  },
  {
   "i": 34,
   "start": 119.86,
   "end": 121.06,
   "en": "",
   "zh": "你在干什么"
  },
  {
   "i": 35,
   "start": 121.06,
   "end": 122.48,
   "en": "",
   "zh": "悟空问道"
  },
  {
   "i": 36,
   "start": 122.48,
   "end": 124.24,
   "en": "",
   "zh": "放开我"
  },
  {
   "i": 37,
   "start": 130.52,
   "end": 132.08,
   "en": "",
   "zh": "他又踢又挣扎"
  },
  {
   "i": 38,
   "start": 132.08,
   "end": 134.96,
   "en": "",
   "zh": "当鬼魂把他拖出洞穴时"
  },
  {
   "i": 39,
   "start": 136.16,
   "end": 138.44,
   "en": "",
   "zh": "他们走向一个黑暗和令人毛骨悚然的城市"
  },
  {
   "i": 40,
   "start": 139.48,
   "end": 143.58,
   "en": "",
   "zh": "入口大门上的标志写着黑暗之地"
  },
  {
   "i": 41,
   "start": 144.959,
   "end": 147.92,
   "en": "",
   "zh": "“黑暗之地”悟空叫道"
  },
  {
   "i": 42,
   "start": 148.38,
   "end": 150.06,
   "en": "",
   "zh": "那是人们死后去的地方"
  },
  {
   "i": 43,
   "start": 151.26,
   "end": 153.16,
   "en": "",
   "zh": "我应该长生不老"
  },
  {
   "i": 44,
   "start": 155.86,
   "end": 160.2,
   "en": "",
   "zh": "他猛拉他的手臂自由刚刚成长，他哭了"
  },
  {
   "i": 45,
   "start": 161.2,
   "end": 167.78,
   "en": "",
   "zh": "他的铁棍很快就长出来了，他把第一个精神打掉了"
  },
  {
   "i": 46,
   "start": 169.399,
   "end": 170.139,
   "en": "",
   "zh": "裂纹"
  },
  {
   "i": 47,
   "start": 170.139,
   "end": 172.24,
   "en": "",
   "zh": "他击倒了第二个灵魂"
  },
  {
   "i": 48,
   "start": 174.2,
   "end": 177.48,
   "en": "",
   "zh": "悟空踏入黑暗之地"
  },
  {
   "i": 49,
   "start": 179.46,
   "end": 182.28,
   "en": "",
   "zh": "他朝黑暗的宫殿走去"
  },
  {
   "i": 50,
   "start": 184.419,
   "end": 185.359,
   "en": "",
   "zh": "当他走的时候"
  },
  {
   "i": 51,
   "start": 185.359,
   "end": 188.76,
   "en": "",
   "zh": "他来回摆动着他的铁棍"
  },
  {
   "i": 52,
   "start": 189.12,
   "end": 191.34,
   "en": "",
   "zh": "妖魔鬼怪带领"
  },
  {
   "i": 53,
   "start": 192.88,
   "end": 196.6,
   "en": "",
   "zh": "一个高大的精灵从宫殿里走了出来"
  },
  {
   "i": 54,
   "start": 197.26,
   "end": 199.0,
   "en": "",
   "zh": "外面发生了什么事？"
  },
  {
   "i": 55,
   "start": 199.0,
   "end": 199.94,
   "en": "",
   "zh": "幽灵问道"
  },
  {
   "i": 56,
   "start": 200.94,
   "end": 202.08,
   "en": "",
   "zh": "你在问谁"
  },
  {
   "i": 57,
   "start": 202.08,
   "end": 203.04,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 58,
   "start": 203.64,
   "end": 205.96,
   "en": "",
   "zh": "我是死者的审判者"
  },
  {
   "i": 59,
   "start": 205.96,
   "end": 206.8,
   "en": "",
   "zh": "幽灵说"
  },
  {
   "i": 60,
   "start": 207.88,
   "end": 210.38,
   "en": "",
   "zh": "你为什么要惹这么多麻烦"
  },
  {
   "i": 61,
   "start": 210.96,
   "end": 212.04,
   "en": "",
   "zh": "我想知道为什么"
  },
  {
   "i": 62,
   "start": 212.04,
   "end": 213.04,
   "en": "",
   "zh": "我被带到这里"
  },
  {
   "i": 63,
   "start": 213.04,
   "end": 213.8,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 64,
   "start": 214.96,
   "end": 215.38,
   "en": "",
   "zh": "告诉我"
  },
  {
   "i": 65,
   "start": 215.38,
   "end": 216.02,
   "en": "",
   "zh": "现在"
  },
  {
   "i": 66,
   "start": 219.339,
   "end": 220.799,
   "en": "",
   "zh": "如果你被带到这里"
  },
  {
   "i": 67,
   "start": 220.799,
   "end": 224.02,
   "en": "",
   "zh": "意味着你在地球上的时间结束了"
  },
  {
   "i": 68,
   "start": 224.439,
   "end": 225.419,
   "en": "",
   "zh": "胡说八道"
  },
  {
   "i": 69,
   "start": 225.419,
   "end": 225.999,
   "en": "",
   "zh": "大喊"
  },
  {
   "i": 70,
   "start": 225.999,
   "end": 226.779,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 71,
   "start": 226.779,
   "end": 228.94,
   "en": "",
   "zh": "我要长生不老"
  },
  {
   "i": 72,
   "start": 231.84,
   "end": 233.46,
   "en": "",
   "zh": "让我们检查目录"
  },
  {
   "i": 73,
   "start": 233.46,
   "end": 234.38,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 74,
   "start": 234.38,
   "end": 238.98,
   "en": "",
   "zh": "这个目录包含了地球上所有生物的名字和年龄"
  },
  {
   "i": 75,
   "start": 239.9,
   "end": 242.88,
   "en": "",
   "zh": "上面写着每个生物的死亡时间"
  },
  {
   "i": 76,
   "start": 244.82,
   "end": 245.96,
   "en": "",
   "zh": "在宫殿里"
  },
  {
   "i": 77,
   "start": 249.14,
   "end": 250.76,
   "en": "",
   "zh": "你叫什么名字？"
  },
  {
   "i": 78,
   "start": 259.32,
   "end": 265.02,
   "en": "",
   "zh": "上面说三百年前孙悟空是从石头上出生的"
  },
  {
   "i": 79,
   "start": 265.02,
   "end": 267.16,
   "en": "",
   "zh": "今天去世了"
  },
  {
   "i": 80,
   "start": 268.6,
   "end": 270.52,
   "en": "",
   "zh": "悟空摇了摇头"
  },
  {
   "i": 81,
   "start": 270.52,
   "end": 271.44,
   "en": "",
   "zh": "否"
  },
  {
   "i": 82,
   "start": 271.44,
   "end": 273.46,
   "en": "",
   "zh": "我要长生不老"
  },
  {
   "i": 83,
   "start": 273.739,
   "end": 275.859,
   "en": "",
   "zh": "目录没有错"
  },
  {
   "i": 84,
   "start": 276.999,
   "end": 279.5,
   "en": "",
   "zh": "你现在必须呆在这里"
  },
  {
   "i": 85,
   "start": 287.039,
   "end": 289.18,
   "en": "",
   "zh": "把那本书给我"
  },
  {
   "i": 86,
   "start": 291.0,
   "end": 296.84,
   "en": "",
   "zh": "我不能给它现在说悟空颤抖"
  },
  {
   "i": 87,
   "start": 301.78,
   "end": 305.2,
   "en": "",
   "zh": "悟空拔掉他的两根头发吹气"
  },
  {
   "i": 88,
   "start": 305.2,
   "end": 308.76,
   "en": "",
   "zh": "它们变成了一把刷子和一罐墨水"
  },
  {
   "i": 89,
   "start": 309.7,
   "end": 312.22,
   "en": "",
   "zh": "他在自己的名字上画了一条线"
  },
  {
   "i": 90,
   "start": 313.24,
   "end": 314.78,
   "en": "",
   "zh": "你不能那样做"
  },
  {
   "i": 91,
   "start": 316.92,
   "end": 317.18,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 92,
   "start": 317.18,
   "end": 320.68,
   "en": "",
   "zh": "下一个我可以说悟空"
  },
  {
   "i": 93,
   "start": 320.68,
   "end": 324.16,
   "en": "",
   "zh": "悟空找到了所有其他猴子和猿的名字"
  },
  {
   "i": 94,
   "start": 327.46,
   "end": 330.06,
   "en": "",
   "zh": "他把他们的名字也划掉了"
  },
  {
   "i": 95,
   "start": 333.34,
   "end": 335.72,
   "en": "",
   "zh": "现在我真的会永生"
  },
  {
   "i": 96,
   "start": 335.72,
   "end": 337.06,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 97,
   "start": 337.06,
   "end": 339.22,
   "en": "",
   "zh": "我所有的臣民也会"
  }
 ]
}
