 "lines": [
  {
   "i": 1,
   "start": 0.56,
   "end": 3.14,
   "en": "",
   "zh": "西游记第八章"
  },
  {
   "i": 2,
   "start": 3.14,
   "end": 5.06,
   "en": "",
   "zh": "天堂的工作"
  },
  {
   "i": 3,
   "start": 21.179,
   "end": 25.14,
   "en": "",
   "zh": "玉皇大帝坐在云宫的宝座上"
  },
  {
   "i": 4,
   "start": 25.58,
   "end": 27.66,
   "en": "",
   "zh": "一个信使跑进了法庭"
  },
  {
   "i": 5,
   "start": 29.3,
   "end": 30.06,
   "en": "",
   "zh": "皇上"
  },
  {
   "i": 6,
   "start": 30.06,
   "end": 31.02,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 7,
   "start": 31.42,
   "end": 34.1,
   "en": "",
   "zh": "东海龙王来了"
  },
  {
   "i": 8,
   "start": 34.1,
   "end": 36.6,
   "en": "",
   "zh": "你让他进来"
  },
  {
   "i": 9,
   "start": 36.6,
   "end": 37.82,
   "en": "",
   "zh": "皇帝说"
  },
  {
   "i": 10,
   "start": 39.12,
   "end": 43.18,
   "en": "",
   "zh": "龙王进来向陛下鞠躬"
  },
  {
   "i": 11,
   "start": 43.18,
   "end": 45.12,
   "en": "",
   "zh": "我要投诉"
  },
  {
   "i": 12,
   "start": 45.7,
   "end": 49.88,
   "en": "",
   "zh": "孙悟空来到我的宫殿，要我给他一件武器"
  },
  {
   "i": 13,
   "start": 49.88,
   "end": 51.919,
   "en": "",
   "zh": "他很粗鲁"
  },
  {
   "i": 14,
   "start": 52.68,
   "end": 54.62,
   "en": "",
   "zh": "另一个信使进来了"
  },
  {
   "i": 15,
   "start": 58.48,
   "end": 59.58,
   "en": "",
   "zh": "皇上"
  },
  {
   "i": 16,
   "start": 68.1,
   "end": 71.0,
   "en": "",
   "zh": "2.把他的名字从名册上划掉"
  },
  {
   "i": 17,
   "start": 71.56,
   "end": 73.28,
   "en": "",
   "zh": "我求你惩罚他"
  },
  {
   "i": 18,
   "start": 74.36,
   "end": 76.78,
   "en": "",
   "zh": "玉帝揉了揉下巴"
  },
  {
   "i": 19,
   "start": 77.38,
   "end": 79.32,
   "en": "",
   "zh": "这个孙悟空是谁"
  },
  {
   "i": 20,
   "start": 79.32,
   "end": 82.039,
   "en": "",
   "zh": "他是怎么变得如此强大的"
  },
  {
   "i": 21,
   "start": 82.46,
   "end": 85.259,
   "en": "",
   "zh": "皇帝的统帅走上前"
  },
  {
   "i": 22,
   "start": 85.64,
   "end": 90.36,
   "en": "",
   "zh": "孙悟空就是三百年前出生在伊拉克的猴子"
  },
  {
   "i": 23,
   "start": 90.84,
   "end": 93.08,
   "en": "",
   "zh": "我不知道他怎么变得这么强大"
  },
  {
   "i": 24,
   "start": 94.44,
   "end": 95.54,
   "en": "",
   "zh": "我记得他"
  },
  {
   "i": 25,
   "start": 95.54,
   "end": 97.2,
   "en": "",
   "zh": "玉皇大帝说"
  },
  {
   "i": 26,
   "start": 97.72,
   "end": 98.64,
   "en": "",
   "zh": "我不在乎"
  },
  {
   "i": 27,
   "start": 98.64,
   "end": 99.76,
   "en": "",
   "zh": "他有多强大"
  },
  {
   "i": 28,
   "start": 100.8,
   "end": 103.28,
   "en": "",
   "zh": "他在地球上制造了太多的麻烦"
  },
  {
   "i": 29,
   "start": 104.38,
   "end": 108.179,
   "en": "",
   "zh": "召集军队下到花果山"
  },
  {
   "i": 30,
   "start": 108.72,
   "end": 109.52,
   "en": "",
   "zh": "我想"
  },
  {
   "i": 31,
   "start": 109.52,
   "end": 115.679,
   "en": "",
   "zh": "孙悟空抓住了金星的灵魂挺身而出"
  },
  {
   "i": 32,
   "start": 116.76,
   "end": 117.88,
   "en": "",
   "zh": "皇上"
  },
  {
   "i": 33,
   "start": 117.88,
   "end": 118.72,
   "en": "",
   "zh": "维纳斯说"
  },
  {
   "i": 34,
   "start": 119.84,
   "end": 123.1,
   "en": "",
   "zh": "也许我们可以在天堂给悟空一份工作"
  },
  {
   "i": 35,
   "start": 123.74,
   "end": 126.6,
   "en": "",
   "zh": "玉帝扬起了眉毛"
  },
  {
   "i": 36,
   "start": 126.6,
   "end": 128.52,
   "en": "",
   "zh": "我们为什么要这么做"
  },
  {
   "i": 37,
   "start": 128.9,
   "end": 129.96,
   "en": "",
   "zh": "如果他在这里"
  },
  {
   "i": 38,
   "start": 129.96,
   "end": 131.72,
   "en": "",
   "zh": "我们可以盯着他"
  },
  {
   "i": 39,
   "start": 131.72,
   "end": 132.96,
   "en": "",
   "zh": "维纳斯说"
  },
  {
   "i": 40,
   "start": 132.96,
   "end": 138.1,
   "en": "",
   "zh": "很容易让他远离麻烦"
  },
  {
   "i": 41,
   "start": 138.1,
   "end": 142.54,
   "en": "",
   "zh": "说是皇帝请悟空到天上来住"
  },
  {
   "i": 42,
   "start": 143.239,
   "end": 146.68,
   "en": "",
   "zh": "他将负责皇家桃园"
  },
  {
   "i": 43,
   "start": 150.46,
   "end": 155.28,
   "en": "",
   "zh": "悟空正在向他的臣民讲述他在黑暗之地的冒险经历"
  },
  {
   "i": 44,
   "start": 155.839,
   "end": 157.499,
   "en": "",
   "zh": "在我划掉我的名字后"
  },
  {
   "i": 45,
   "start": 157.499,
   "end": 158.559,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 46,
   "start": 158.559,
   "end": 160.339,
   "en": "",
   "zh": "我把你们的名字都划掉了"
  },
  {
   "i": 47,
   "start": 160.339,
   "end": 160.919,
   "en": "",
   "zh": "我也是"
  },
  {
   "i": 48,
   "start": 160.919,
   "end": 163.32,
   "en": "",
   "zh": "我们都将永生"
  },
  {
   "i": 49,
   "start": 169.28,
   "end": 172.68,
   "en": "",
   "zh": "悟空注意到附近站着一个精灵"
  },
  {
   "i": 50,
   "start": 173.359,
   "end": 175.779,
   "en": "",
   "zh": "他拿出铁棍"
  },
  {
   "i": 51,
   "start": 175.779,
   "end": 177.2,
   "en": "",
   "zh": "你是谁"
  },
  {
   "i": 52,
   "start": 177.739,
   "end": 179.019,
   "en": "",
   "zh": "我是维纳斯"
  },
  {
   "i": 53,
   "start": 179.019,
   "end": 180.259,
   "en": "",
   "zh": "幽灵说"
  },
  {
   "i": 54,
   "start": 180.259,
   "end": 183.3,
   "en": "",
   "zh": "我有玉皇大帝的邀请"
  },
  {
   "i": 55,
   "start": 183.799,
   "end": 186.68,
   "en": "",
   "zh": "他希望你来天堂生活"
  },
  {
   "i": 56,
   "start": 186.939,
   "end": 189.719,
   "en": "",
   "zh": "悟空终于笑了"
  },
  {
   "i": 57,
   "start": 189.719,
   "end": 191.12,
   "en": "",
   "zh": "他邀请我"
  },
  {
   "i": 58,
   "start": 195.84,
   "end": 199.28,
   "en": "",
   "zh": "当悟空进入云宫的宫廷"
  },
  {
   "i": 59,
   "start": 199.28,
   "end": 200.74,
   "en": "",
   "zh": "他没有鞠躬"
  },
  {
   "i": 60,
   "start": 202.4,
   "end": 205.3,
   "en": "",
   "zh": "你应该在皇帝低语前鞠躬"
  },
  {
   "i": 61,
   "start": 205.3,
   "end": 208.62,
   "en": "",
   "zh": "维纳斯悟空笑了"
  },
  {
   "i": 62,
   "start": 208.62,
   "end": 210.56,
   "en": "",
   "zh": "我和他一样强大"
  },
  {
   "i": 63,
   "start": 211.8,
   "end": 213.54,
   "en": "",
   "zh": "也许他应该在我面前鞠躬"
  },
  {
   "i": 64,
   "start": 215.68,
   "end": 218.24,
   "en": "",
   "zh": "除了玉帝，每个人都倒吸了一口凉气"
  },
  {
   "i": 65,
   "start": 219.02,
   "end": 221.14,
   "en": "",
   "zh": "悟空看着皇帝"
  },
  {
   "i": 66,
   "start": 221.14,
   "end": 223.16,
   "en": "",
   "zh": "我很高兴你邀请我"
  },
  {
   "i": 67,
   "start": 223.459,
   "end": 226.939,
   "en": "",
   "zh": "我想你终于意识到我应该住在这里"
  },
  {
   "i": 68,
   "start": 226.939,
   "end": 229.799,
   "en": "",
   "zh": "对你们所有人都要尊重"
  },
  {
   "i": 69,
   "start": 229.799,
   "end": 230.639,
   "en": "",
   "zh": "维纳斯说"
  },
  {
   "i": 70,
   "start": 231.719,
   "end": 234.98,
   "en": "",
   "zh": "玉帝看着金星笑了"
  },
  {
   "i": 71,
   "start": 235.379,
   "end": 237.199,
   "en": "",
   "zh": "悟空是新来的"
  },
  {
   "i": 72,
   "start": 237.199,
   "end": 240.42,
   "en": "",
   "zh": "他的行为不对是可以原谅的"
  },
  {
   "i": 73,
   "start": 240.939,
   "end": 242.219,
   "en": "",
   "zh": "他看着悟空"
  },
  {
   "i": 74,
   "start": 246.6,
   "end": 249.02,
   "en": "",
   "zh": "你将在天堂有一个家"
  },
  {
   "i": 75,
   "start": 249.419,
   "end": 252.419,
   "en": "",
   "zh": "我希望你不要再惹麻烦了"
  },
  {
   "i": 76,
   "start": 254.18,
   "end": 255.54,
   "en": "",
   "zh": "听起来很完美"
  },
  {
   "i": 77,
   "start": 255.54,
   "end": 258.879,
   "en": "",
   "zh": "第二天早上，悟空说"
  },
  {
   "i": 78,
   "start": 258.879,
   "end": 261.899,
   "en": "",
   "zh": "园艺师带悟空参观桃园"
  },
  {
   "i": 79,
   "start": 262.72,
   "end": 266.78,
   "en": "",
   "zh": "鲜艳的桃子挂在每一根树枝上"
  },
  {
   "i": 80,
   "start": 268.279,
   "end": 271.279,
   "en": "",
   "zh": "这个花园里的桃子和地球上的桃子不一样"
  },
  {
   "i": 81,
   "start": 271.279,
   "end": 272.7,
   "en": "",
   "zh": "园丁说"
  },
  {
   "i": 82,
   "start": 273.22,
   "end": 275.98,
   "en": "",
   "zh": "这些桃子需要几千年才能成熟。"
  },
  {
   "i": 83,
   "start": 277.3,
   "end": 280.18,
   "en": "",
   "zh": "只要咬一口就能长生不老"
  },
  {
   "i": 84,
   "start": 283.54,
   "end": 284.48,
   "en": "",
   "zh": "每天早上"
  },
  {
   "i": 85,
   "start": 284.48,
   "end": 287.76,
   "en": "",
   "zh": "悟空检查了花园里的树木"
  },
  {
   "i": 86,
   "start": 288.679,
   "end": 291.42,
   "en": "",
   "zh": "他很认真地对待他的工作"
  },
  {
   "i": 87,
   "start": 293.98,
   "end": 295.7,
   "en": "",
   "zh": "这些桃子看起来很好吃"
  },
  {
   "i": 88,
   "start": 295.7,
   "end": 299.04,
   "en": "",
   "zh": "悟空以为有一天他环顾四周"
  },
  {
   "i": 89,
   "start": 300.08,
   "end": 302.28,
   "en": "",
   "zh": "一个园丁也看不见"
  },
  {
   "i": 90,
   "start": 304.56,
   "end": 305.76,
   "en": "",
   "zh": "也许我会吃一个"
  }
 ]
}
