{
 "id": "jtw10",
 "title": "The Powerful Sage",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.62,
   "end": 2.08,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 2.08,
   "end": 3.42,
   "en": "",
   "zh": "第十章"
  },
  {
   "i": 3,
   "start": 3.42,
   "end": 5.62,
   "en": "",
   "zh": "强大的圣人"
  },
  {
   "i": 4,
   "start": 11.299,
   "end": 13.959,
   "en": "",
   "zh": "我们要怎么打败孙悟空"
  },
  {
   "i": 5,
   "start": 13.959,
   "end": 15.499,
   "en": "",
   "zh": "玉皇大帝悲叹道"
  },
  {
   "i": 6,
   "start": 16.659,
   "end": 18.119,
   "en": "",
   "zh": "我派出了整个军队"
  },
  {
   "i": 7,
   "start": 18.119,
   "end": 19.84,
   "en": "",
   "zh": "他们不能逮捕他"
  },
  {
   "i": 8,
   "start": 20.84,
   "end": 24.5,
   "en": "",
   "zh": "也许我们可以叫圣人二郎去抓他"
  },
  {
   "i": 9,
   "start": 24.5,
   "end": 25.88,
   "en": "",
   "zh": "观音说"
  },
  {
   "i": 10,
   "start": 28.16,
   "end": 32.0,
   "en": "",
   "zh": "说玉皇大帝二郎很厉害"
  },
  {
   "i": 11,
   "start": 33.24,
   "end": 35.34,
   "en": "",
   "zh": "他转向信使"
  },
  {
   "i": 12,
   "start": 35.34,
   "end": 37.019,
   "en": "",
   "zh": "去梅山"
  },
  {
   "i": 13,
   "start": 37.3,
   "end": 38.5,
   "en": "",
   "zh": "问她郎"
  },
  {
   "i": 14,
   "start": 38.5,
   "end": 39.839,
   "en": "",
   "zh": "如果你能帮助我们"
  },
  {
   "i": 15,
   "start": 43.46,
   "end": 45.96,
   "en": "",
   "zh": "悟空站在瀑布前"
  },
  {
   "i": 16,
   "start": 45.96,
   "end": 47.9,
   "en": "",
   "zh": "和他欢呼的臣民"
  },
  {
   "i": 17,
   "start": 50.18,
   "end": 52.94,
   "en": "",
   "zh": "我们的国王刚刚从天上打败了一整支军队"
  },
  {
   "i": 18,
   "start": 52.94,
   "end": 54.26,
   "en": "",
   "zh": "长臂猿说"
  },
  {
   "i": 19,
   "start": 56.02,
   "end": 58.4,
   "en": "",
   "zh": "我希望玉帝能吸取教训"
  },
  {
   "i": 20,
   "start": 58.4,
   "end": 59.76,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 21,
   "start": 60.06,
   "end": 65.44,
   "en": "",
   "zh": "他和他的军队不是孙悟空的对手一个低沉的声音"
  },
  {
   "i": 22,
   "start": 65.44,
   "end": 68.62,
   "en": "",
   "zh": "薄悟空抬起头来"
  },
  {
   "i": 23,
   "start": 69.82,
   "end": 72.86,
   "en": "",
   "zh": "一个大个子从天而降"
  },
  {
   "i": 24,
   "start": 73.42,
   "end": 76.6,
   "en": "",
   "zh": "猿猴和其他猴子跑了起来"
  },
  {
   "i": 25,
   "start": 79.82,
   "end": 81.24,
   "en": "",
   "zh": "我是二郎"
  },
  {
   "i": 26,
   "start": 81.24,
   "end": 85.98,
   "en": "",
   "zh": "玉帝派我来抓你的人说"
  },
  {
   "i": 27,
   "start": 89.56,
   "end": 92.74,
   "en": "",
   "zh": "玉帝全军都打不过我"
  },
  {
   "i": 28,
   "start": 92.74,
   "end": 95.16,
   "en": "",
   "zh": "你觉得你要做什么"
  },
  {
   "i": 29,
   "start": 95.68,
   "end": 97.94,
   "en": "",
   "zh": "我要带你回天堂"
  },
  {
   "i": 30,
   "start": 97.94,
   "end": 99.36,
   "en": "",
   "zh": "二郎说"
  },
  {
   "i": 31,
   "start": 99.36,
   "end": 101.64,
   "en": "",
   "zh": "你会受到惩罚"
  },
  {
   "i": 32,
   "start": 103.06,
   "end": 104.84,
   "en": "",
   "zh": "挥舞着他的铁棍"
  },
  {
   "i": 33,
   "start": 104.84,
   "end": 107.34,
   "en": "",
   "zh": "悟空向二郎一跃而起"
  },
  {
   "i": 34,
   "start": 109.06,
   "end": 114.2,
   "en": "",
   "zh": "铿二郎用剑挡住了栏杆，然后还击"
  },
  {
   "i": 35,
   "start": 114.9,
   "end": 117.98,
   "en": "",
   "zh": "悟空跳上云彩闪开"
  },
  {
   "i": 36,
   "start": 119.42,
   "end": 121.399,
   "en": "",
   "zh": "二郎一跃而起"
  },
  {
   "i": 37,
   "start": 124.1,
   "end": 127.539,
   "en": "",
   "zh": "他摇晃着身体，突然变得更大了"
  },
  {
   "i": 38,
   "start": 127.8,
   "end": 128.919,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 39,
   "start": 130.759,
   "end": 132.3,
   "en": "",
   "zh": "我也能做到"
  },
  {
   "i": 40,
   "start": 133.0,
   "end": 136.94,
   "en": "",
   "zh": "他摇晃着身体，长得和二郎一样大"
  },
  {
   "i": 41,
   "start": 142.26,
   "end": 147.06,
   "en": "",
   "zh": "当两个巨人在天空中搏斗时，云旋转着，风吹着"
  },
  {
   "i": 42,
   "start": 147.06,
   "end": 150.5,
   "en": "",
   "zh": "他们的武器整夜砰砰作响"
  },
  {
   "i": 43,
   "start": 151.26,
   "end": 152.72,
   "en": "",
   "zh": "他们还在战斗"
  },
  {
   "i": 44,
   "start": 152.72,
   "end": 155.24,
   "en": "",
   "zh": "第二天早上太阳升起的时候"
  },
  {
   "i": 45,
   "start": 156.16,
   "end": 158.0,
   "en": "",
   "zh": "这场战斗可能会永远持续下去"
  },
  {
   "i": 46,
   "start": 158.0,
   "end": 159.12,
   "en": "",
   "zh": "悟空想"
  },
  {
   "i": 47,
   "start": 160.16,
   "end": 161.86,
   "en": "",
   "zh": "我应该尝试一个不同的计划"
  },
  {
   "i": 48,
   "start": 162.699,
   "end": 165.659,
   "en": "",
   "zh": "悟空最后一击二郎"
  },
  {
   "i": 49,
   "start": 165.659,
   "end": 168.44,
   "en": "",
   "zh": "然后跳回地球"
  },
  {
   "i": 50,
   "start": 171.479,
   "end": 173.619,
   "en": "",
   "zh": "他把自己变成了一只麻雀"
  },
  {
   "i": 51,
   "start": 173.619,
   "end": 175.18,
   "en": "",
   "zh": "栖息在树枝上"
  },
  {
   "i": 52,
   "start": 176.26,
   "end": 179.02,
   "en": "",
   "zh": "狼伯爵再也找不到我了，悟空想"
  },
  {
   "i": 53,
   "start": 180.5,
   "end": 182.42,
   "en": "",
   "zh": "他抬头看到一只鹰"
  },
  {
   "i": 54,
   "start": 182.76,
   "end": 185.28,
   "en": "",
   "zh": "老鹰向他猛扑过来"
  },
  {
   "i": 55,
   "start": 185.28,
   "end": 189.08,
   "en": "",
   "zh": "哦，不，悟空，那是二郎"
  },
  {
   "i": 56,
   "start": 189.64,
   "end": 192.7,
   "en": "",
   "zh": "悟空跳进了一条小溪"
  },
  {
   "i": 57,
   "start": 193.74,
   "end": 195.58,
   "en": "",
   "zh": "他把自己变成了一条鱼"
  },
  {
   "i": 58,
   "start": 195.58,
   "end": 197.62,
   "en": "",
   "zh": "在水里游来游去"
  },
  {
   "i": 59,
   "start": 198.459,
   "end": 202.14,
   "en": "",
   "zh": "但后来一只鹤飞过小溪"
  },
  {
   "i": 60,
   "start": 202.819,
   "end": 205.239,
   "en": "",
   "zh": "鹤向水面俯冲而下"
  },
  {
   "i": 61,
   "start": 205.239,
   "end": 206.979,
   "en": "",
   "zh": "它的嘴张得很大"
  },
  {
   "i": 62,
   "start": 208.099,
   "end": 210.6,
   "en": "",
   "zh": "悟空出溪"
  },
  {
   "i": 63,
   "start": 211.32,
   "end": 213.46,
   "en": "",
   "zh": "他变回了自己"
  },
  {
   "i": 64,
   "start": 213.46,
   "end": 215.42,
   "en": "",
   "zh": "跑下山"
  },
  {
   "i": 65,
   "start": 216.56,
   "end": 218.3,
   "en": "",
   "zh": "我要把自己变成一座庙宇"
  },
  {
   "i": 66,
   "start": 218.3,
   "end": 220.36,
   "en": "",
   "zh": "他当时想"
  },
  {
   "i": 67,
   "start": 220.36,
   "end": 221.76,
   "en": "",
   "zh": "如果二郎试图进入"
  },
  {
   "i": 68,
   "start": 221.76,
   "end": 223.24,
   "en": "",
   "zh": "我要咬他"
  },
  {
   "i": 69,
   "start": 227.68,
   "end": 230.36,
   "en": "",
   "zh": "悟空的眼睛变成了窗户"
  },
  {
   "i": 70,
   "start": 230.36,
   "end": 232.66,
   "en": "",
   "zh": "他的嘴变成了一扇门"
  },
  {
   "i": 71,
   "start": 233.259,
   "end": 236.22,
   "en": "",
   "zh": "他把尾巴变成了旗杆"
  },
  {
   "i": 72,
   "start": 236.64,
   "end": 237.82,
   "en": "",
   "zh": "过了一会儿"
  },
  {
   "i": 73,
   "start": 237.82,
   "end": 239.88,
   "en": "",
   "zh": "朗伯爵从山上下来"
  },
  {
   "i": 74,
   "start": 240.6,
   "end": 241.74,
   "en": "",
   "zh": "当他看到寺庙"
  },
  {
   "i": 75,
   "start": 241.74,
   "end": 243.54,
   "en": "",
   "zh": "他挠了挠头"
  },
  {
   "i": 76,
   "start": 245.299,
   "end": 246.659,
   "en": "",
   "zh": "二郎说"
  },
  {
   "i": 77,
   "start": 246.659,
   "end": 249.7,
   "en": "",
   "zh": "我从来没见过有旗杆的寺庙"
  },
  {
   "i": 78,
   "start": 250.279,
   "end": 251.599,
   "en": "",
   "zh": "这一定是悟空"
  },
  {
   "i": 79,
   "start": 252.959,
   "end": 254.68,
   "en": "",
   "zh": "我要踢开那扇门"
  },
  {
   "i": 80,
   "start": 255.64,
   "end": 256.839,
   "en": "",
   "zh": "哦，不用想"
  },
  {
   "i": 81,
   "start": 256.839,
   "end": 257.66,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 82,
   "start": 258.079,
   "end": 259.879,
   "en": "",
   "zh": "他会打烂我所有的牙齿"
  },
  {
   "i": 83,
   "start": 259.879,
   "end": 263.56,
   "en": "",
   "zh": "悟空变回自己跑了"
  },
  {
   "i": 84,
   "start": 265.06,
   "end": 267.4,
   "en": "",
   "zh": "二郎就在他后面"
  },
  {
   "i": 85,
   "start": 269.86,
   "end": 270.92,
   "en": "",
   "zh": "在天堂"
  },
  {
   "i": 86,
   "start": 270.92,
   "end": 271.96,
   "en": "",
   "zh": "玉皇大帝"
  },
  {
   "i": 87,
   "start": 271.96,
   "end": 275.14,
   "en": "",
   "zh": "女王和观音看着追逐"
  },
  {
   "i": 88,
   "start": 276.72,
   "end": 279.88,
   "en": "",
   "zh": "圣人阿扎向他们走来"
  },
  {
   "i": 89,
   "start": 280.699,
   "end": 281.799,
   "en": "",
   "zh": "发生什么事了？"
  },
  {
   "i": 90,
   "start": 281.799,
   "end": 282.459,
   "en": "",
   "zh": "他问"
  },
  {
   "i": 91,
   "start": 282.459,
   "end": 287.719,
   "en": "",
   "zh": "往下看孙悟空把园子里的桃子都吃光了"
  },
  {
   "i": 92,
   "start": 287.719,
   "end": 289.42,
   "en": "",
   "zh": "玉皇大帝说"
  },
  {
   "i": 93,
   "start": 290.14,
   "end": 292.02,
   "en": "",
   "zh": "然后他打败了我们整个军队"
  },
  {
   "i": 94,
   "start": 293.18,
   "end": 295.66,
   "en": "",
   "zh": "二郎现在想抓他"
  },
  {
   "i": 95,
   "start": 296.48,
   "end": 297.5,
   "en": "",
   "zh": "我可以帮忙"
  },
  {
   "i": 96,
   "start": 297.5,
   "end": 298.4,
   "en": "",
   "zh": "老沙说"
  },
  {
   "i": 97,
   "start": 299.48,
   "end": 302.14,
   "en": "",
   "zh": "他从手臂上取下一个金属环"
  },
  {
   "i": 98,
   "start": 303.98,
   "end": 305.2,
   "en": "",
   "zh": "他仔细地瞄准"
  },
  {
   "i": 99,
   "start": 305.2,
   "end": 307.94,
   "en": "",
   "zh": "把它扔到地上"
  },
  {
   "i": 100,
   "start": 312.4,
   "end": 315.66,
   "en": "",
   "zh": "砰的一声，戒指打在悟空的头上"
  },
  {
   "i": 101,
   "start": 315.66,
   "end": 318.0,
   "en": "",
   "zh": "猴子一时头晕目眩"
  },
  {
   "i": 102,
   "start": 318.0,
   "end": 319.7,
   "en": "",
   "zh": "然后倒在地上"
  }
 ]
}
