{
 "id": "jtw11",
 "title": "Trouble in Heaven",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 1.3,
   "end": 2.58,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 2.58,
   "end": 3.92,
   "en": "",
   "zh": "第十一章"
  },
  {
   "i": 3,
   "start": 3.92,
   "end": 5.5,
   "en": "",
   "zh": "天堂里的麻烦"
  },
  {
   "i": 4,
   "start": 15.64,
   "end": 19.7,
   "en": "",
   "zh": "二郎赶紧把悟空绑起来，带他上天"
  },
  {
   "i": 5,
   "start": 24.599,
   "end": 26.959,
   "en": "",
   "zh": "我要消灭孙悟空"
  },
  {
   "i": 6,
   "start": 26.959,
   "end": 28.64,
   "en": "",
   "zh": "玉皇大帝说"
  },
  {
   "i": 7,
   "start": 30.94,
   "end": 34.48,
   "en": "",
   "zh": "士兵们把悟空绑在院子里的一根柱子上"
  },
  {
   "i": 8,
   "start": 35.48,
   "end": 37.86,
   "en": "",
   "zh": "他们用剑打他"
  },
  {
   "i": 9,
   "start": 39.74,
   "end": 42.84,
   "en": "",
   "zh": "但他的身体像钻石一样坚硬"
  },
  {
   "i": 10,
   "start": 42.84,
   "end": 45.04,
   "en": "",
   "zh": "击碎的剑"
  },
  {
   "i": 11,
   "start": 45.26,
   "end": 46.38,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 12,
   "start": 47.82,
   "end": 49.739,
   "en": "",
   "zh": "你的剑伤不了我"
  },
  {
   "i": 13,
   "start": 50.24,
   "end": 53.08,
   "en": "",
   "zh": "玉皇大帝派使者"
  },
  {
   "i": 14,
   "start": 53.08,
   "end": 55.22,
   "en": "",
   "zh": "把火神带来"
  },
  {
   "i": 15,
   "start": 58.14,
   "end": 63.0,
   "en": "",
   "zh": "几个火神进了院子，向悟空扔火球"
  },
  {
   "i": 16,
   "start": 63.64,
   "end": 66.16,
   "en": "",
   "zh": "烟雾弥漫的院子"
  },
  {
   "i": 17,
   "start": 67.68,
   "end": 69.34,
   "en": "",
   "zh": "但当硝烟散尽"
  },
  {
   "i": 18,
   "start": 69.34,
   "end": 72.98,
   "en": "",
   "zh": "悟空身上没有一根头发被烧掉"
  },
  {
   "i": 19,
   "start": 74.1,
   "end": 74.9,
   "en": "",
   "zh": "谢谢。"
  },
  {
   "i": 20,
   "start": 74.9,
   "end": 76.26,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 21,
   "start": 76.26,
   "end": 78.38,
   "en": "",
   "zh": "我觉得有点冷"
  },
  {
   "i": 22,
   "start": 81.18,
   "end": 82.86,
   "en": "",
   "zh": "集合雷神"
  },
  {
   "i": 23,
   "start": 82.86,
   "end": 84.539,
   "en": "",
   "zh": "玉皇大帝说"
  },
  {
   "i": 24,
   "start": 86.2,
   "end": 89.14,
   "en": "",
   "zh": "几个雷神进了院子"
  },
  {
   "i": 25,
   "start": 90.28,
   "end": 91.98,
   "en": "",
   "zh": "玉皇大帝笑了"
  },
  {
   "i": 26,
   "start": 91.98,
   "end": 94.36,
   "en": "",
   "zh": "当闪电射向悟空"
  },
  {
   "i": 27,
   "start": 95.44,
   "end": 100.08,
   "en": "",
   "zh": "但即使是闪电也伤害不了挠痒痒的猴子"
  },
  {
   "i": 28,
   "start": 100.08,
   "end": 102.1,
   "en": "",
   "zh": "悟空笑着说"
  },
  {
   "i": 29,
   "start": 102.1,
   "end": 105.039,
   "en": "",
   "zh": "玉皇大帝摇了摇头"
  },
  {
   "i": 30,
   "start": 106.28,
   "end": 109.52,
   "en": "",
   "zh": "看来悟空是灭不了的"
  },
  {
   "i": 31,
   "start": 109.9,
   "end": 112.08,
   "en": "",
   "zh": "那是因为他把桃子都吃了"
  },
  {
   "i": 32,
   "start": 112.08,
   "end": 113.48,
   "en": "",
   "zh": "拉萨说"
  },
  {
   "i": 33,
   "start": 113.76,
   "end": 116.28,
   "en": "",
   "zh": "只要一个桃子就能让人长生不老"
  },
  {
   "i": 34,
   "start": 117.68,
   "end": 120.1,
   "en": "",
   "zh": "他把花园里的桃子都吃了"
  },
  {
   "i": 35,
   "start": 120.74,
   "end": 122.24,
   "en": "",
   "zh": "皇帝皱起了眉头"
  },
  {
   "i": 36,
   "start": 122.24,
   "end": 124.32,
   "en": "",
   "zh": "那我们怎么除掉他"
  },
  {
   "i": 37,
   "start": 125.12,
   "end": 126.3,
   "en": "",
   "zh": "我有个主意"
  },
  {
   "i": 38,
   "start": 126.3,
   "end": 127.7,
   "en": "",
   "zh": "劳尔说"
  },
  {
   "i": 39,
   "start": 127.7,
   "end": 129.52,
   "en": "",
   "zh": "我把他放在大锅里"
  },
  {
   "i": 40,
   "start": 129.52,
   "end": 130.84,
   "en": "",
   "zh": "我用来做药水的"
  },
  {
   "i": 41,
   "start": 132.0,
   "end": 133.24,
   "en": "",
   "zh": "也许我们可以把他烧了"
  },
  {
   "i": 42,
   "start": 133.24,
   "end": 135.319,
   "en": "",
   "zh": "慢慢完善"
  },
  {
   "i": 43,
   "start": 135.319,
   "end": 137.12,
   "en": "",
   "zh": "玉皇大帝说"
  },
  {
   "i": 44,
   "start": 147.94,
   "end": 151.0,
   "en": "",
   "zh": "一个大锅坐在房间中央"
  },
  {
   "i": 45,
   "start": 151.8,
   "end": 154.44,
   "en": "",
   "zh": "老三把悟空放进锅里"
  },
  {
   "i": 46,
   "start": 157.819,
   "end": 159.219,
   "en": "",
   "zh": "然后盖上盖子"
  },
  {
   "i": 47,
   "start": 160.459,
   "end": 162.9,
   "en": "",
   "zh": "老祖在锅底生起了火"
  },
  {
   "i": 48,
   "start": 164.48,
   "end": 166.86,
   "en": "",
   "zh": "他日日夜夜地照料炉火"
  },
  {
   "i": 49,
   "start": 167.5,
   "end": 171.02,
   "en": "",
   "zh": "他让它燃烧了四天九天"
  },
  {
   "i": 50,
   "start": 172.08,
   "end": 175.96,
   "en": "",
   "zh": "悟空现在一定被激光摧毁了"
  },
  {
   "i": 51,
   "start": 181.919,
   "end": 184.76,
   "en": "",
   "zh": "他慢慢地揭开锅盖"
  },
  {
   "i": 52,
   "start": 186.0,
   "end": 187.52,
   "en": "",
   "zh": "烟从洞口涌出"
  },
  {
   "i": 53,
   "start": 188.68,
   "end": 191.12,
   "en": "",
   "zh": "悟空跳了出来"
  },
  {
   "i": 54,
   "start": 192.6,
   "end": 193.68,
   "en": "",
   "zh": "锅倒了"
  },
  {
   "i": 55,
   "start": 194.92,
   "end": 197.6,
   "en": "",
   "zh": "燃烧的煤块到处飞"
  },
  {
   "i": 56,
   "start": 199.96,
   "end": 201.58,
   "en": "",
   "zh": "悟空的眼睛红了"
  },
  {
   "i": 57,
   "start": 201.58,
   "end": 203.2,
   "en": "",
   "zh": "他在咳嗽"
  },
  {
   "i": 58,
   "start": 203.62,
   "end": 205.58,
   "en": "",
   "zh": "那烟太可怕了"
  },
  {
   "i": 59,
   "start": 205.58,
   "end": 206.38,
   "en": "",
   "zh": "他哭了"
  },
  {
   "i": 60,
   "start": 208.9,
   "end": 209.98,
   "en": "",
   "zh": "他推拉佐"
  },
  {
   "i": 61,
   "start": 209.98,
   "end": 212.2,
   "en": "",
   "zh": "把鼠尾草敲在背上"
  },
  {
   "i": 62,
   "start": 212.939,
   "end": 217.64,
   "en": "",
   "zh": "悟空掏出铁棍把屋里的东西都砸了"
  },
  {
   "i": 63,
   "start": 218.6,
   "end": 219.92,
   "en": "",
   "zh": "有人阻止他"
  },
  {
   "i": 64,
   "start": 219.92,
   "end": 220.28,
   "en": "",
   "zh": "叫道"
  },
  {
   "i": 65,
   "start": 220.28,
   "end": 220.84,
   "en": "",
   "zh": "老祖"
  },
  {
   "i": 66,
   "start": 221.92,
   "end": 224.68,
   "en": "",
   "zh": "悟空从老子的宫殿里跑了出来"
  },
  {
   "i": 67,
   "start": 225.899,
   "end": 230.2,
   "en": "",
   "zh": "当悟空粉碎他道路上的一切时，众神和灵魂都流血了"
  },
  {
   "i": 68,
   "start": 231.16,
   "end": 233.88,
   "en": "",
   "zh": "老祖跑进了云宫"
  },
  {
   "i": 69,
   "start": 236.26,
   "end": 239.76,
   "en": "",
   "zh": "大王悟空大闹天宫"
  },
  {
   "i": 70,
   "start": 239.76,
   "end": 240.84,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 71,
   "start": 242.16,
   "end": 242.58,
   "en": "",
   "zh": "叫道"
  },
  {
   "i": 72,
   "start": 242.58,
   "end": 243.34,
   "en": "",
   "zh": "皇帝"
  },
  {
   "i": 73,
   "start": 243.34,
   "end": 245.04,
   "en": "",
   "zh": "他还活着"
  },
  {
   "i": 74,
   "start": 245.619,
   "end": 246.219,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 75,
   "start": 246.219,
   "end": 247.479,
   "en": "",
   "zh": "说激光"
  },
  {
   "i": 76,
   "start": 247.479,
   "end": 249.139,
   "en": "",
   "zh": "我把锅盖取下来"
  },
  {
   "i": 77,
   "start": 249.139,
   "end": 250.979,
   "en": "",
   "zh": "因为我以为他被烧死了"
  },
  {
   "i": 78,
   "start": 250.979,
   "end": 253.28,
   "en": "",
   "zh": "但大火一点也没伤到他"
  },
  {
   "i": 79,
   "start": 253.799,
   "end": 255.319,
   "en": "",
   "zh": "这是一种暴行"
  },
  {
   "i": 80,
   "start": 255.319,
   "end": 256.86,
   "en": "",
   "zh": "玉皇大帝说"
  },
  {
   "i": 81,
   "start": 257.36,
   "end": 260.0,
   "en": "",
   "zh": "我们该拿那只猴子怎么办"
  },
  {
   "i": 82,
   "start": 260.0,
   "end": 262.72,
   "en": "",
   "zh": "皇帝想了一会儿"
  },
  {
   "i": 83,
   "start": 263.599,
   "end": 265.439,
   "en": "",
   "zh": "我们一定要向佛祖求救"
  },
  {
   "i": 84,
   "start": 265.439,
   "end": 268.64,
   "en": "",
   "zh": "他说他转向一个信使"
  },
  {
   "i": 85,
   "start": 268.96,
   "end": 270.64,
   "en": "",
   "zh": "去西方天堂"
  },
  {
   "i": 86,
   "start": 270.64,
   "end": 274.28,
   "en": "",
   "zh": "快去看看佛祖能不能来帮我们"
  },
  {
   "i": 87,
   "start": 277.34,
   "end": 279.24,
   "en": "",
   "zh": "他以最快的速度飞翔"
  },
  {
   "i": 88,
   "start": 279.24,
   "end": 282.8,
   "en": "",
   "zh": "信使向西方天堂进发"
  },
  {
   "i": 89,
   "start": 285.16,
   "end": 288.56,
   "en": "",
   "zh": "当悟空穿过天堂时，每个人都躲在室内"
  },
  {
   "i": 90,
   "start": 291.72,
   "end": 293.22,
   "en": "",
   "zh": "用他的铁棍"
  },
  {
   "i": 91,
   "start": 293.22,
   "end": 297.02,
   "en": "",
   "zh": "他砸碎门窗，打翻雕像"
  },
  {
   "i": 92,
   "start": 297.46,
   "end": 299.02,
   "en": "",
   "zh": "他突然停了下来"
  },
  {
   "i": 93,
   "start": 300.9,
   "end": 302.96,
   "en": "",
   "zh": "在他面前是一个巨大的身影"
  },
  {
   "i": 94,
   "start": 302.96,
   "end": 305.42,
   "en": "",
   "zh": "闪耀着金光"
  },
  {
   "i": 95,
   "start": 306.099,
   "end": 307.239,
   "en": "",
   "zh": "你想要什么"
  },
  {
   "i": 96,
   "start": 307.239,
   "end": 308.219,
   "en": "",
   "zh": "悟空问道"
  },
  {
   "i": 97,
   "start": 309.659,
   "end": 311.019,
   "en": "",
   "zh": "我是佛"
  },
  {
   "i": 98,
   "start": 311.019,
   "end": 312.46,
   "en": "",
   "zh": "人影说"
  },
  {
   "i": 99,
   "start": 313.0,
   "end": 317.52,
   "en": "",
   "zh": "你是谁，为什么要惹这么多麻烦"
  },
  {
   "i": 100,
   "start": 318.42,
   "end": 319.7,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 101,
   "start": 321.18,
   "end": 322.62,
   "en": "",
   "zh": "我是孙悟空"
  },
  {
   "i": 102,
   "start": 322.62,
   "end": 324.88,
   "en": "",
   "zh": "花果山之王"
  },
  {
   "i": 103,
   "start": 325.34,
   "end": 327.8,
   "en": "",
   "zh": "我也应该是天王"
  },
  {
   "i": 104,
   "start": 328.36,
   "end": 332.1,
   "en": "",
   "zh": "我要去云宫叫玉帝离开"
  },
  {
   "i": 105,
   "start": 332.799,
   "end": 333.699,
   "en": "",
   "zh": "如果他不"
  },
  {
   "i": 106,
   "start": 333.699,
   "end": 335.82,
   "en": "",
   "zh": "我永远不会停止制造麻烦"
  }
 ]
}
