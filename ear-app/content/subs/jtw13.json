{
 "id": "jtw13",
 "title": "The True Scriptures",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 1.4,
   "end": 2.82,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 2.82,
   "end": 4.18,
   "en": "",
   "zh": "第十三章"
  },
  {
   "i": 3,
   "start": 4.18,
   "end": 6.56,
   "en": "",
   "zh": "真经"
  },
  {
   "i": 4,
   "start": 13.18,
   "end": 14.82,
   "en": "",
   "zh": "五百年前"
  },
  {
   "i": 5,
   "start": 16.18,
   "end": 19.1,
   "en": "",
   "zh": "悟空被困山下"
  },
  {
   "i": 6,
   "start": 19.66,
   "end": 22.82,
   "en": "",
   "zh": "猴子身上覆盖了一层厚厚的苔藓"
  },
  {
   "i": 7,
   "start": 25.48,
   "end": 26.24,
   "en": "",
   "zh": "有一天"
  },
  {
   "i": 8,
   "start": 26.24,
   "end": 31.04,
   "en": "",
   "zh": "佛陀坐在西方天堂的霹雳寺"
  },
  {
   "i": 9,
   "start": 31.04,
   "end": 33.62,
   "en": "",
   "zh": "他在和他的学生说话"
  },
  {
   "i": 10,
   "start": 34.22,
   "end": 38.62,
   "en": "",
   "zh": "唐朝的东方人需要我们的帮助"
  },
  {
   "i": 11,
   "start": 38.62,
   "end": 39.879,
   "en": "",
   "zh": "佛陀说"
  },
  {
   "i": 12,
   "start": 40.64,
   "end": 43.36,
   "en": "",
   "zh": "他们撒谎、欺骗、偷窃"
  },
  {
   "i": 13,
   "start": 44.26,
   "end": 47.199,
   "en": "",
   "zh": "他们贪得无厌，不停地战斗"
  },
  {
   "i": 14,
   "start": 48.54,
   "end": 51.559,
   "en": "",
   "zh": "他举起一捆卷轴"
  },
  {
   "i": 15,
   "start": 52.02,
   "end": 53.9,
   "en": "",
   "zh": "这些都是真经"
  },
  {
   "i": 16,
   "start": 55.02,
   "end": 59.96,
   "en": "",
   "zh": "他们会教东方人表演得更好精彩"
  },
  {
   "i": 17,
   "start": 59.96,
   "end": 61.02,
   "en": "",
   "zh": "一个学生说"
  },
  {
   "i": 18,
   "start": 62.06,
   "end": 64.679,
   "en": "",
   "zh": "让我们把经文带到大唐帝国"
  },
  {
   "i": 19,
   "start": 65.239,
   "end": 67.96,
   "en": "",
   "zh": "佛陀摇摇头不"
  },
  {
   "i": 20,
   "start": 67.96,
   "end": 71.2,
   "en": "",
   "zh": "他说一个真正的信徒"
  },
  {
   "i": 21,
   "start": 71.2,
   "end": 74.58,
   "en": "",
   "zh": "需要一个和尚来这里拿"
  },
  {
   "i": 22,
   "start": 75.76,
   "end": 79.06,
   "en": "",
   "zh": "会有人到东方去找一个有价值的和尚吗"
  },
  {
   "i": 23,
   "start": 88.62,
   "end": 93.74,
   "en": "",
   "zh": "唐朝皇帝微笑着，他的大和尚为一小群人朗读"
  },
  {
   "i": 24,
   "start": 95.02,
   "end": 97.899,
   "en": "",
   "zh": "和尚在阅读古老的宗教经文"
  },
  {
   "i": 25,
   "start": 98.68,
   "end": 100.4,
   "en": "",
   "zh": "一个女人打断了和尚的话"
  },
  {
   "i": 26,
   "start": 101.52,
   "end": 103.94,
   "en": "",
   "zh": "你为什么读那些旧课文？"
  },
  {
   "i": 27,
   "start": 103.94,
   "end": 105.119,
   "en": "",
   "zh": "她问"
  },
  {
   "i": 28,
   "start": 105.82,
   "end": 108.46,
   "en": "",
   "zh": "你难道不知道真经吗？"
  },
  {
   "i": 29,
   "start": 110.6,
   "end": 112.32,
   "en": "",
   "zh": "皇帝站了起来"
  },
  {
   "i": 30,
   "start": 112.32,
   "end": 115.28,
   "en": "",
   "zh": "你竟敢打断我"
  },
  {
   "i": 31,
   "start": 116.26,
   "end": 117.24,
   "en": "",
   "zh": "没关系"
  },
  {
   "i": 32,
   "start": 117.24,
   "end": 118.1,
   "en": "",
   "zh": "和尚说"
  },
  {
   "i": 33,
   "start": 119.9,
   "end": 121.8,
   "en": "",
   "zh": "他走到那个女人跟前"
  },
  {
   "i": 34,
   "start": 128.979,
   "end": 130.739,
   "en": "",
   "zh": "什么是真经"
  },
  {
   "i": 35,
   "start": 130.739,
   "end": 133.76,
   "en": "",
   "zh": "女人仔细地看着和尚"
  },
  {
   "i": 36,
   "start": 134.72,
   "end": 137.36,
   "en": "",
   "zh": "它们包含了许多教训"
  },
  {
   "i": 37,
   "start": 137.84,
   "end": 141.76,
   "en": "",
   "zh": "吸取教训的人再也不用受苦了"
  },
  {
   "i": 38,
   "start": 142.82,
   "end": 144.0,
   "en": "",
   "zh": "你这里有吗"
  },
  {
   "i": 39,
   "start": 144.0,
   "end": 147.42,
   "en": "",
   "zh": "和尚问没有说"
  },
  {
   "i": 40,
   "start": 147.42,
   "end": 148.14,
   "en": "",
   "zh": "那个女人"
  },
  {
   "i": 41,
   "start": 148.14,
   "end": 151.72,
   "en": "",
   "zh": "他们和佛陀在西方天堂"
  },
  {
   "i": 42,
   "start": 152.44,
   "end": 156.46,
   "en": "",
   "zh": "一定要有人去霹雳寺拿"
  },
  {
   "i": 43,
   "start": 156.839,
   "end": 160.78,
   "en": "",
   "zh": "但只有真正的信徒才能踏上旅程"
  },
  {
   "i": 44,
   "start": 161.86,
   "end": 164.06,
   "en": "",
   "zh": "她从包里拿出一件长袍"
  },
  {
   "i": 45,
   "start": 165.86,
   "end": 166.88,
   "en": "",
   "zh": "把这个穿上"
  },
  {
   "i": 46,
   "start": 169.879,
   "end": 171.78,
   "en": "",
   "zh": "和尚穿上长袍"
  },
  {
   "i": 47,
   "start": 172.519,
   "end": 174.719,
   "en": "",
   "zh": "光束从里面照出来"
  },
  {
   "i": 48,
   "start": 175.719,
   "end": 177.36,
   "en": "",
   "zh": "皇帝倒吸了一口凉气"
  },
  {
   "i": 49,
   "start": 177.959,
   "end": 184.58,
   "en": "",
   "zh": "“你是一个真正的信徒，”女人说，“你会去旅行吗？”"
  },
  {
   "i": 50,
   "start": 185.88,
   "end": 186.54,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 51,
   "start": 186.54,
   "end": 187.64,
   "en": "",
   "zh": "和尚说"
  },
  {
   "i": 52,
   "start": 187.64,
   "end": 189.8,
   "en": "",
   "zh": "低头看着发光的长袍"
  },
  {
   "i": 53,
   "start": 190.8,
   "end": 192.16,
   "en": "",
   "zh": "这将是一种荣誉"
  },
  {
   "i": 54,
   "start": 192.74,
   "end": 194.96,
   "en": "",
   "zh": "旅途会很艰难"
  },
  {
   "i": 55,
   "start": 194.96,
   "end": 196.34,
   "en": "",
   "zh": "女人问"
  },
  {
   "i": 56,
   "start": 197.179,
   "end": 201.22,
   "en": "",
   "zh": "宽阔的河流和陡峭的山脉会挡住你的去路"
  },
  {
   "i": 57,
   "start": 202.06,
   "end": 206.28,
   "en": "",
   "zh": "凶猛的生物和邪恶的恶魔会试图攻击你"
  },
  {
   "i": 58,
   "start": 209.039,
   "end": 212.76,
   "en": "",
   "zh": "但不要害怕你会得到我的帮助"
  },
  {
   "i": 59,
   "start": 214.32,
   "end": 218.08,
   "en": "",
   "zh": "突然房间里充满了刺眼的光线"
  },
  {
   "i": 60,
   "start": 218.479,
   "end": 221.98,
   "en": "",
   "zh": "女人升到空中，变了形"
  },
  {
   "i": 61,
   "start": 222.979,
   "end": 224.939,
   "en": "",
   "zh": "是观音的船"
  },
  {
   "i": 62,
   "start": 224.939,
   "end": 229.88,
   "en": "",
   "zh": "有人喊道皇帝，房间里的其他人都鞠了一躬"
  },
  {
   "i": 63,
   "start": 230.38,
   "end": 233.76,
   "en": "",
   "zh": "观音升得更高，然后消失了"
  },
  {
   "i": 64,
   "start": 237.44,
   "end": 240.18,
   "en": "",
   "zh": "第二天早上有一场盛大的盛宴"
  },
  {
   "i": 65,
   "start": 240.959,
   "end": 243.92,
   "en": "",
   "zh": "唐朝皇帝坐在和尚旁边。"
  },
  {
   "i": 66,
   "start": 249.82,
   "end": 253.76,
   "en": "",
   "zh": "我们的人民不再受苦，不再彼此相待"
  },
  {
   "i": 67,
   "start": 254.38,
   "end": 255.46,
   "en": "",
   "zh": "从现在开始"
  },
  {
   "i": 68,
   "start": 255.46,
   "end": 258.019,
   "en": "",
   "zh": "我会把你当成我的兄弟"
  },
  {
   "i": 69,
   "start": 258.619,
   "end": 261.099,
   "en": "",
   "zh": "你就叫唐僧"
  },
  {
   "i": 70,
   "start": 262.099,
   "end": 263.219,
   "en": "",
   "zh": "谢谢皇上"
  },
  {
   "i": 71,
   "start": 263.219,
   "end": 264.78,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 72,
   "start": 265.46,
   "end": 267.44,
   "en": "",
   "zh": "这趟旅行需要多长时间？"
  },
  {
   "i": 73,
   "start": 267.44,
   "end": 268.84,
   "en": "",
   "zh": "皇帝问道"
  },
  {
   "i": 74,
   "start": 269.46,
   "end": 271.32,
   "en": "",
   "zh": "我几年后就会回来"
  },
  {
   "i": 75,
   "start": 271.32,
   "end": 273.38,
   "en": "",
   "zh": "和尚说"
  },
  {
   "i": 76,
   "start": 277.639,
   "end": 278.759,
   "en": "",
   "zh": "那天晚些时候"
  },
  {
   "i": 77,
   "start": 278.759,
   "end": 281.5,
   "en": "",
   "zh": "唐僧整装待发"
  },
  {
   "i": 78,
   "start": 282.259,
   "end": 285.06,
   "en": "",
   "zh": "他把特制的睡袍装进一个袋子里。"
  },
  {
   "i": 79,
   "start": 288.84,
   "end": 291.86,
   "en": "",
   "zh": "他把干燥的食物放进另一个袋子里"
  },
  {
   "i": 80,
   "start": 293.48,
   "end": 296.38,
   "en": "",
   "zh": "一大群人聚集在一起道别"
  },
  {
   "i": 81,
   "start": 297.44,
   "end": 298.12,
   "en": "",
   "zh": "祝你好运"
  },
  {
   "i": 82,
   "start": 298.12,
   "end": 300.58,
   "en": "",
   "zh": "我哥说唐朝皇帝"
  },
  {
   "i": 83,
   "start": 302.16,
   "end": 306.66,
   "en": "",
   "zh": "唐僧骑上一匹马向西走去"
  },
  {
   "i": 84,
   "start": 311.6,
   "end": 315.98,
   "en": "",
   "zh": "他旅行了一个多月，终于来到一座大山"
  },
  {
   "i": 85,
   "start": 317.6,
   "end": 320.68,
   "en": "",
   "zh": "他的马慢慢地走上一条陡峭的小径"
  },
  {
   "i": 86,
   "start": 321.52,
   "end": 322.86,
   "en": "",
   "zh": "我有种不祥的预感"
  },
  {
   "i": 87,
   "start": 322.86,
   "end": 324.4,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 88,
   "start": 325.239,
   "end": 327.379,
   "en": "",
   "zh": "他不安地环顾四周"
  },
  {
   "i": 89,
   "start": 327.379,
   "end": 329.68,
   "en": "",
   "zh": "我希望这里没有恶魔"
  },
  {
   "i": 90,
   "start": 330.839,
   "end": 332.599,
   "en": "",
   "zh": "突然一个声音隆隆作响"
  },
  {
   "i": 91,
   "start": 333.759,
   "end": 336.04,
   "en": "",
   "zh": "谁走在我的山上"
  }
 ]
}
