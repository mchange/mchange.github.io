{
 "id": "jtw14",
 "title": "A Promise to Protect",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.54,
   "end": 1.96,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 1.96,
   "end": 3.34,
   "en": "",
   "zh": "第十四章"
  },
  {
   "i": 3,
   "start": 3.34,
   "end": 5.62,
   "en": "",
   "zh": "保护的承诺"
  },
  {
   "i": 4,
   "start": 10.94,
   "end": 13.64,
   "en": "",
   "zh": "唐僧吓得浑身发抖"
  },
  {
   "i": 5,
   "start": 14.02,
   "end": 16.219,
   "en": "",
   "zh": "愤怒的声音又说话了"
  },
  {
   "i": 6,
   "start": 16.219,
   "end": 19.08,
   "en": "",
   "zh": "谁走在我的山上"
  },
  {
   "i": 7,
   "start": 20.439,
   "end": 22.079,
   "en": "",
   "zh": "唐僧叫道"
  },
  {
   "i": 8,
   "start": 22.079,
   "end": 25.84,
   "en": "",
   "zh": "他从马上摔了下来，滚下山去了"
  },
  {
   "i": 9,
   "start": 29.359,
   "end": 32.279,
   "en": "",
   "zh": "在底部，他看到岩石之间有一条裂缝"
  },
  {
   "i": 10,
   "start": 34.439,
   "end": 38.68,
   "en": "",
   "zh": "和尚往里看，看到一只猴子身上长满了苔藓"
  },
  {
   "i": 11,
   "start": 38.68,
   "end": 40.379,
   "en": "",
   "zh": "凝视着他"
  },
  {
   "i": 12,
   "start": 40.68,
   "end": 41.92,
   "en": "",
   "zh": "我叫孙"
  },
  {
   "i": 13,
   "start": 41.92,
   "end": 42.66,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 14,
   "start": 42.66,
   "end": 43.94,
   "en": "",
   "zh": "猴子说"
  },
  {
   "i": 15,
   "start": 43.94,
   "end": 47.04,
   "en": "",
   "zh": "我是花果山之王"
  },
  {
   "i": 16,
   "start": 47.96,
   "end": 49.24,
   "en": "",
   "zh": "你为什么在里面"
  },
  {
   "i": 17,
   "start": 49.24,
   "end": 50.8,
   "en": "",
   "zh": "唐僧问道"
  },
  {
   "i": 18,
   "start": 50.8,
   "end": 52.14,
   "en": "",
   "zh": "他站了起来"
  },
  {
   "i": 19,
   "start": 53.14,
   "end": 54.44,
   "en": "",
   "zh": "佛祖把我放在这里"
  },
  {
   "i": 20,
   "start": 54.44,
   "end": 55.64,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 21,
   "start": 55.86,
   "end": 58.82,
   "en": "",
   "zh": "我因在天堂制造麻烦而受到惩罚"
  },
  {
   "i": 22,
   "start": 58.82,
   "end": 60.279,
   "en": "",
   "zh": "你是谁"
  },
  {
   "i": 23,
   "start": 60.92,
   "end": 62.1,
   "en": "",
   "zh": "我只是个和尚"
  },
  {
   "i": 24,
   "start": 62.1,
   "end": 63.68,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 25,
   "start": 63.68,
   "end": 67.3,
   "en": "",
   "zh": "我要去西天取经"
  },
  {
   "i": 26,
   "start": 67.92,
   "end": 69.56,
   "en": "",
   "zh": "悟空倒吸一口凉气"
  },
  {
   "i": 27,
   "start": 69.56,
   "end": 71.42,
   "en": "",
   "zh": "你就是唐僧"
  },
  {
   "i": 28,
   "start": 71.42,
   "end": 72.44,
   "en": "",
   "zh": "他哭了"
  },
  {
   "i": 29,
   "start": 72.44,
   "end": 74.44,
   "en": "",
   "zh": "我应该和你一起去"
  },
  {
   "i": 30,
   "start": 75.48,
   "end": 77.68,
   "en": "",
   "zh": "唐僧后退了一步"
  },
  {
   "i": 31,
   "start": 78.72,
   "end": 81.52,
   "en": "",
   "zh": "这只奇怪的猴子说的是真的吗？"
  },
  {
   "i": 32,
   "start": 82.42,
   "end": 84.54,
   "en": "",
   "zh": "观音菩萨来看我"
  },
  {
   "i": 33,
   "start": 84.54,
   "end": 86.08,
   "en": "",
   "zh": "悟空继续"
  },
  {
   "i": 34,
   "start": 86.86,
   "end": 87.46,
   "en": "",
   "zh": "她说"
  },
  {
   "i": 35,
   "start": 87.46,
   "end": 88.28,
   "en": "",
   "zh": "我就会被释放"
  },
  {
   "i": 36,
   "start": 88.28,
   "end": 90.84,
   "en": "",
   "zh": "如果我答应在旅途中保护你"
  },
  {
   "i": 37,
   "start": 91.24,
   "end": 92.08,
   "en": "",
   "zh": "让我自由"
  },
  {
   "i": 38,
   "start": 92.08,
   "end": 93.92,
   "en": "",
   "zh": "我会和你一起去西部"
  },
  {
   "i": 39,
   "start": 94.5,
   "end": 96.02,
   "en": "",
   "zh": "唐僧放松了"
  },
  {
   "i": 40,
   "start": 97.34,
   "end": 98.22,
   "en": "",
   "zh": "他看着岩石"
  },
  {
   "i": 41,
   "start": 99.5,
   "end": 100.86,
   "en": "",
   "zh": "我怎么才能释放你"
  },
  {
   "i": 42,
   "start": 101.08,
   "end": 103.78,
   "en": "",
   "zh": "山顶上有一张小纸"
  },
  {
   "i": 43,
   "start": 103.78,
   "end": 104.72,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 44,
   "start": 105.8,
   "end": 107.34,
   "en": "",
   "zh": "你必须把它取下来"
  },
  {
   "i": 45,
   "start": 111.5,
   "end": 114.44,
   "en": "",
   "zh": "唐僧回到山上"
  },
  {
   "i": 46,
   "start": 114.76,
   "end": 117.28,
   "en": "",
   "zh": "他推开灌木和荆棘"
  },
  {
   "i": 47,
   "start": 117.28,
   "end": 120.14,
   "en": "",
   "zh": "把自己拉过大石头"
  },
  {
   "i": 48,
   "start": 125.9,
   "end": 128.919,
   "en": "",
   "zh": "最后他到达了山顶"
  },
  {
   "i": 49,
   "start": 134.5,
   "end": 137.88,
   "en": "",
   "zh": "和尚马上拿起了纸"
  },
  {
   "i": 50,
   "start": 137.88,
   "end": 140.24,
   "en": "",
   "zh": "一阵微风把它从他手里吹走了"
  },
  {
   "i": 51,
   "start": 141.359,
   "end": 142.799,
   "en": "",
   "zh": "纸浮了上来"
  },
  {
   "i": 52,
   "start": 142.799,
   "end": 145.3,
   "en": "",
   "zh": "然后消失在云层中"
  },
  {
   "i": 53,
   "start": 146.12,
   "end": 148.72,
   "en": "",
   "zh": "和尚急忙下山"
  },
  {
   "i": 54,
   "start": 150.6,
   "end": 152.0,
   "en": "",
   "zh": "纸飘走了"
  },
  {
   "i": 55,
   "start": 152.0,
   "end": 153.2,
   "en": "",
   "zh": "他对猴子说"
  },
  {
   "i": 56,
   "start": 154.72,
   "end": 158.6,
   "en": "",
   "zh": "它回到佛祖说悟空现在退后"
  },
  {
   "i": 57,
   "start": 158.799,
   "end": 160.999,
   "en": "",
   "zh": "唐僧后退了一步"
  },
  {
   "i": 58,
   "start": 163.279,
   "end": 165.22,
   "en": "",
   "zh": "走远一点悟空说"
  },
  {
   "i": 59,
   "start": 165.94,
   "end": 167.66,
   "en": "",
   "zh": "和尚又后退了一步"
  },
  {
   "i": 60,
   "start": 168.9,
   "end": 171.94,
   "en": "",
   "zh": "走远一点悟空又说"
  },
  {
   "i": 61,
   "start": 173.919,
   "end": 176.86,
   "en": "",
   "zh": "唐僧远走高飞"
  },
  {
   "i": 62,
   "start": 177.919,
   "end": 182.32,
   "en": "",
   "zh": "当整座山腾空而起时，他倒吸了一口凉气"
  },
  {
   "i": 63,
   "start": 182.86,
   "end": 184.84,
   "en": "",
   "zh": "悟空站在山下"
  },
  {
   "i": 64,
   "start": 184.84,
   "end": 187.16,
   "en": "",
   "zh": "用手举着"
  },
  {
   "i": 65,
   "start": 188.599,
   "end": 189.779,
   "en": "",
   "zh": "他跳了出来"
  },
  {
   "i": 66,
   "start": 189.779,
   "end": 192.66,
   "en": "",
   "zh": "山在他身后轰然倒下"
  },
  {
   "i": 67,
   "start": 196.36,
   "end": 198.56,
   "en": "",
   "zh": "悟空抓住唐僧的手"
  },
  {
   "i": 68,
   "start": 199.88,
   "end": 200.8,
   "en": "",
   "zh": "谢谢师父"
  },
  {
   "i": 69,
   "start": 200.8,
   "end": 203.78,
   "en": "",
   "zh": "我会帮你到达西方天堂"
  },
  {
   "i": 70,
   "start": 205.0,
   "end": 206.9,
   "en": "",
   "zh": "唐僧骑着马"
  },
  {
   "i": 71,
   "start": 206.9,
   "end": 207.84,
   "en": "",
   "zh": "当悟空走路的时候"
  },
  {
   "i": 72,
   "start": 209.0,
   "end": 211.28,
   "en": "",
   "zh": "猴子把自己的情况告诉了和尚"
  },
  {
   "i": 73,
   "start": 211.459,
   "end": 214.819,
   "en": "",
   "zh": "玉帝全军都打不过我"
  },
  {
   "i": 74,
   "start": 214.819,
   "end": 215.659,
   "en": "",
   "zh": "他笑了"
  },
  {
   "i": 75,
   "start": 217.459,
   "end": 218.039,
   "en": "",
   "zh": "所以我说"
  },
  {
   "i": 76,
   "start": 218.039,
   "end": 220.02,
   "en": "",
   "zh": "我应该掌管天堂"
  },
  {
   "i": 77,
   "start": 220.56,
   "end": 223.76,
   "en": "",
   "zh": "你有什么法力问唐僧"
  },
  {
   "i": 78,
   "start": 224.28,
   "end": 225.98,
   "en": "",
   "zh": "我可以变成其他动物"
  },
  {
   "i": 79,
   "start": 225.98,
   "end": 229.02,
   "en": "",
   "zh": "悟空说看这个"
  },
  {
   "i": 80,
   "start": 230.479,
   "end": 233.099,
   "en": "",
   "zh": "他很快就变成了一只老虎"
  },
  {
   "i": 81,
   "start": 233.099,
   "end": 234.84,
   "en": "",
   "zh": "唐僧一饮而尽"
  },
  {
   "i": 82,
   "start": 235.239,
   "end": 237.639,
   "en": "",
   "zh": "悟空变成了蛇"
  },
  {
   "i": 83,
   "start": 237.639,
   "end": 238.559,
   "en": "",
   "zh": "秃鹫"
  },
  {
   "i": 84,
   "start": 238.559,
   "end": 240.56,
   "en": "",
   "zh": "然后回到自己身上"
  },
  {
   "i": 85,
   "start": 240.78,
   "end": 242.12,
   "en": "",
   "zh": "这还不是全部"
  },
  {
   "i": 86,
   "start": 242.12,
   "end": 242.94,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 87,
   "start": 242.94,
   "end": 244.94,
   "en": "",
   "zh": "我可以变大"
  },
  {
   "i": 88,
   "start": 247.24,
   "end": 252.0,
   "en": "",
   "zh": "猴子的身体长得太大了，他的头伸到了云里"
  },
  {
   "i": 89,
   "start": 252.6,
   "end": 254.46,
   "en": "",
   "zh": "我可以变得渺小"
  },
  {
   "i": 90,
   "start": 254.46,
   "end": 255.9,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 91,
   "start": 255.9,
   "end": 258.14,
   "en": "",
   "zh": "他缩小到蜜蜂的大小"
  },
  {
   "i": 92,
   "start": 258.14,
   "end": 260.2,
   "en": "",
   "zh": "跳到和尚的头上"
  },
  {
   "i": 93,
   "start": 260.798,
   "end": 261.819,
   "en": "",
   "zh": "我可以做得更多"
  },
  {
   "i": 94,
   "start": 261.819,
   "end": 262.599,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 95,
   "start": 264.399,
   "end": 266.94,
   "en": "",
   "zh": "他又变回了正常的体型"
  },
  {
   "i": 96,
   "start": 267.48,
   "end": 270.74,
   "en": "",
   "zh": "他的铁棍从他的耳朵里出现了"
  },
  {
   "i": 97,
   "start": 272.5,
   "end": 274.16,
   "en": "",
   "zh": "猴子把它转了一圈"
  },
  {
   "i": 98,
   "start": 274.16,
   "end": 276.5,
   "en": "",
   "zh": "然后撞上了一块巨大的巨石"
  },
  {
   "i": 99,
   "start": 277.42,
   "end": 278.44,
   "en": "",
   "zh": "粉碎"
  },
  {
   "i": 100,
   "start": 278.44,
   "end": 281.78,
   "en": "",
   "zh": "巨石炸成了小块"
  },
  {
   "i": 101,
   "start": 283.02,
   "end": 285.46,
   "en": "",
   "zh": "唐僧惊恐地看着"
  },
  {
   "i": 102,
   "start": 286.239,
   "end": 287.239,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 103,
   "start": 288.639,
   "end": 290.319,
   "en": "",
   "zh": "别那么害怕，师父"
  },
  {
   "i": 104,
   "start": 290.319,
   "end": 291.98,
   "en": "",
   "zh": "我在保护你"
  },
  {
   "i": 105,
   "start": 293.46,
   "end": 298.26,
   "en": "",
   "zh": "两人走得更远，直到他们看到一群人挡住了路"
  },
  {
   "i": 106,
   "start": 298.8,
   "end": 302.96,
   "en": "",
   "zh": "这些人看起来很粗鲁，意思是他们都有武器"
  },
  {
   "i": 107,
   "start": 303.74,
   "end": 307.06,
   "en": "",
   "zh": "一个人走上前去挥舞着一把剑"
  },
  {
   "i": 108,
   "start": 307.74,
   "end": 308.86,
   "en": "",
   "zh": "把你的钱给我们"
  },
  {
   "i": 109,
   "start": 308.86,
   "end": 310.16,
   "en": "",
   "zh": "否则你会后悔的"
  }
 ]
}
