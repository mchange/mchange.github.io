 "id": "jtw15",
 "title": "Tea with a Dragon",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 1.02,
   "end": 3.7,
   "en": "",
   "zh": "西游记第十五章"
  },
  {
   "i": 2,
   "start": 3.7,
   "end": 5.62,
   "en": "",
   "zh": "龙茶"
  },
  {
   "i": 3,
   "start": 13.26,
   "end": 16.04,
   "en": "",
   "zh": "唐僧看着强盗"
  },
  {
   "i": 4,
   "start": 16.04,
   "end": 17.74,
   "en": "",
   "zh": "他在发抖"
  },
  {
   "i": 5,
   "start": 18.26,
   "end": 19.58,
   "en": "",
   "zh": "对不起"
  },
  {
   "i": 6,
   "start": 19.58,
   "end": 21.0,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 7,
   "start": 21.16,
   "end": 23.28,
   "en": "",
   "zh": "但我们只是和尚"
  },
  {
   "i": 8,
   "start": 23.28,
   "end": 24.48,
   "en": "",
   "zh": "我们没有钱"
  },
  {
   "i": 9,
   "start": 25.48,
   "end": 26.04,
   "en": "",
   "zh": "他们给我们"
  },
  {
   "i": 10,
   "start": 26.04,
   "end": 26.64,
   "en": "",
   "zh": "其他的"
  },
  {
   "i": 11,
   "start": 26.64,
   "end": 27.28,
   "en": "",
   "zh": "你有"
  },
  {
   "i": 12,
   "start": 27.28,
   "end": 28.88,
   "en": "",
   "zh": "一个强盗说"
  },
  {
   "i": 13,
   "start": 28.939,
   "end": 30.74,
   "en": "",
   "zh": "他走得更近了"
  },
  {
   "i": 14,
   "start": 31.28,
   "end": 31.76,
   "en": "",
   "zh": "拜托了"
  },
  {
   "i": 15,
   "start": 31.76,
   "end": 32.24,
   "en": "",
   "zh": "先生"
  },
  {
   "i": 16,
   "start": 32.24,
   "end": 33.3,
   "en": "",
   "zh": "和尚说"
  },
  {
   "i": 17,
   "start": 33.3,
   "end": 36.18,
   "en": "",
   "zh": "我们悟空举起手来"
  },
  {
   "i": 18,
   "start": 36.18,
   "end": 37.8,
   "en": "",
   "zh": "我来对付这些强盗"
  },
  {
   "i": 19,
   "start": 37.8,
   "end": 41.019,
   "en": "",
   "zh": "悟空上前"
  },
  {
   "i": 20,
   "start": 41.22,
   "end": 42.26,
   "en": "",
   "zh": "他们都笑了"
  },
  {
   "i": 21,
   "start": 45.98,
   "end": 47.6,
   "en": "",
   "zh": "看看这只小猴子"
  },
  {
   "i": 22,
   "start": 47.6,
   "end": 50.64,
   "en": "",
   "zh": "其中一个悟空笑着说"
  },
  {
   "i": 23,
   "start": 50.64,
   "end": 50.96,
   "en": "",
   "zh": "我也是"
  },
  {
   "i": 24,
   "start": 52.32,
   "end": 52.62,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 25,
   "start": 52.62,
   "end": 53.96,
   "en": "",
   "zh": "我是一只猴子"
  },
  {
   "i": 26,
   "start": 53.96,
   "end": 55.76,
   "en": "",
   "zh": "我很小"
  },
  {
   "i": 27,
   "start": 55.76,
   "end": 60.24,
   "en": "",
   "zh": "他真的把铁棍从耳朵上取下来了"
  },
  {
   "i": 28,
   "start": 60.24,
   "end": 62.959,
   "en": "",
   "zh": "但你应该怕我"
  },
  {
   "i": 29,
   "start": 63.12,
   "end": 64.86,
   "en": "",
   "zh": "他的铁棍长出来了"
  },
  {
   "i": 30,
   "start": 64.86,
   "end": 68.12,
   "en": "",
   "zh": "他气得眼睛通红"
  },
  {
   "i": 31,
   "start": 70.12,
   "end": 71.68,
   "en": "",
   "zh": "猴子是一种精灵"
  },
  {
   "i": 32,
   "start": 71.68,
   "end": 75.899,
   "en": "",
   "zh": "一个人喊道，另一个人喊道"
  },
  {
   "i": 33,
   "start": 76.34,
   "end": 78.18,
   "en": "",
   "zh": "强盗们互相绊倒"
  },
  {
   "i": 34,
   "start": 78.18,
   "end": 79.899,
   "en": "",
   "zh": "想逃走"
  },
  {
   "i": 35,
   "start": 80.6,
   "end": 82.7,
   "en": "",
   "zh": "悟空举起铁棍"
  },
  {
   "i": 36,
   "start": 82.7,
   "end": 85.18,
   "en": "",
   "zh": "准备罢工停止"
  },
  {
   "i": 37,
   "start": 85.18,
   "end": 86.08,
   "en": "",
   "zh": "悟空哭了"
  },
  {
   "i": 38,
   "start": 86.08,
   "end": 88.179,
   "en": "",
   "zh": "唐僧不会伤害他们"
  },
  {
   "i": 39,
   "start": 88.48,
   "end": 91.44,
   "en": "",
   "zh": "当男人们逃跑时，悟空转过身来"
  },
  {
   "i": 40,
   "start": 91.92,
   "end": 92.7,
   "en": "",
   "zh": "为什么不呢？"
  },
  {
   "i": 41,
   "start": 92.7,
   "end": 93.66,
   "en": "",
   "zh": "他问"
  },
  {
   "i": 42,
   "start": 93.66,
   "end": 95.64,
   "en": "",
   "zh": "他们要伤害我们"
  },
  {
   "i": 43,
   "start": 96.1,
   "end": 97.76,
   "en": "",
   "zh": "和尚从不伤人"
  },
  {
   "i": 44,
   "start": 97.76,
   "end": 102.66,
   "en": "",
   "zh": "人们说和尚我宁愿受伤也不愿伤害别人"
  },
  {
   "i": 45,
   "start": 104.12,
   "end": 105.16,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 46,
   "start": 106.28,
   "end": 107.0,
   "en": "",
   "zh": "太荒谬了"
  },
  {
   "i": 47,
   "start": 108.24,
   "end": 109.66,
   "en": "",
   "zh": "我们应该痛打他们一顿"
  },
  {
   "i": 48,
   "start": 109.66,
   "end": 112.06,
   "en": "",
   "zh": "唐僧摇了摇头"
  },
  {
   "i": 49,
   "start": 112.62,
   "end": 114.0,
   "en": "",
   "zh": "你是一个残忍暴力的"
  },
  {
   "i": 50,
   "start": 114.0,
   "end": 114.9,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 51,
   "start": 114.9,
   "end": 116.72,
   "en": "",
   "zh": "香港人很生气"
  },
  {
   "i": 52,
   "start": 116.72,
   "end": 118.26,
   "en": "",
   "zh": "我刚救了你的命"
  },
  {
   "i": 53,
   "start": 118.26,
   "end": 119.259,
   "en": "",
   "zh": "他哭了"
  },
  {
   "i": 54,
   "start": 120.1,
   "end": 121.34,
   "en": "",
   "zh": "你敢骂我"
  },
  {
   "i": 55,
   "start": 122.42,
   "end": 123.619,
   "en": "",
   "zh": "他停顿了一下"
  },
  {
   "i": 56,
   "start": 124.24,
   "end": 126.3,
   "en": "",
   "zh": "我不必接受这种待遇"
  },
  {
   "i": 57,
   "start": 126.3,
   "end": 127.7,
   "en": "",
   "zh": "我要走了"
  },
  {
   "i": 58,
   "start": 128.36,
   "end": 131.64,
   "en": "",
   "zh": "悟空腾空而起不见了"
  },
  {
   "i": 59,
   "start": 135.659,
   "end": 137.519,
   "en": "",
   "zh": "唐僧叹了口气"
  },
  {
   "i": 60,
   "start": 137.519,
   "end": 139.94,
   "en": "",
   "zh": "然后继续他的旅程"
  },
  {
   "i": 61,
   "start": 142.14,
   "end": 145.02,
   "en": "",
   "zh": "那天晚些时候，他看到一个老妇人"
  },
  {
   "i": 62,
   "start": 145.94,
   "end": 147.76,
   "en": "",
   "zh": "和尚说女人"
  },
  {
   "i": 63,
   "start": 147.76,
   "end": 149.44,
   "en": "",
   "zh": "你去哪儿？"
  },
  {
   "i": 64,
   "start": 150.039,
   "end": 151.899,
   "en": "",
   "zh": "我要去西方天堂"
  },
  {
   "i": 65,
   "start": 151.899,
   "end": 153.32,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 66,
   "start": 154.139,
   "end": 156.219,
   "en": "",
   "zh": "你身边没有人吗？"
  },
  {
   "i": 67,
   "start": 156.219,
   "end": 156.939,
   "en": "",
   "zh": "女人问"
  },
  {
   "i": 68,
   "start": 158.059,
   "end": 160.0,
   "en": "",
   "zh": "你不能一个人去"
  },
  {
   "i": 69,
   "start": 160.459,
   "end": 161.839,
   "en": "",
   "zh": "我确实有个同伴"
  },
  {
   "i": 70,
   "start": 161.839,
   "end": 163.38,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 71,
   "start": 163.619,
   "end": 164.539,
   "en": "",
   "zh": "但是他生气了"
  },
  {
   "i": 72,
   "start": 164.539,
   "end": 166.319,
   "en": "",
   "zh": "当我骂他暴力的时候"
  },
  {
   "i": 73,
   "start": 166.319,
   "end": 167.48,
   "en": "",
   "zh": "他离开了"
  },
  {
   "i": 74,
   "start": 168.239,
   "end": 170.639,
   "en": "",
   "zh": "你的同伴会回来的"
  },
  {
   "i": 75,
   "start": 170.639,
   "end": 171.92,
   "en": "",
   "zh": "女人问"
  },
  {
   "i": 76,
   "start": 176.799,
   "end": 180.359,
   "en": "",
   "zh": "当他骗他穿上这个"
  },
  {
   "i": 77,
   "start": 181.479,
   "end": 184.8,
   "en": "",
   "zh": "她从包里拿出一条金属发带"
  },
  {
   "i": 78,
   "start": 185.199,
   "end": 187.019,
   "en": "",
   "zh": "每当他行为不端"
  },
  {
   "i": 79,
   "start": 187.019,
   "end": 189.86,
   "en": "",
   "zh": "背诵紧头带咒语"
  },
  {
   "i": 80,
   "start": 191.159,
   "end": 195.34,
   "en": "",
   "zh": "老妇人对唐僧低声念了一个魔咒"
  },
  {
   "i": 81,
   "start": 196.68,
   "end": 197.46,
   "en": "",
   "zh": "谢谢。"
  },
  {
   "i": 82,
   "start": 197.46,
   "end": 198.56,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 83,
   "start": 199.64,
   "end": 200.78,
   "en": "",
   "zh": "但你是怎么"
  },
  {
   "i": 84,
   "start": 202.579,
   "end": 204.779,
   "en": "",
   "zh": "有一道明亮的闪光"
  },
  {
   "i": 85,
   "start": 204.779,
   "end": 207.779,
   "en": "",
   "zh": "女人升到空中"
  },
  {
   "i": 86,
   "start": 208.799,
   "end": 210.299,
   "en": "",
   "zh": "鲍里斯在观音"
  },
  {
   "i": 87,
   "start": 210.299,
   "end": 211.899,
   "en": "",
   "zh": "唐僧叫道"
  },
  {
   "i": 88,
   "start": 211.899,
   "end": 214.7,
   "en": "",
   "zh": "他从马上下来发誓"
  },
  {
   "i": 89,
   "start": 216.9,
   "end": 221.94,
   "en": "",
   "zh": "与此同时，悟空坐在东海龙王的宫殿里"
  },
  {
   "i": 90,
   "start": 222.22,
   "end": 225.28,
   "en": "",
   "zh": "他和龙王在喝茶"
  },
  {
   "i": 91,
   "start": 226.38,
   "end": 228.52,
   "en": "",
   "zh": "我希望你从惩罚中吸取了教训"
  },
  {
   "i": 92,
   "start": 228.52,
   "end": 230.18,
   "en": "",
   "zh": "龙王说"
  },
  {
   "i": 93,
   "start": 231.079,
   "end": 231.579,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 94,
   "start": 231.579,
   "end": 233.199,
   "en": "",
   "zh": "我说过悟空"
  },
  {
   "i": 95,
   "start": 234.279,
   "end": 237.18,
   "en": "",
   "zh": "我不会再给玉帝添麻烦了"
  },
  {
   "i": 96,
   "start": 237.539,
   "end": 239.619,
   "en": "",
   "zh": "龙王抿了一口牙"
  },
  {
   "i": 97,
   "start": 240.859,
   "end": 242.42,
   "en": "",
   "zh": "你现在要做什么"
  },
  {
   "i": 98,
   "start": 243.12,
   "end": 246.6,
   "en": "",
   "zh": "我和一个和尚西行，从佛陀那里取经"
  },
  {
   "i": 99,
   "start": 246.6,
   "end": 247.7,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 100,
   "start": 248.06,
   "end": 249.3,
   "en": "",
   "zh": "我答应了观音"
  },
  {
   "i": 101,
   "start": 249.3,
   "end": 250.24,
   "en": "",
   "zh": "我会这么做的"
  },
  {
   "i": 102,
   "start": 250.24,
   "end": 252.48,
   "en": "",
   "zh": "龙王笑了"
  },
  {
   "i": 103,
   "start": 252.48,
   "end": 254.22,
   "en": "",
   "zh": "那太好了"
  },
  {
   "i": 104,
   "start": 254.58,
   "end": 256.18,
   "en": "",
   "zh": "悟空耸了耸肩"
  },
  {
   "i": 105,
   "start": 256.18,
   "end": 256.76,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 106,
   "start": 256.76,
   "end": 257.1,
   "en": "",
   "zh": "嗯"
  },
  {
   "i": 107,
   "start": 257.1,
   "end": 258.76,
   "en": "",
   "zh": "我不再做了"
  },
  {
   "i": 108,
   "start": 259.22,
   "end": 261.899,
   "en": "",
   "zh": "龙王放下茶杯"
  },
  {
   "i": 109,
   "start": 261.899,
   "end": 265.88,
   "en": "",
   "zh": "为什么那个和尚态度不好"
  },
  {
   "i": 110,
   "start": 265.88,
   "end": 266.78,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 111,
   "start": 268.58,
   "end": 270.12,
   "en": "",
   "zh": "他对我大喊大叫"
  },
  {
   "i": 112,
   "start": 271.52,
   "end": 273.68,
   "en": "",
   "zh": "他说我很残忍很暴力"
  },
  {
   "i": 113,
   "start": 276.86,
   "end": 279.26,
   "en": "",
   "zh": "龙王紧张地咳嗽着"
  },
  {
   "i": 114,
   "start": 281.58,
   "end": 284.58,
   "en": "",
   "zh": "和尚悟空说得有道理"
  },
  {
   "i": 115,
   "start": 285.12,
   "end": 286.84,
   "en": "",
   "zh": "悟空瞪着国王"
  },
  {
   "i": 116,
   "start": 288.0,
   "end": 289.12,
   "en": "",
   "zh": "你什么意思"
  },
  {
   "i": 117,
   "start": 289.7,
   "end": 291.04,
   "en": "",
   "zh": "国王犹豫了"
  },
  {
   "i": 118,
   "start": 291.04,
   "end": 293.42,
   "en": "",
   "zh": "然后说你很暴力"
  },
  {
   "i": 119,
   "start": 293.42,
   "end": 298.099,
   "en": "",
   "zh": "有时悟空抱着双臂看着地面"
  },
  {
   "i": 120,
   "start": 298.099,
   "end": 302.239,
   "en": "",
   "zh": "龙王不仅继续说"
  },
  {
   "i": 121,
   "start": 302.239,
   "end": 304.56,
   "en": "",
   "zh": "但你答应过观音"
  },
  {
   "i": 122,
   "start": 305.5,
   "end": 306.68,
   "en": "",
   "zh": "可能是悟空"
  },
  {
   "i": 123,
   "start": 306.68,
   "end": 309.26,
   "en": "",
   "zh": "是你态度不好"
  }
 ]
}
