{
 "id": "jtw17",
 "title": "The Dragon",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.18,
   "end": 2.34,
   "en": "",
   "zh": "向西第十七章"
  },
  {
   "i": 2,
   "start": 2.34,
   "end": 4.76,
   "en": "",
   "zh": "河里的龙"
  },
  {
   "i": 3,
   "start": 13.379,
   "end": 15.079,
   "en": "",
   "zh": "那条龙吃了我的马"
  },
  {
   "i": 4,
   "start": 15.079,
   "end": 16.239,
   "en": "",
   "zh": "和尚说"
  },
  {
   "i": 5,
   "start": 16.239,
   "end": 18.24,
   "en": "",
   "zh": "他双膝跪地"
  },
  {
   "i": 6,
   "start": 18.6,
   "end": 21.32,
   "en": "",
   "zh": "我怎样才能到达西方天堂"
  },
  {
   "i": 7,
   "start": 21.32,
   "end": 24.04,
   "en": "",
   "zh": "一路上有很多危险"
  },
  {
   "i": 8,
   "start": 24.279,
   "end": 25.74,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 9,
   "start": 26.82,
   "end": 27.36,
   "en": "",
   "zh": "师傅"
  },
  {
   "i": 10,
   "start": 27.36,
   "end": 28.74,
   "en": "",
   "zh": "你担心得太多了"
  },
  {
   "i": 11,
   "start": 28.74,
   "end": 31.62,
   "en": "",
   "zh": "旅途中会遇到很多危险"
  },
  {
   "i": 12,
   "start": 32.46,
   "end": 33.54,
   "en": "",
   "zh": "但你有我"
  },
  {
   "i": 13,
   "start": 33.54,
   "end": 35.62,
   "en": "",
   "zh": "孙悟空来保护你"
  },
  {
   "i": 14,
   "start": 36.34,
   "end": 38.58,
   "en": "",
   "zh": "天兵天将都打不过我"
  },
  {
   "i": 15,
   "start": 38.58,
   "end": 40.779,
   "en": "",
   "zh": "为什么要担心龙呢"
  },
  {
   "i": 16,
   "start": 47.26,
   "end": 51.379,
   "en": "",
   "zh": "猴子踏进水里，拔出铁棍"
  },
  {
   "i": 17,
   "start": 52.98,
   "end": 55.279,
   "en": "",
   "zh": "我要让龙从水里出来"
  },
  {
   "i": 18,
   "start": 55.9,
   "end": 57.72,
   "en": "",
   "zh": "他低头看着水"
  },
  {
   "i": 19,
   "start": 57.72,
   "end": 61.459,
   "en": "",
   "zh": "龙龙马上上来"
  },
  {
   "i": 20,
   "start": 63.0,
   "end": 64.72,
   "en": "",
   "zh": "巨龙跃出水面"
  },
  {
   "i": 21,
   "start": 66.4,
   "end": 68.72,
   "en": "",
   "zh": "你竟敢对我大喊大叫"
  },
  {
   "i": 22,
   "start": 72.46,
   "end": 75.76,
   "en": "",
   "zh": "悟空喊道：我是谁并不重要"
  },
  {
   "i": 23,
   "start": 75.76,
   "end": 77.539,
   "en": "",
   "zh": "把马还给我"
  },
  {
   "i": 24,
   "start": 78.64,
   "end": 81.7,
   "en": "",
   "zh": "猴子用铁棍袭击了龙"
  },
  {
   "i": 25,
   "start": 84.52,
   "end": 86.02,
   "en": "",
   "zh": "巨龙旋转着"
  },
  {
   "i": 26,
   "start": 86.02,
   "end": 87.98,
   "en": "",
   "zh": "用尾巴挡住了吧台"
  },
  {
   "i": 27,
   "start": 87.98,
   "end": 91.56,
   "en": "",
   "zh": "然后随着水花，他潜回水下"
  },
  {
   "i": 28,
   "start": 91.86,
   "end": 93.48,
   "en": "",
   "zh": "悟空绊倒了他的脚"
  },
  {
   "i": 29,
   "start": 93.48,
   "end": 96.28,
   "en": "",
   "zh": "对着河里的懦夫大喊大叫"
  },
  {
   "i": 30,
   "start": 99.0,
   "end": 100.08,
   "en": "",
   "zh": "我们该怎么办"
  },
  {
   "i": 31,
   "start": 100.08,
   "end": 101.56,
   "en": "",
   "zh": "唐僧问道"
  },
  {
   "i": 32,
   "start": 101.56,
   "end": 103.259,
   "en": "",
   "zh": "我没有马"
  },
  {
   "i": 33,
   "start": 104.6,
   "end": 106.08,
   "en": "",
   "zh": "悟空点点头"
  },
  {
   "i": 34,
   "start": 106.08,
   "end": 109.32,
   "en": "",
   "zh": "那条龙在里面，我们不能过河"
  },
  {
   "i": 35,
   "start": 109.56,
   "end": 110.84,
   "en": "",
   "zh": "我将尝试另一个计划"
  },
  {
   "i": 36,
   "start": 112.96,
   "end": 115.8,
   "en": "",
   "zh": "猴子用他的铁棍打转水"
  },
  {
   "i": 37,
   "start": 116.26,
   "end": 118.06,
   "en": "",
   "zh": "水变得粗糙"
  },
  {
   "i": 38,
   "start": 118.06,
   "end": 121.08,
   "en": "",
   "zh": "海浪拍打着翻腾着"
  },
  {
   "i": 39,
   "start": 121.3,
   "end": 124.02,
   "en": "",
   "zh": "水把河底的污物拖了上来。"
  },
  {
   "i": 40,
   "start": 125.06,
   "end": 127.56,
   "en": "",
   "zh": "不久，河水变成了棕色和泥泞"
  },
  {
   "i": 41,
   "start": 128.5,
   "end": 130.419,
   "en": "",
   "zh": "龙又出现了"
  },
  {
   "i": 42,
   "start": 131.739,
   "end": 133.479,
   "en": "",
   "zh": "1.你到底在搞什么"
  },
  {
   "i": 43,
   "start": 133.479,
   "end": 134.059,
   "en": "",
   "zh": "现在"
  },
  {
   "i": 44,
   "start": 134.059,
   "end": 135.18,
   "en": "",
   "zh": "他哭了"
  },
  {
   "i": 45,
   "start": 135.8,
   "end": 137.92,
   "en": "",
   "zh": "我想小睡一会儿"
  },
  {
   "i": 46,
   "start": 139.16,
   "end": 139.72,
   "en": "",
   "zh": "把我们还给我们"
  },
  {
   "i": 47,
   "start": 139.72,
   "end": 142.02,
   "en": "",
   "zh": "我们的马要了悟空"
  },
  {
   "i": 48,
   "start": 142.659,
   "end": 143.799,
   "en": "",
   "zh": "我不能"
  },
  {
   "i": 49,
   "start": 143.799,
   "end": 145.199,
   "en": "",
   "zh": "巨龙叫道"
  },
  {
   "i": 50,
   "start": 145.199,
   "end": 147.9,
   "en": "",
   "zh": "它在我的胃里"
  },
  {
   "i": 51,
   "start": 149.0,
   "end": 151.48,
   "en": "",
   "zh": "猴子再次袭击了龙"
  },
  {
   "i": 52,
   "start": 153.54,
   "end": 157.16,
   "en": "",
   "zh": "但是龙又一次消失在水下"
  },
  {
   "i": 53,
   "start": 158.879,
   "end": 160.559,
   "en": "",
   "zh": "三个多小时"
  },
  {
   "i": 54,
   "start": 160.559,
   "end": 162.759,
   "en": "",
   "zh": "悟空对江大喊"
  },
  {
   "i": 55,
   "start": 162.759,
   "end": 165.299,
   "en": "",
   "zh": "他大声辱骂"
  },
  {
   "i": 56,
   "start": 165.299,
   "end": 168.22,
   "en": "",
   "zh": "但龙不会回来"
  },
  {
   "i": 57,
   "start": 169.5,
   "end": 172.4,
   "en": "",
   "zh": "悟空爬上了河岸"
  },
  {
   "i": 58,
   "start": 174.28,
   "end": 176.72,
   "en": "",
   "zh": "坐在唐僧旁边"
  },
  {
   "i": 59,
   "start": 178.16,
   "end": 179.56,
   "en": "",
   "zh": "那条龙很坚强"
  },
  {
   "i": 60,
   "start": 180.159,
   "end": 181.439,
   "en": "",
   "zh": "我不怕他"
  },
  {
   "i": 61,
   "start": 181.439,
   "end": 182.899,
   "en": "",
   "zh": "但我也打不过他"
  },
  {
   "i": 62,
   "start": 182.899,
   "end": 186.36,
   "en": "",
   "zh": "我需要能帮助你的人"
  },
  {
   "i": 63,
   "start": 186.36,
   "end": 187.98,
   "en": "",
   "zh": "唐僧问道"
  },
  {
   "i": 64,
   "start": 187.98,
   "end": 190.4,
   "en": "",
   "zh": "悟空想了一下"
  },
  {
   "i": 65,
   "start": 190.96,
   "end": 192.04,
   "en": "",
   "zh": "观音告诉我"
  },
  {
   "i": 66,
   "start": 192.04,
   "end": 192.96,
   "en": "",
   "zh": "我可以找她帮忙"
  },
  {
   "i": 67,
   "start": 192.96,
   "end": 193.92,
   "en": "",
   "zh": "如果我需要"
  },
  {
   "i": 68,
   "start": 194.76,
   "end": 195.44,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 69,
   "start": 195.44,
   "end": 196.96,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 70,
   "start": 196.96,
   "end": 198.84,
   "en": "",
   "zh": "她告诉我同样的事情"
  },
  {
   "i": 71,
   "start": 199.24,
   "end": 202.8,
   "en": "",
   "zh": "悟空摸了摸头带，看了和尚一眼"
  },
  {
   "i": 72,
   "start": 202.8,
   "end": 204.72,
   "en": "",
   "zh": "她已经帮你了"
  },
  {
   "i": 73,
   "start": 204.72,
   "end": 206.82,
   "en": "",
   "zh": "她给了你这么紧的头带"
  },
  {
   "i": 74,
   "start": 208.12,
   "end": 208.96,
   "en": "",
   "zh": "他叹了口气"
  },
  {
   "i": 75,
   "start": 210.12,
   "end": 212.26,
   "en": "",
   "zh": "但现在不重要了"
  },
  {
   "i": 76,
   "start": 213.26,
   "end": 214.1,
   "en": "",
   "zh": "你在这儿等着"
  },
  {
   "i": 77,
   "start": 214.1,
   "end": 214.86,
   "en": "",
   "zh": "我很快就回来"
  },
  {
   "i": 78,
   "start": 215.9,
   "end": 218.66,
   "en": "",
   "zh": "悟空腾空而起南飞"
  },
  {
   "i": 79,
   "start": 221.88,
   "end": 225.46,
   "en": "",
   "zh": "不久，他来到了南海的布达拉山"
  },
  {
   "i": 80,
   "start": 225.679,
   "end": 229.08,
   "en": "",
   "zh": "观音在她宝塔旁边的花园里"
  },
  {
   "i": 81,
   "start": 230.04,
   "end": 231.4,
   "en": "",
   "zh": "你好悟空"
  },
  {
   "i": 82,
   "start": 231.4,
   "end": 232.42,
   "en": "",
   "zh": "她说"
  },
  {
   "i": 83,
   "start": 232.42,
   "end": 234.58,
   "en": "",
   "zh": "旅途如何？"
  },
  {
   "i": 84,
   "start": 234.919,
   "end": 237.24,
   "en": "",
   "zh": "我看到你戴着头带"
  },
  {
   "i": 85,
   "start": 238.419,
   "end": 238.879,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 86,
   "start": 238.879,
   "end": 240.619,
   "en": "",
   "zh": "多亏了你的肮脏伎俩"
  },
  {
   "i": 87,
   "start": 240.619,
   "end": 243.94,
   "en": "",
   "zh": "猴子观音笑着说"
  },
  {
   "i": 88,
   "start": 243.94,
   "end": 245.8,
   "en": "",
   "zh": "你需要那个头带"
  },
  {
   "i": 89,
   "start": 245.8,
   "end": 246.66,
   "en": "",
   "zh": "悟空"
  },
  {
   "i": 90,
   "start": 247.239,
   "end": 249.76,
   "en": "",
   "zh": "你太暴力太残忍了"
  },
  {
   "i": 91,
   "start": 250.44,
   "end": 254.16,
   "en": "",
   "zh": "悟空翻了个白眼"
  },
  {
   "i": 92,
   "start": 254.16,
   "end": 255.08,
   "en": "",
   "zh": "我在这里"
  },
  {
   "i": 93,
   "start": 255.08,
   "end": 256.5,
   "en": "",
   "zh": "因为我有个问题"
  },
  {
   "i": 94,
   "start": 256.7,
   "end": 259.26,
   "en": "",
   "zh": "我们到了一条宽阔的河里，河里有一条龙"
  },
  {
   "i": 95,
   "start": 259.26,
   "end": 261.1,
   "en": "",
   "zh": "龙吃了我们的马"
  },
  {
   "i": 96,
   "start": 262.48,
   "end": 266.32,
   "en": "",
   "zh": "你告诉龙你和唐僧一起旅行了吗"
  },
  {
   "i": 97,
   "start": 266.32,
   "end": 267.76,
   "en": "",
   "zh": "观音问"
  },
  {
   "i": 98,
   "start": 268.0,
   "end": 268.76,
   "en": "",
   "zh": "否"
  },
  {
   "i": 99,
   "start": 268.76,
   "end": 270.0,
   "en": "",
   "zh": "猴子说"
  },
  {
   "i": 100,
   "start": 270.0,
   "end": 273.26,
   "en": "",
   "zh": "为什么观音感叹"
  },
  {
   "i": 101,
   "start": 274.719,
   "end": 277.52,
   "en": "",
   "zh": "那条龙在等你"
  },
  {
   "i": 102,
   "start": 278.12,
   "end": 279.3,
   "en": "",
   "zh": "当我见到他的时候"
  },
  {
   "i": 103,
   "start": 279.3,
   "end": 283.12,
   "en": "",
   "zh": "他因放火烧了他父亲的宫殿而受到惩罚"
  },
  {
   "i": 104,
   "start": 283.88,
   "end": 289.32,
   "en": "",
   "zh": "我叫他这样帮唐僧去西天"
  },
  {
   "i": 105,
   "start": 289.32,
   "end": 291.4,
   "en": "",
   "zh": "他可以赢得宽恕"
  },
  {
   "i": 106,
   "start": 292.26,
   "end": 294.1,
   "en": "",
   "zh": "悟空挠了挠头"
  },
  {
   "i": 107,
   "start": 295.1,
   "end": 296.04,
   "en": "",
   "zh": "太迟了"
  },
  {
   "i": 108,
   "start": 296.04,
   "end": 298.12,
   "en": "",
   "zh": "现在他不会从水里出来了"
  }
 ]
}
