{
 "id": "jtw18",
 "title": "The Robe",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.24,
   "end": 1.66,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 1.66,
   "end": 3.28,
   "en": "",
   "zh": "第十八章"
  },
  {
   "i": 3,
   "start": 3.28,
   "end": 4.439,
   "en": "",
   "zh": "长袍"
  },
  {
   "i": 4,
   "start": 12.48,
   "end": 17.46,
   "en": "",
   "zh": "悟空和观音飞越大洋，回到宽阔的江面"
  },
  {
   "i": 5,
   "start": 18.68,
   "end": 19.7,
   "en": "",
   "zh": "从天空"
  },
  {
   "i": 6,
   "start": 19.7,
   "end": 24.74,
   "en": "",
   "zh": "观音叫龙立刻从河中出来"
  },
  {
   "i": 7,
   "start": 25.04,
   "end": 27.06,
   "en": "",
   "zh": "唐僧来了"
  },
  {
   "i": 8,
   "start": 30.42,
   "end": 33.5,
   "en": "",
   "zh": "龙从河里升起，鞠了一躬"
  },
  {
   "i": 9,
   "start": 35.12,
   "end": 36.46,
   "en": "",
   "zh": "鲍里斯·哈夫瓦"
  },
  {
   "i": 10,
   "start": 36.46,
   "end": 37.38,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 11,
   "start": 37.38,
   "end": 38.54,
   "en": "",
   "zh": "对不起"
  },
  {
   "i": 12,
   "start": 38.54,
   "end": 41.44,
   "en": "",
   "zh": "我不知道和尚已经来了"
  },
  {
   "i": 13,
   "start": 42.08,
   "end": 44.06,
   "en": "",
   "zh": "我想休息一下"
  },
  {
   "i": 14,
   "start": 44.06,
   "end": 45.76,
   "en": "",
   "zh": "一只讨厌的猴子"
  },
  {
   "i": 15,
   "start": 45.76,
   "end": 46.839,
   "en": "",
   "zh": "谁是"
  },
  {
   "i": 16,
   "start": 47.36,
   "end": 49.0,
   "en": "",
   "zh": "龙不再说话了"
  },
  {
   "i": 17,
   "start": 49.0,
   "end": 50.16,
   "en": "",
   "zh": "当他看到悟空"
  },
  {
   "i": 18,
   "start": 50.16,
   "end": 51.16,
   "en": "",
   "zh": "在观音旁边"
  },
  {
   "i": 19,
   "start": 52.4,
   "end": 53.459,
   "en": "",
   "zh": "就是他"
  },
  {
   "i": 20,
   "start": 54.5,
   "end": 56.52,
   "en": "",
   "zh": "我是孙悟空"
  },
  {
   "i": 21,
   "start": 56.52,
   "end": 57.959,
   "en": "",
   "zh": "观音说"
  },
  {
   "i": 22,
   "start": 58.48,
   "end": 61.18,
   "en": "",
   "zh": "他和唐僧一起旅行"
  },
  {
   "i": 23,
   "start": 61.96,
   "end": 63.7,
   "en": "",
   "zh": "猴子没告诉我"
  },
  {
   "i": 24,
   "start": 63.7,
   "end": 65.5,
   "en": "",
   "zh": "据说龙"
  },
  {
   "i": 25,
   "start": 65.5,
   "end": 67.74,
   "en": "",
   "zh": "我甚至问他是谁"
  },
  {
   "i": 26,
   "start": 67.74,
   "end": 69.64,
   "en": "",
   "zh": "他没有回答"
  },
  {
   "i": 27,
   "start": 69.86,
   "end": 72.74,
   "en": "",
   "zh": "我知道观音说"
  },
  {
   "i": 28,
   "start": 73.34,
   "end": 76.9,
   "en": "",
   "zh": "她从现在开始向悟空看了一眼"
  },
  {
   "i": 29,
   "start": 76.9,
   "end": 79.86,
   "en": "",
   "zh": "你必须告诉别人你是谁"
  },
  {
   "i": 30,
   "start": 80.1,
   "end": 82.16,
   "en": "",
   "zh": "还有其他人在等你"
  },
  {
   "i": 31,
   "start": 82.16,
   "end": 83.119,
   "en": "",
   "zh": "我也是"
  },
  {
   "i": 32,
   "start": 87.88,
   "end": 90.48,
   "en": "",
   "zh": "观音回头看着龙"
  },
  {
   "i": 33,
   "start": 90.48,
   "end": 94.88,
   "en": "",
   "zh": "你要带唐僧去西天"
  },
  {
   "i": 34,
   "start": 97.58,
   "end": 100.539,
   "en": "",
   "zh": "闪闪发光的光包围着龙"
  },
  {
   "i": 35,
   "start": 101.76,
   "end": 103.06,
   "en": "",
   "zh": "当光线褪去"
  },
  {
   "i": 36,
   "start": 103.06,
   "end": 105.36,
   "en": "",
   "zh": "一匹马站在龙曾经呆过的地方"
  },
  {
   "i": 37,
   "start": 106.44,
   "end": 109.52,
   "en": "",
   "zh": "它看起来和唐僧的马一模一样"
  },
  {
   "i": 38,
   "start": 111.78,
   "end": 113.38,
   "en": "",
   "zh": "关隐离开后"
  },
  {
   "i": 39,
   "start": 113.38,
   "end": 116.6,
   "en": "",
   "zh": "悟空牵马去见唐僧"
  },
  {
   "i": 40,
   "start": 118.38,
   "end": 119.8,
   "en": "",
   "zh": "你得到了马背"
  },
  {
   "i": 41,
   "start": 119.8,
   "end": 120.66,
   "en": "",
   "zh": "和尚说"
  },
  {
   "i": 42,
   "start": 121.74,
   "end": 125.12,
   "en": "",
   "zh": "没有说悟空观音在这里"
  },
  {
   "i": 43,
   "start": 125.12,
   "end": 126.86,
   "en": "",
   "zh": "她把龙变成了马"
  },
  {
   "i": 44,
   "start": 127.86,
   "end": 129.52,
   "en": "",
   "zh": "他应该和我们一起去"
  },
  {
   "i": 45,
   "start": 132.879,
   "end": 135.9,
   "en": "",
   "zh": "唐僧跪下来鞠了一躬"
  },
  {
   "i": 46,
   "start": 141.52,
   "end": 143.88,
   "en": "",
   "zh": "菩萨回到了布达拉山"
  },
  {
   "i": 47,
   "start": 143.88,
   "end": 146.18,
   "en": "",
   "zh": "到目前为止，你需要搭车吗"
  },
  {
   "i": 48,
   "start": 146.18,
   "end": 147.52,
   "en": "",
   "zh": "一个声音叫道"
  },
  {
   "i": 49,
   "start": 147.96,
   "end": 150.74,
   "en": "",
   "zh": "悟空转船"
  },
  {
   "i": 50,
   "start": 150.74,
   "end": 153.06,
   "en": "",
   "zh": "已经到了岸边"
  },
  {
   "i": 51,
   "start": 153.54,
   "end": 155.32,
   "en": "",
   "zh": "我将带你过河"
  },
  {
   "i": 52,
   "start": 155.32,
   "end": 156.62,
   "en": "",
   "zh": "船夫说"
  },
  {
   "i": 53,
   "start": 159.919,
   "end": 162.239,
   "en": "",
   "zh": "唐僧上了船"
  },
  {
   "i": 54,
   "start": 162.239,
   "end": 164.84,
   "en": "",
   "zh": "悟空牵着马跟在后面"
  },
  {
   "i": 55,
   "start": 171.62,
   "end": 175.46,
   "en": "",
   "zh": "船夫一声不吭地把他们划过了河"
  },
  {
   "i": 56,
   "start": 176.38,
   "end": 177.98,
   "en": "",
   "zh": "在河的另一边"
  },
  {
   "i": 57,
   "start": 177.98,
   "end": 180.88,
   "en": "",
   "zh": "猴子牵着马上了岸"
  },
  {
   "i": 58,
   "start": 185.36,
   "end": 188.38,
   "en": "",
   "zh": "唐僧下了船"
  },
  {
   "i": 59,
   "start": 188.959,
   "end": 190.819,
   "en": "",
   "zh": "当他转身感谢船夫时"
  },
  {
   "i": 60,
   "start": 190.819,
   "end": 192.2,
   "en": "",
   "zh": "船不见了"
  },
  {
   "i": 61,
   "start": 194.039,
   "end": 198.24,
   "en": "",
   "zh": "悟空看到和尚一脸茫然，不禁笑了起来"
  },
  {
   "i": 62,
   "start": 198.78,
   "end": 200.28,
   "en": "",
   "zh": "他是河流的灵魂"
  },
  {
   "i": 63,
   "start": 200.28,
   "end": 201.9,
   "en": "",
   "zh": "猴子解释说"
  },
  {
   "i": 64,
   "start": 204.46,
   "end": 209.66,
   "en": "",
   "zh": "和尚和猴子继续他们的旅行，翻山越岭，穿过平原"
  },
  {
   "i": 65,
   "start": 212.0,
   "end": 214.64,
   "en": "",
   "zh": "要多久才能到达西方的天堂？"
  },
  {
   "i": 66,
   "start": 214.64,
   "end": 218.659,
   "en": "",
   "zh": "一天下午，唐僧问了一个很长的问题"
  },
  {
   "i": 67,
   "start": 218.659,
   "end": 223.68,
   "en": "",
   "zh": "悟空说我们的旅程才刚刚开始"
  },
  {
   "i": 68,
   "start": 225.22,
   "end": 228.8,
   "en": "",
   "zh": "他们又走了一段，直到一座佛教寺院"
  },
  {
   "i": 69,
   "start": 229.16,
   "end": 230.74,
   "en": "",
   "zh": "我们在这里过夜吧"
  },
  {
   "i": 70,
   "start": 230.74,
   "end": 233.68,
   "en": "",
   "zh": "悟空说我们是佛教徒"
  },
  {
   "i": 71,
   "start": 233.68,
   "end": 237.48,
   "en": "",
   "zh": "里面的牧师会很乐意给我们一些食物和睡觉的地方"
  },
  {
   "i": 72,
   "start": 239.779,
   "end": 240.859,
   "en": "",
   "zh": "那天晚上晚些时候"
  },
  {
   "i": 73,
   "start": 240.859,
   "end": 244.139,
   "en": "",
   "zh": "悟空的唐僧和僧侣们一起吃饭"
  },
  {
   "i": 74,
   "start": 245.379,
   "end": 248.3,
   "en": "",
   "zh": "当大祭司听到唐僧要去哪里的时候"
  },
  {
   "i": 75,
   "start": 248.3,
   "end": 249.67,
   "en": "",
   "zh": "他很兴奋"
  },
  {
   "i": 76,
   "start": 250.23,
   "end": 252.99,
   "en": "",
   "zh": "你就会得到真经"
  },
  {
   "i": 77,
   "start": 252.99,
   "end": 254.59,
   "en": "",
   "zh": "牧师说"
  },
  {
   "i": 78,
   "start": 255.15,
   "end": 257.05,
   "en": "",
   "zh": "太荣幸了"
  },
  {
   "i": 79,
   "start": 257.05,
   "end": 259.92,
   "en": "",
   "zh": "菩萨是怎么选择你的"
  },
  {
   "i": 80,
   "start": 260.659,
   "end": 263.159,
   "en": "",
   "zh": "她说只有真正的信徒才能踏上旅程"
  },
  {
   "i": 81,
   "start": 263.159,
   "end": 264.58,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 82,
   "start": 265.18,
   "end": 266.62,
   "en": "",
   "zh": "我试穿了一件长袍"
  },
  {
   "i": 83,
   "start": 266.62,
   "end": 269.16,
   "en": "",
   "zh": "她看到我是一个真正的信徒"
  },
  {
   "i": 84,
   "start": 270.739,
   "end": 273.84,
   "en": "",
   "zh": "“你带了长袍吗？”牧师问"
  },
  {
   "i": 85,
   "start": 274.52,
   "end": 275.18,
   "en": "",
   "zh": "是呀"
  },
  {
   "i": 86,
   "start": 275.18,
   "end": 276.74,
   "en": "",
   "zh": "唐僧说"
  },
  {
   "i": 87,
   "start": 276.74,
   "end": 278.5,
   "en": "",
   "zh": "这是佛教的珍宝"
  },
  {
   "i": 88,
   "start": 280.64,
   "end": 283.78,
   "en": "",
   "zh": "他把手伸进包里，掏出长袍"
  },
  {
   "i": 89,
   "start": 286.48,
   "end": 288.44,
   "en": "",
   "zh": "牧师的眼睛闪闪发光"
  },
  {
   "i": 90,
   "start": 289.64,
   "end": 291.08,
   "en": "",
   "zh": "我可以拿着吗？"
  },
  {
   "i": 91,
   "start": 291.5,
   "end": 294.5,
   "en": "",
   "zh": "唐僧把袍子递给神甫"
  },
  {
   "i": 92,
   "start": 295.179,
   "end": 297.539,
   "en": "",
   "zh": "牧师欣赏了一会儿"
  },
  {
   "i": 93,
   "start": 297.539,
   "end": 300.159,
   "en": "",
   "zh": "我今晚可以借用一下吗？"
  },
  {
   "i": 94,
   "start": 300.159,
   "end": 302.419,
   "en": "",
   "zh": "唐僧犹豫了"
  },
  {
   "i": 95,
   "start": 302.419,
   "end": 304.36,
   "en": "",
   "zh": "我想那没问题"
  },
  {
   "i": 96,
   "start": 306.919,
   "end": 307.959,
   "en": "",
   "zh": "那天深夜"
  },
  {
   "i": 97,
   "start": 307.959,
   "end": 309.399,
   "en": "",
   "zh": "牧师醒了"
  },
  {
   "i": 98,
   "start": 309.399,
   "end": 311.16,
   "en": "",
   "zh": "凝视着长袍"
  },
  {
   "i": 99,
   "start": 312.48,
   "end": 314.32,
   "en": "",
   "zh": "这件袍子我不能退"
  },
  {
   "i": 100,
   "start": 316.76,
   "end": 318.0,
   "en": "",
   "zh": "我必须拥有它"
  }
 ]
}
