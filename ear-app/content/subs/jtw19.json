{
 "id": "jtw19",
 "title": "An Evil Plan",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.58,
   "end": 3.28,
   "en": "",
   "zh": "西游记第十九章"
  },
  {
   "i": 2,
   "start": 3.28,
   "end": 5.16,
   "en": "",
   "zh": "邪恶的计划"
  },
  {
   "i": 3,
   "start": 22.08,
   "end": 24.94,
   "en": "",
   "zh": "祭司长叫了另外两个祭司来"
  },
  {
   "i": 4,
   "start": 24.94,
   "end": 27.22,
   "en": "",
   "zh": "他很快跑进了房间"
  },
  {
   "i": 5,
   "start": 28.899,
   "end": 29.599,
   "en": "",
   "zh": "就是一切"
  },
  {
   "i": 6,
   "start": 29.599,
   "end": 29.939,
   "en": "",
   "zh": "好的"
  },
  {
   "i": 7,
   "start": 29.939,
   "end": 31.96,
   "en": "",
   "zh": "师傅一个牧师问"
  },
  {
   "i": 8,
   "start": 32.9,
   "end": 35.94,
   "en": "",
   "zh": "我不能把这件袍子还给唐僧"
  },
  {
   "i": 9,
   "start": 35.94,
   "end": 37.339,
   "en": "",
   "zh": "祭司长说"
  },
  {
   "i": 10,
   "start": 37.88,
   "end": 39.34,
   "en": "",
   "zh": "但你必须把它还给我"
  },
  {
   "i": 11,
   "start": 39.34,
   "end": 41.0,
   "en": "",
   "zh": "另一个牧师说"
  },
  {
   "i": 12,
   "start": 43.76,
   "end": 45.84,
   "en": "",
   "zh": "这件袍子是佛教的珍宝"
  },
  {
   "i": 13,
   "start": 45.84,
   "end": 47.4,
   "en": "",
   "zh": "祭司长说"
  },
  {
   "i": 14,
   "start": 47.88,
   "end": 50.08,
   "en": "",
   "zh": "它来自西方天堂"
  },
  {
   "i": 15,
   "start": 51.12,
   "end": 51.76,
   "en": "",
   "zh": "作为佛教徒"
  },
  {
   "i": 16,
   "start": 51.76,
   "end": 55.36,
   "en": "",
   "zh": "我们必须尽一切努力把它留在我们的修道院里"
  },
  {
   "i": 17,
   "start": 56.14,
   "end": 57.96,
   "en": "",
   "zh": "唐僧不会让你留着的"
  },
  {
   "i": 18,
   "start": 57.96,
   "end": 58.94,
   "en": "",
   "zh": "第一个牧师说"
  },
  {
   "i": 19,
   "start": 60.18,
   "end": 61.9,
   "en": "",
   "zh": "神父笑了"
  },
  {
   "i": 20,
   "start": 62.62,
   "end": 64.819,
   "en": "",
   "zh": "他的眼睛里有一种邪恶的神情"
  },
  {
   "i": 21,
   "start": 66.14,
   "end": 67.4,
   "en": "",
   "zh": "我有个计划"
  },
  {
   "i": 22,
   "start": 67.4,
   "end": 68.679,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 23,
   "start": 70.58,
   "end": 72.16,
   "en": "",
   "zh": "悟空醒了"
  },
  {
   "i": 24,
   "start": 72.16,
   "end": 73.72,
   "en": "",
   "zh": "在屋顶上冥想"
  },
  {
   "i": 25,
   "start": 73.72,
   "end": 75.42,
   "en": "",
   "zh": "当他听到脚步声"
  },
  {
   "i": 26,
   "start": 75.92,
   "end": 80.38,
   "en": "",
   "zh": "他低头一看，看见两个牧师走过院子"
  },
  {
   "i": 27,
   "start": 80.82,
   "end": 83.74,
   "en": "",
   "zh": "他们扛着一捆捆柴火"
  },
  {
   "i": 28,
   "start": 84.26,
   "end": 86.04,
   "en": "",
   "zh": "现在是半夜"
  },
  {
   "i": 29,
   "start": 86.04,
   "end": 86.98,
   "en": "",
   "zh": "悟空想"
  },
  {
   "i": 30,
   "start": 88.1,
   "end": 89.84,
   "en": "",
   "zh": "他们为什么要放火"
  },
  {
   "i": 31,
   "start": 90.82,
   "end": 93.62,
   "en": "",
   "zh": "牧师们把柴火堆在大楼旁边"
  },
  {
   "i": 32,
   "start": 93.62,
   "end": 95.72,
   "en": "",
   "zh": "唐僧睡懒觉"
  },
  {
   "i": 33,
   "start": 98.96,
   "end": 101.84,
   "en": "",
   "zh": "我敢打赌，祭司长想保留我们的长袍"
  },
  {
   "i": 34,
   "start": 101.84,
   "end": 103.92,
   "en": "",
   "zh": "他打算杀了我们"
  },
  {
   "i": 35,
   "start": 104.38,
   "end": 108.0,
   "en": "",
   "zh": "悟空一直等到牧师把木头点着"
  },
  {
   "i": 36,
   "start": 110.1,
   "end": 112.98,
   "en": "",
   "zh": "然后他就用他的法力"
  },
  {
   "i": 37,
   "start": 115.14,
   "end": 120.16,
   "en": "",
   "zh": "当火苗穿过院子时，牧师尖叫着跑了起来"
  },
  {
   "i": 38,
   "start": 120.84,
   "end": 122.88,
   "en": "",
   "zh": "一栋大楼着火了"
  },
  {
   "i": 39,
   "start": 122.88,
   "end": 129.039,
   "en": "",
   "zh": "很快修道院的大部分建筑都着火了"
  },
  {
   "i": 40,
   "start": 130.959,
   "end": 134.0,
   "en": "",
   "zh": "墙壁倒塌，屋顶塌陷"
  },
  {
   "i": 41,
   "start": 135.68,
   "end": 137.16,
   "en": "",
   "zh": "逃命吧"
  },
  {
   "i": 42,
   "start": 137.16,
   "end": 139.0,
   "en": "",
   "zh": "一个牧师喊道"
  },
  {
   "i": 43,
   "start": 139.4,
   "end": 141.28,
   "en": "",
   "zh": "我们的修道院被毁了"
  },
  {
   "i": 44,
   "start": 141.28,
   "end": 142.08,
   "en": "",
   "zh": "另一个叫道"
  },
  {
   "i": 45,
   "start": 143.08,
   "end": 144.2,
   "en": "",
   "zh": "有一栋楼"
  },
  {
   "i": 46,
   "start": 144.2,
   "end": 146.7,
   "en": "",
   "zh": "然而，火没有触及"
  },
  {
   "i": 47,
   "start": 147.0,
   "end": 152.1,
   "en": "",
   "zh": "当寺庙的其余部分被烧毁时，唐僧安详地睡着了"
  },
  {
   "i": 48,
   "start": 154.56,
   "end": 155.5,
   "en": "",
   "zh": "第二天早上"
  },
  {
   "i": 49,
   "start": 155.5,
   "end": 158.34,
   "en": "",
   "zh": "唐僧醒了，打开了门"
  },
  {
   "i": 50,
   "start": 160.859,
   "end": 161.739,
   "en": "",
   "zh": "他喘着气"
  },
  {
   "i": 51,
   "start": 163.499,
   "end": 165.44,
   "en": "",
   "zh": "烟雾在空中飘荡"
  },
  {
   "i": 52,
   "start": 166.26,
   "end": 168.86,
   "en": "",
   "zh": "烧焦的木头成堆地躺着"
  },
  {
   "i": 53,
   "start": 169.659,
   "end": 172.82,
   "en": "",
   "zh": "大楼的墙壁是黑色的，摇摇欲坠"
  },
  {
   "i": 54,
   "start": 173.58,
   "end": 174.4,
   "en": "",
   "zh": "哦不"
  },
  {
   "i": 55,
   "start": 174.4,
   "end": 176.0,
   "en": "",
   "zh": "唐僧叫道"
  },
  {
   "i": 56,
   "start": 176.0,
   "end": 177.88,
   "en": "",
   "zh": "修道院怎么了"
  },
  {
   "i": 57,
   "start": 178.76,
   "end": 179.76,
   "en": "",
   "zh": "他转过身来"
  },
  {
   "i": 58,
   "start": 181.08,
   "end": 185.22,
   "en": "",
   "zh": "就在那时，他意识到他睡过的那栋楼很好"
  },
  {
   "i": 59,
   "start": 186.72,
   "end": 188.6,
   "en": "",
   "zh": "悟空走了过来"
  },
  {
   "i": 60,
   "start": 192.8,
   "end": 194.08,
   "en": "",
   "zh": "悟空哭了"
  },
  {
   "i": 61,
   "start": 194.08,
   "end": 194.94,
   "en": "",
   "zh": "和尚"
  },
  {
   "i": 62,
   "start": 194.94,
   "end": 196.52,
   "en": "",
   "zh": "这里发生了什么"
  },
  {
   "i": 63,
   "start": 197.099,
   "end": 198.939,
   "en": "",
   "zh": "神父想杀了你"
  },
  {
   "i": 64,
   "start": 198.939,
   "end": 200.18,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 65,
   "start": 200.8,
   "end": 202.16,
   "en": "",
   "zh": "他试图设置建筑"
  },
  {
   "i": 66,
   "start": 202.16,
   "end": 203.82,
   "en": "",
   "zh": "你着火了"
  },
  {
   "i": 67,
   "start": 204.9,
   "end": 206.62,
   "en": "",
   "zh": "唐僧一脸懵逼"
  },
  {
   "i": 68,
   "start": 208.22,
   "end": 209.54,
   "en": "",
   "zh": "但那栋楼很好"
  },
  {
   "i": 69,
   "start": 209.54,
   "end": 211.22,
   "en": "",
   "zh": "火没有烧到它"
  },
  {
   "i": 70,
   "start": 211.619,
   "end": 212.739,
   "en": "",
   "zh": "悟空笑了"
  },
  {
   "i": 71,
   "start": 214.179,
   "end": 216.38,
   "en": "",
   "zh": "我用魔法把火灭了"
  },
  {
   "i": 72,
   "start": 216.819,
   "end": 219.259,
   "en": "",
   "zh": "唐僧挠了挠头"
  },
  {
   "i": 73,
   "start": 219.259,
   "end": 221.34,
   "en": "",
   "zh": "其余的建筑都被烧毁了"
  },
  {
   "i": 74,
   "start": 221.939,
   "end": 223.419,
   "en": "",
   "zh": "我用了我的魔法"
  },
  {
   "i": 75,
   "start": 223.419,
   "end": 223.799,
   "en": "",
   "zh": "我也是"
  },
  {
   "i": 76,
   "start": 223.799,
   "end": 225.8,
   "en": "",
   "zh": "悟空笑着说"
  },
  {
   "i": 77,
   "start": 226.299,
   "end": 229.84,
   "en": "",
   "zh": "我用了一个咒语，只保护你的建筑在长袍里"
  },
  {
   "i": 78,
   "start": 230.58,
   "end": 232.96,
   "en": "",
   "zh": "咒语使火势四处蔓延"
  },
  {
   "i": 79,
   "start": 232.96,
   "end": 237.28,
   "en": "",
   "zh": "虽然唐僧的眼里充满了泪水"
  },
  {
   "i": 80,
   "start": 237.28,
   "end": 239.08,
   "en": "",
   "zh": "他看起来很生气"
  },
  {
   "i": 81,
   "start": 239.76,
   "end": 240.64,
   "en": "",
   "zh": "太可怕了"
  },
  {
   "i": 82,
   "start": 240.64,
   "end": 242.28,
   "en": "",
   "zh": "悟空他哭了"
  },
  {
   "i": 83,
   "start": 242.88,
   "end": 244.98,
   "en": "",
   "zh": "如果你有能力阻止火灾"
  },
  {
   "i": 84,
   "start": 244.98,
   "end": 246.96,
   "en": "",
   "zh": "你应该停止这一切"
  },
  {
   "i": 85,
   "start": 246.96,
   "end": 248.86,
   "en": "",
   "zh": "悟空耸了耸肩"
  },
  {
   "i": 86,
   "start": 249.179,
   "end": 250.759,
   "en": "",
   "zh": "这里的牧师是邪恶的"
  },
  {
   "i": 87,
   "start": 250.759,
   "end": 252.54,
   "en": "",
   "zh": "他们罪有应得"
  },
  {
   "i": 88,
   "start": 254.479,
   "end": 256.238,
   "en": "",
   "zh": "就在这时，他们听到一声喊叫"
  },
  {
   "i": 89,
   "start": 257.238,
   "end": 259.74,
   "en": "",
   "zh": "两个祭司向他们跑去"
  },
  {
   "i": 90,
   "start": 260.24,
   "end": 262.48,
   "en": "",
   "zh": "恶棍喊悟空"
  },
  {
   "i": 91,
   "start": 262.48,
   "end": 264.56,
   "en": "",
   "zh": "你竟敢烧我师父"
  },
  {
   "i": 92,
   "start": 265.72,
   "end": 268.04,
   "en": "",
   "zh": "我要用铁棍打你"
  },
  {
   "i": 93,
   "start": 269.66,
   "end": 272.72,
   "en": "",
   "zh": "两个祭司跪下来鞠了一躬"
  },
  {
   "i": 94,
   "start": 272.72,
   "end": 274.26,
   "en": "",
   "zh": "请原谅我们"
  },
  {
   "i": 95,
   "start": 274.26,
   "end": 275.3,
   "en": "",
   "zh": "一个哭了"
  },
  {
   "i": 96,
   "start": 275.92,
   "end": 277.8,
   "en": "",
   "zh": "我们不想伤害你"
  },
  {
   "i": 97,
   "start": 277.8,
   "end": 279.26,
   "en": "",
   "zh": "还是唐僧"
  },
  {
   "i": 98,
   "start": 279.26,
   "end": 280.44,
   "en": "",
   "zh": "是头"
  },
  {
   "i": 99,
   "start": 280.44,
   "end": 281.58,
   "en": "",
   "zh": "牧师的想法"
  },
  {
   "i": 100,
   "start": 281.58,
   "end": 284.04,
   "en": "",
   "zh": "他是邪恶的悟空"
  },
  {
   "i": 101,
   "start": 284.04,
   "end": 285.88,
   "en": "",
   "zh": "瞪了两个牧师一会儿"
  },
  {
   "i": 102,
   "start": 287.4,
   "end": 288.58,
   "en": "",
   "zh": "然后他放松了"
  },
  {
   "i": 103,
   "start": 288.9,
   "end": 289.82,
   "en": "",
   "zh": "站起来"
  },
  {
   "i": 104,
   "start": 289.82,
   "end": 290.78,
   "en": "",
   "zh": "他说"
  },
  {
   "i": 105,
   "start": 290.78,
   "end": 293.86,
   "en": "",
   "zh": "我相信你只要把浴袍给我们"
  },
  {
   "i": 106,
   "start": 293.86,
   "end": 296.26,
   "en": "",
   "zh": "所以我们可以继续我们的西行之旅"
  },
  {
   "i": 107,
   "start": 296.839,
   "end": 297.359,
   "en": "",
   "zh": "等一下"
  },
  {
   "i": 108,
   "start": 297.359,
   "end": 298.139,
   "en": "",
   "zh": "我们不能"
  },
  {
   "i": 109,
   "start": 298.139,
   "end": 299.039,
   "en": "",
   "zh": "一个牧师说"
  },
  {
   "i": 110,
   "start": 300.119,
   "end": 301.399,
   "en": "",
   "zh": "他在发抖"
  },
  {
   "i": 111,
   "start": 301.399,
   "end": 302.9,
   "en": "",
   "zh": "长袍不见了"
  }
 ]
}
