{
 "id": "jtw20",
 "title": "The Back Bear",
 "source": "bilibili-ai-zh-cc",
 "note": "英文字幕已烧录在视频画面中；本文件只提供可开关的中文隐藏字幕，en 字段为空。",
 "lines": [
  {
   "i": 1,
   "start": 0.6,
   "end": 1.92,
   "en": "",
   "zh": "西游记"
  },
  {
   "i": 2,
   "start": 1.92,
   "end": 3.26,
   "en": "",
   "zh": "第二十章"
  },
  {
   "i": 3,
   "start": 3.26,
   "end": 5.42,
   "en": "",
   "zh": "黑熊精神"
  },
  {
   "i": 4,
   "start": 13.479,
   "end": 16.56,
   "en": "",
   "zh": "悟空怒视着两个害怕的牧师"
  },
  {
   "i": 5,
   "start": 17.26,
   "end": 18.86,
   "en": "",
   "zh": "长袍不见了"
  },
  {
   "i": 6,
   "start": 18.86,
   "end": 19.58,
   "en": "",
   "zh": "他哭了"
  },
  {
   "i": 7,
   "start": 20.82,
   "end": 21.88,
   "en": "",
   "zh": "它去哪儿了？"
  },
  {
   "i": 8,
   "start": 22.58,
   "end": 23.64,
   "en": "",
   "zh": "我们不知道"
  },
  {
   "i": 9,
   "start": 23.64,
   "end": 24.98,
   "en": "",
   "zh": "一个牧师说"
  },
  {
   "i": 10,
   "start": 25.48,
   "end": 26.78,
   "en": "",
   "zh": "我们试图找到它"
  },
  {
   "i": 11,
   "start": 26.78,
   "end": 27.98,
   "en": "",
   "zh": "另一个补充说"
  },
  {
   "i": 12,
   "start": 27.98,
   "end": 30.8,
   "en": "",
   "zh": "绳子在一个根本没有被烧毁的房间里"
  },
  {
   "i": 13,
   "start": 31.12,
   "end": 32.98,
   "en": "",
   "zh": "但它已经不在那里了"
  },
  {
   "i": 14,
   "start": 33.64,
   "end": 38.12,
   "en": "",
   "zh": "他的铁棍立刻从耳朵里出现了"
  },
  {
   "i": 15,
   "start": 41.74,
   "end": 45.06,
   "en": "",
   "zh": "猴子把它甩向两个牧师"
  },
  {
   "i": 16,
   "start": 45.06,
   "end": 47.06,
   "en": "",
   "zh": "但在酒吧击中他们之前"
  },
  {
   "i": 17,
   "start": 47.06,
   "end": 49.019,
   "en": "",
   "zh": "它从猴子手里掉了下来"
  },
  {
   "i": 18,
   "start": 50.38,
   "end": 52.22,
   "en": "",
   "zh": "悟空倒地"
  },
  {
   "i": 19,
   "start": 52.22,
   "end": 54.03,
   "en": "",
   "zh": "痛苦地哭泣"
  },
  {
   "i": 20,
   "start": 54.03,
   "end": 54.93,
   "en": "",
   "zh": "很痛"
  },
  {
   "i": 21,
   "start": 54.93,
   "end": 55.89,
   "en": "",
   "zh": "很痛"
  },
  {
   "i": 22,
   "start": 55.89,
   "end": 56.59,
   "en": "",
   "zh": "他哭了"
  },
  {
   "i": 23,
   "start": 57.87,
   "end": 59.99,
   "en": "",
   "zh": "唐僧在安静地背诵"
  },
  {
   "i": 24,
   "start": 59.99,
   "end": 63.62,
   "en": "",
   "zh": "紧箍咒悟空滚来滚去"
  },
  {
   "i": 25,
   "start": 63.62,
   "end": 65.36,
   "en": "",
   "zh": "又踢又叫"
  },
  {
   "i": 26,
   "start": 65.36,
   "end": 68.16,
   "en": "",
   "zh": "两个牧师跳起来后退"
  },
  {
   "i": 27,
   "start": 68.4,
   "end": 70.08,
   "en": "",
   "zh": "停止念咒语"
  },
  {
   "i": 28,
   "start": 70.08,
   "end": 71.88,
   "en": "",
   "zh": "悟空对唐僧大吼大叫"
  },
  {
   "i": 29,
   "start": 73.08,
   "end": 74.16,
   "en": "",
   "zh": "我求你了"
  },
  {
   "i": 30,
   "start": 74.16,
   "end": 75.98,
   "en": "",
   "zh": "我不会伤害牧师"
  },
  {
   "i": 31,
   "start": 76.66,
   "end": 78.26,
   "en": "",
   "zh": "唐僧停了下来"
  },
  {
   "i": 32,
   "start": 78.26,
   "end": 80.14,
   "en": "",
   "zh": "悟空站了起来"
  },
  {
   "i": 33,
   "start": 83.0,
   "end": 88.64,
   "en": "",
   "zh": "猴子深吸了一口气，把铁棍放回耳朵里"
  },
  {
   "i": 34,
   "start": 89.0,
   "end": 91.36,
   "en": "",
   "zh": "唐僧看着那两个和尚"
  },
  {
   "i": 35,
   "start": 92.36,
   "end": 95.86,
   "en": "",
   "zh": "你真的不知道长袍在哪里不"
  },
  {
   "i": 36,
   "start": 95.86,
   "end": 97.36,
   "en": "",
   "zh": "一个牧师说"
  },
  {
   "i": 37,
   "start": 97.78,
   "end": 100.08,
   "en": "",
   "zh": "教长昨晚跑了"
  },
  {
   "i": 38,
   "start": 100.08,
   "end": 101.84,
   "en": "",
   "zh": "他没带在身上"
  },
  {
   "i": 39,
   "start": 102.26,
   "end": 104.06,
   "en": "",
   "zh": "悟空拍了拍下巴"
  },
  {
   "i": 40,
   "start": 105.22,
   "end": 107.86,
   "en": "",
   "zh": "可能被怪物或恶魔偷走了"
  },
  {
   "i": 41,
   "start": 108.46,
   "end": 108.94,
   "en": "",
   "zh": "有没有"
  },
  {
   "i": 42,
   "start": 108.94,
   "end": 111.24,
   "en": "",
   "zh": "住在附近的妖魔鬼怪"
  },
  {
   "i": 43,
   "start": 112.08,
   "end": 114.92,
   "en": "",
   "zh": "有些人相信附近的山上有怪物"
  },
  {
   "i": 44,
   "start": 114.92,
   "end": 115.84,
   "en": "",
   "zh": "另一个牧师说"
  },
  {
   "i": 45,
   "start": 116.92,
   "end": 119.06,
   "en": "",
   "zh": "他们说是黑熊精"
  },
  {
   "i": 46,
   "start": 119.86,
   "end": 121.82,
   "en": "",
   "zh": "我去看看熊是不是把睡袍拿走了"
  },
  {
   "i": 47,
   "start": 121.82,
   "end": 123.08,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 48,
   "start": 123.08,
   "end": 124.58,
   "en": "",
   "zh": "我很快就回来"
  },
  {
   "i": 49,
   "start": 125.76,
   "end": 129.56,
   "en": "",
   "zh": "悟空腾空而起落在山间"
  },
  {
   "i": 50,
   "start": 134.079,
   "end": 135.179,
   "en": "",
   "zh": "他走了一会儿"
  },
  {
   "i": 51,
   "start": 135.179,
   "end": 136.959,
   "en": "",
   "zh": "然后听到声音"
  },
  {
   "i": 52,
   "start": 138.28,
   "end": 139.82,
   "en": "",
   "zh": "从巨石上偷看"
  },
  {
   "i": 53,
   "start": 139.82,
   "end": 142.58,
   "en": "",
   "zh": "他看到一群鬼魂在说话"
  },
  {
   "i": 54,
   "start": 143.04,
   "end": 145.7,
   "en": "",
   "zh": "一个是一只大黑熊"
  },
  {
   "i": 55,
   "start": 147.739,
   "end": 149.059,
   "en": "",
   "zh": "熊笑了"
  },
  {
   "i": 56,
   "start": 149.059,
   "end": 152.18,
   "en": "",
   "zh": "昨晚修道院着火了"
  },
  {
   "i": 57,
   "start": 152.62,
   "end": 154.22,
   "en": "",
   "zh": "我去查看了一下"
  },
  {
   "i": 58,
   "start": 154.22,
   "end": 156.76,
   "en": "",
   "zh": "找到了一件奇妙的佛袍"
  },
  {
   "i": 59,
   "start": 157.44,
   "end": 159.68,
   "en": "",
   "zh": "我想它是佛教的珍宝"
  },
  {
   "i": 60,
   "start": 161.32,
   "end": 161.72,
   "en": "",
   "zh": "无论如何"
  },
  {
   "i": 61,
   "start": 161.72,
   "end": 163.36,
   "en": "",
   "zh": "我偷的"
  },
  {
   "i": 62,
   "start": 163.68,
   "end": 164.62,
   "en": "",
   "zh": "所以今晚"
  },
  {
   "i": 63,
   "start": 164.62,
   "end": 167.78,
   "en": "",
   "zh": "我要设宴庆祝"
  },
  {
   "i": 64,
   "start": 169.32,
   "end": 171.74,
   "en": "",
   "zh": "当悟空听到其他精灵的笑声"
  },
  {
   "i": 65,
   "start": 171.74,
   "end": 173.38,
   "en": "",
   "zh": "他怒不可遏"
  },
  {
   "i": 66,
   "start": 173.64,
   "end": 177.36,
   "en": "",
   "zh": "他跳过巨石，落在人群中间"
  },
  {
   "i": 67,
   "start": 178.299,
   "end": 180.779,
   "en": "",
   "zh": "马上把袍子还给我他叫道"
  },
  {
   "i": 68,
   "start": 181.859,
   "end": 183.94,
   "en": "",
   "zh": "他拔出铁棍"
  },
  {
   "i": 69,
   "start": 184.179,
   "end": 186.459,
   "en": "",
   "zh": "不然我就把你们全灭了"
  },
  {
   "i": 70,
   "start": 187.659,
   "end": 190.499,
   "en": "",
   "zh": "鬼怪们四散奔逃"
  },
  {
   "i": 71,
   "start": 192.06,
   "end": 195.98,
   "en": "",
   "zh": "悟空一直追到洞口"
  },
  {
   "i": 72,
   "start": 204.22,
   "end": 206.46,
   "en": "",
   "zh": "悟空敲开洞门"
  },
  {
   "i": 73,
   "start": 207.66,
   "end": 208.7,
   "en": "",
   "zh": "立刻出来"
  },
  {
   "i": 74,
   "start": 208.7,
   "end": 210.3,
   "en": "",
   "zh": "不然我就把门撞开"
  },
  {
   "i": 75,
   "start": 211.58,
   "end": 213.16,
   "en": "",
   "zh": "门飞开了"
  },
  {
   "i": 76,
   "start": 213.58,
   "end": 215.22,
   "en": "",
   "zh": "熊走了出来"
  },
  {
   "i": 77,
   "start": 215.22,
   "end": 217.1,
   "en": "",
   "zh": "他拿着一支长矛"
  },
  {
   "i": 78,
   "start": 218.06,
   "end": 220.7,
   "en": "",
   "zh": "你怎么敢敲我的门"
  },
  {
   "i": 79,
   "start": 220.7,
   "end": 221.66,
   "en": "",
   "zh": "对我大喊大叫"
  },
  {
   "i": 80,
   "start": 221.66,
   "end": 222.64,
   "en": "",
   "zh": "他哭了"
  },
  {
   "i": 81,
   "start": 223.319,
   "end": 225.059,
   "en": "",
   "zh": "你偷了我主人的袍子"
  },
  {
   "i": 82,
   "start": 225.059,
   "end": 226.2,
   "en": "",
   "zh": "悟空说"
  },
  {
   "i": 83,
   "start": 226.92,
   "end": 228.82,
   "en": "",
   "zh": "我可以为所欲为"
  },
  {
   "i": 84,
   "start": 228.82,
   "end": 230.1,
   "en": "",
   "zh": "熊说"
  },
  {
   "i": 85,
   "start": 230.299,
   "end": 232.659,
   "en": "",
   "zh": "我是黑风之王"
  },
  {
   "i": 86,
   "start": 233.699,
   "end": 237.0,
   "en": "",
   "zh": "我是山里最强大的怪物"
  },
  {
   "i": 87,
   "start": 238.059,
   "end": 239.919,
   "en": "",
   "zh": "我是孙悟空"
  },
  {
   "i": 88,
   "start": 239.919,
   "end": 241.819,
   "en": "",
   "zh": "花果山之王"
  },
  {
   "i": 89,
   "start": 241.819,
   "end": 243.139,
   "en": "",
   "zh": "猴子说"
  },
  {
   "i": 90,
   "start": 243.139,
   "end": 245.219,
   "en": "",
   "zh": "我在天堂惹了很多麻烦"
  },
  {
   "i": 91,
   "start": 245.219,
   "end": 246.82,
   "en": "",
   "zh": "五百年前"
  },
  {
   "i": 92,
   "start": 247.1,
   "end": 250.4,
   "en": "",
   "zh": "玉帝全军都打不过我"
  },
  {
   "i": 93,
   "start": 251.659,
   "end": 254.179,
   "en": "",
   "zh": "黑风王哼了一声"
  },
  {
   "i": 94,
   "start": 254.179,
   "end": 254.779,
   "en": "",
   "zh": "你"
  },
  {
   "i": 95,
   "start": 254.779,
   "end": 256.019,
   "en": "",
   "zh": "别让我印象深刻"
  },
  {
   "i": 96,
   "start": 257.019,
   "end": 261.44,
   "en": "",
   "zh": "他用长矛戳了一下悟空当"
  },
  {
   "i": 97,
   "start": 261.44,
   "end": 264.44,
   "en": "",
   "zh": "猴子用铁棍挡住了长矛"
  },
  {
   "i": 98,
   "start": 265.5,
   "end": 267.26,
   "en": "",
   "zh": "跌跌撞撞滚下坡"
  },
  {
   "i": 99,
   "start": 267.26,
   "end": 269.18,
   "en": "",
   "zh": "当两个战士战斗的时候"
  },
  {
   "i": 100,
   "start": 270.58,
   "end": 272.22,
   "en": "",
   "zh": "经过一个小时的战斗"
  },
  {
   "i": 101,
   "start": 272.22,
   "end": 275.08,
   "en": "",
   "zh": "黑风王举起一只手"
  },
  {
   "i": 102,
   "start": 275.759,
   "end": 277.979,
   "en": "",
   "zh": "我需要休息一下"
  },
  {
   "i": 103,
   "start": 277.979,
   "end": 280.22,
   "en": "",
   "zh": "该吃午饭了"
  },
  {
   "i": 104,
   "start": 280.739,
   "end": 283.139,
   "en": "",
   "zh": "悟空的下巴裂开了"
  },
  {
   "i": 105,
   "start": 283.139,
   "end": 285.48,
   "en": "",
   "zh": "以前是什么"
  },
  {
   "i": 106,
   "start": 285.48,
   "end": 287.22,
   "en": "",
   "zh": "悟空什么都可以说"
  },
  {
   "i": 107,
   "start": 287.22,
   "end": 289.64,
   "en": "",
   "zh": "熊跑回了洞穴"
  },
  {
   "i": 108,
   "start": 290.659,
   "end": 292.56,
   "en": "",
   "zh": "门砰的一声关上了"
  }
 ]
}
