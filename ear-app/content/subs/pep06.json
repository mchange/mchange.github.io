   "i": 57,
   "zh": "非常好，佩奇。"
  },
  {
   "start": 214.881,
   "end": 218.72,
   "en": "And George has painted a dinosaur.",
   "i": 58,
   "zh": "乔治画了一只恐龙。"
  },
  {
   "start": 218.721,
   "end": 220.08,
   "en": "Grr.",
   "i": 59,
   "zh": "哥们。"
  },
  {
   "start": 220.081,
   "end": 221.4,
   "en": "Dinosaur.",
   "i": 60,
   "zh": "恐龙。"
  },
  {
   "start": 224.321,
   "end": 230.48,
   "en": "Brilliant.",
   "i": 61,
   "zh": "太棒了。"
  },
  {
