   "i": 49,
   "zh": "哦，我确信他足够大了。"
  },
  {
   "start": 235.95,
   "end": 238.6,
   "en": "No he isn't, Daddy, watch.",
   "i": 50,
   "zh": "不，他不是，爸爸，看。"
  },
  {
   "start": 239.3,
   "end": 240.6,
   "en": "Catch it, George.",
   "i": 51,
   "zh": "抓住它，乔治。"
  },
  {
   "start": 240.601,
   "end": 242.6,
   "en": "Hooray!",
   "i": 52,
   "zh": "好耶！"
  },
  {
   "start": 244.6,
   "end": 246.6,
