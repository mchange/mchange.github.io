 "lines": [
  {
   "start": 3.4,
   "end": 7.702,
   "en": "I'm Peppa Pig, this is my little brother George,",
   "i": 1,
   "zh": "我是佩奇，这是我的弟弟乔治，"
  },
  {
   "start": 7.726,
   "end": 11.4,
   "en": "this is Mummy Pig, and this is Daddy Pig.",
   "i": 2,
   "zh": "这是猪妈妈，这是猪爸爸。"
  },
  {
   "start": 11.401,
   "end": 14.6,
   "en": "Peppa Pig!",
   "i": 3,
   "zh": "小猪佩奇！"
  },
  {
   "start": 20.65,
   "end": 22.6,
   "en": "Piggie in the middle!",
   "i": 4,
   "zh": "小猪在中间！"
  },
  {
   "start": 28.6,
   "end": 31.6,
   "en": "George is playing with his ball in the garden.",
   "i": 5,
   "zh": "乔治正在花园里玩他的球。"
  },
  {
   "start": 39.6,
   "end": 41.6,
   "en": "Peppa wants to play too.",
   "i": 6,
   "zh": "佩奇也想玩。"
  },
  {
   "start": 41.874,
   "end": 44.6,
   "en": "George, you're doing it all wrong!",
   "i": 7,
   "zh": "乔治，你完全错了！"
  },
  {
   "start": 47.6,
   "end": 49.6,
   "en": "This is how to catch a ball.",
   "i": 8,
   "zh": "这就是接球的方法。"
  },
  {
   "start": 54.849,
   "end": 56.6,
   "en": "Not like this.",
   "i": 9,
   "zh": "不是这样的。"
  },
  {
   "start": 59.6,
   "end": 61.6,
   "en": "That's what you do.",
   "i": 10,
   "zh": "这就是你所做的。"
  },
  {
   "start": 61.601,
   "end": 64.599,
   "en": "What a cheeky little one Peppa is!",
   "i": 11,
   "zh": "佩奇真是个厚脸皮的小家伙！"
  },
  {
   "start": 66.6,
   "end": 69.6,
   "en": "George, come back you little piggies!",
   "i": 12,
   "zh": "乔治，回来吧，小猪们！"
  },
  {
   "start": 89.5,
   "end": 93.6,
   "en": "Maybe Peppa is teasing George just a bit too much.",
   "i": 13,
   "zh": "也许佩奇戏弄乔治有点太多了。"
  },
  {
   "start": 95.249,
   "end": 97.6,
   "en": "Peppa, have you been teasing George?",
   "i": 14,
   "zh": "佩奇，你是不是在捉弄乔治？"
  },
  {
   "start": 97.601,
   "end": 101.6,
   "en": "Not really Mummy, I was teaching him how to catch.",
   "i": 15,
   "zh": "不是妈妈，我在教他如何抓。"
  },
  {
   "start": 101.849,
   "end": 105.6,
   "en": "Really? Oh, well I know a game that will teach George how to catch.",
   "i": 16,
   "zh": "真的吗？哦，我知道有一个游戏可以教乔治如何接球。"
  },
  {
   "start": 105.601,
   "end": 107.6,
   "en": "It's called Piggy in the Middle.",
   "i": 17,
   "zh": "它的名字叫《中间的小猪》。"
  },
  {
   "start": 109.6,
   "end": 114.6,
   "en": "Peppa, you take the ball and stand over there, and George, you stand over there.",
   "i": 18,
   "zh": "佩奇，你拿着球站在那里，乔治，你站在那里。"
  },
  {
   "start": 115.6,
   "end": 121.6,
   "en": "Good, you have to throw the ball to each other, and I have to try and catch it.",
   "i": 19,
   "zh": "好，你们必须把球扔给对方，而我必须尝试接住它。"
  },
  {
   "start": 121.601,
   "end": 123.6,
   "en": "I'm the piggy in the middle.",
   "i": 20,
   "zh": "我是中间的小猪。"
  },
  {
   "start": 123.874,
   "end": 126.6,
   "en": "Mummy is the piggy in the middle!",
   "i": 21,
   "zh": "妈妈就是中间的小猪！"
  },
  {
   "start": 128.6,
   "end": 130.6,
   "en": "Catch George!",
   "i": 22,
   "zh": "抓住乔治！"
  },
  {
   "start": 130.7,
   "end": 132.6,
   "en": "Oh, missed it!",
   "i": 23,
   "zh": "噢，错过了！"
  },
  {
   "start": 133.474,
   "end": 135.6,
   "en": "George has caught the ball.",
   "i": 24,
   "zh": "乔治接住了球。"
  },
  {
