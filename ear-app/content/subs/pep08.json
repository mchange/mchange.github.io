   "i": 34,
   "zh": "球我拿到了，佩奇，现在轮到你当小猪了。"
  },
  {
   "start": 184.3,
   "end": 185.6,
   "en": "George, catch!",
   "i": 35,
   "zh": "乔治，接住！"
  },
  {
   "start": 186.6,
   "end": 188.6,
   "en": "Hooray!",
   "i": 36,
   "zh": "好耶！"
  },
  {
   "start": 189.6,
   "end": 190.6,
   "en": "Got it!",
   "i": 37,
   "zh": "明白了！"
  },
  {
   "start": 190.601,
   "end": 193.6,
