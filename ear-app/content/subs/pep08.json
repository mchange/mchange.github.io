   "end": 137.6,
   "en": "Hooray!",
   "i": 25,
   "zh": "好耶！"
  },
  {
   "start": 137.601,
   "end": 140.6,
   "en": "Well done George, now you throw the ball to Peppa.",
   "i": 26,
   "zh": "干得好，乔治，现在你把球扔给佩奇。"
  },
  {
   "start": 142.6,
   "end": 145.6,
   "en": "Try again.",
   "i": 27,
   "zh": "再试一次。"
  },
  {
   "start": 145.601,
   "end": 147.6,
   "en": "Oh, try again.",
   "i": 28,
   "zh": "哦，再试一次。"
  },
  {
   "start": 149.549,
   "end": 152.6,
   "en": "George cannot throw the ball past Mummy Pig.",
   "i": 29,
   "zh": "乔治不能把球扔过猪妈妈。"
  },
  {
   "start": 152.601,
   "end": 155.6,
   "en": "Come on George, give the ball to me.",
   "i": 30,
   "zh": "乔治，来吧，把球给我。"
  },
  {
   "start": 161.6,
   "end": 163.6,
   "en": "Silly George.",
   "i": 31,
   "zh": "傻乔治。"
  },
  {
   "start": 164.65,
   "end": 166.6,
   "en": "I can do that too.",
   "i": 32,
   "zh": "我也能做到。"
  },
  {
   "start": 168.6,
   "end": 173.6,
