   "zh": "加油猪爸爸，是时候做点事情了。"
  },
  {
   "start": 186.001,
   "end": 188.0,
   "en": "Goodbye Mummy Pig and Daddy Pig.",
   "i": 50,
   "zh": "再见猪妈妈和猪爸爸。"
  },
  {
   "start": 188.15,
   "end": 189.15,
   "en": "Goodbye.",
   "i": 51,
   "zh": "再见。"
  },
  {
   "start": 193.0,
   "end": 195.0,
   "en": "Daddy Pig is digging in the garden.",
   "i": 52,
   "zh": "猪爸爸正在花园里挖土。"
  },
  {
   "start": 197.0,
   "end": 199.0,
   "en": "Hello Peppa, hello George.",
   "i": 53,
   "zh": "你好佩奇，你好乔治。"
  },
  {
   "start": 199.924,
   "end": 202.0,
   "en": "I'm not Peppa, I'm Mummy Pig.",
   "i": 54,
   "zh": "我不是佩奇，我是猪妈妈。"
  },
  {
   "start": 202.05,
   "end": 204.0,
   "en": "And this is Daddy Pig.",
   "i": 55,
   "zh": "这是猪爸爸。"
  },
  {
   "start": 205.45,
   "end": 207.0,
   "en": "Daddy Pig is here to do some work.",
   "i": 56,
   "zh": "猪爸爸来干活了。"
  },
  {
   "start": 207.001,
   "end": 209.0,
