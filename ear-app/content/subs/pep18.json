  },
  {
   "start": 25.0,
   "end": 29.0,
   "en": "Peppa and George are playing Mummy and Daddy's Playroom.",
   "i": 5,
   "zh": "佩奇和乔治正在玩妈妈和爸爸的游戏室。"
  },
  {
   "start": 30.0,
   "end": 32.0,
   "en": "Dressing up",
   "i": 6,
   "zh": "装扮"
  },
  {
   "start": 33.0,
   "end": 35.0,
   "en": "What's this?",
   "i": 7,
   "zh": "这是什么？"
  },
  {
   "start": 35.149,
   "end": 37.0,
   "en": "Peppa has found a box of old clothes.",
   "i": 8,
   "zh": "佩奇找到了一盒旧衣服。"
  },
  {
   "start": 37.001,
   "end": 39.0,
   "en": "Wow!",
   "i": 9,
   "zh": "哇！"
  },
  {
   "start": 39.001,
   "end": 41.0,
   "en": "This is Daddy's hat.",
   "i": 10,
   "zh": "这是爸爸的帽子。"
  },
  {
   "start": 41.05,
   "end": 43.0,
   "en": "And this is Mummy's dress.",
   "i": 11,
   "zh": "这是妈妈的衣服。"
  },
  {
   "start": 43.05,
   "end": 48.0,
   "en": "George, let's dress up and pretend to be Mummy and Daddy.",
   "i": 12,
   "zh": "乔治，让我们装扮成妈妈和爸爸吧。"
  },
  {
   "start": 49.149,
   "end": 51.0,
   "en": "Here is Daddy's hat.",
   "i": 13,
   "zh": "这是爸爸的帽子。"
  },
  {
   "start": 52.699,
   "end": 54.0,
   "en": "And here is Daddy's coat.",
   "i": 14,
   "zh": "这是爸爸的外套。"
  },
  {
   "start": 56.0,
   "end": 58.0,
   "en": "Hello Daddy Pig.",
   "i": 15,
   "zh": "猪爸爸你好。"
  },
  {
   "start": 61.0,
   "end": 63.0,
   "en": "Now it's my turn.",
   "i": 16,
   "zh": "现在轮到我了。"
  },
  {
   "start": 63.999,
   "end": 66.0,
   "en": "This is Mummy's dress.",
   "i": 17,
   "zh": "这是妈妈的衣服。"
  },
  {
   "start": 67.299,
   "end": 69.0,
   "en": "This is Mummy's hat.",
   "i": 18,
   "zh": "这是妈妈的帽子。"
  },
  {
   "start": 73.324,
   "end": 76.0,
   "en": "Daddy Pig, where are your shoes?",
   "i": 19,
   "zh": "猪爸爸，你的鞋子呢？"
  },
  {
   "start": 82.049,
   "end": 85.0,
   "en": "I need some shoes too.",
   "i": 20,
   "zh": "我也需要一些鞋子。"
  },
  {
   "start": 91.0,
   "end": 95.0,
   "en": "Now I need to look beautiful, just like Mummy.",
   "i": 21,
   "zh": "现在我需要看起来很漂亮，就像妈妈一样。"
  },
  {
   "start": 97.149,
   "end": 100.0,
