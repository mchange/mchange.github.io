   "zh": "好漂亮的猪妈妈。"
  },
  {
   "start": 120.299,
   "end": 123.0,
   "en": "Come along Daddy Pig, it's time to go to work.",
   "i": 28,
   "zh": "猪爸爸来吧，上班时间到了。"
  },
  {
   "start": 127.349,
   "end": 130.0,
   "en": "Mummy Pig is working on her computer.",
   "i": 29,
   "zh": "猪妈妈正在电脑上工作。"
  },
  {
   "start": 131.0,
   "end": 133.0,
   "en": "Hello Peppa, hello George.",
   "i": 30,
   "zh": "你好佩奇，你好乔治。"
  },
  {
   "start": 133.001,
   "end": 135.0,
   "en": "I beg your pardon.",
   "i": 31,
   "zh": "请原谅。"
  },
