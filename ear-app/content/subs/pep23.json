   "end": 235.0,
   "en": "Can we open the roof again?",
   "i": 64,
   "zh": "我们可以再打开屋顶吗？"
  },
  {
   "start": 235.001,
   "end": 238.0,
   "en": "Yes. Which button was it?",
   "i": 65,
   "zh": "是的。是哪个按钮？"
  },
  {
   "start": 238.001,
   "end": 240.0,
   "en": "The red one!",
   "i": 66,
   "zh": "红色的！"
  },
  {
   "start": 241.0,
   "end": 243.0,
   "en": "Hooray!",
   "i": 67,
   "zh": "好耶！"
  },
  {
   "start": 245.0,
   "end": 248.0,
   "en": "Grandad Dog has fixed the car.",
   "i": 68,
   "zh": "狗爷爷修好了车。"
  },
