  },
  {
   "start": 187.0,
   "end": 190.0,
   "en": "Now, which is the button to close the roof?",
   "i": 50,
   "zh": "现在，关闭车顶的按钮是哪个？"
  },
  {
   "start": 193.0,
   "end": 194.0,
   "en": "Oops!",
   "i": 51,
   "zh": "哎呀！"
  },
  {
   "start": 197.0,
   "end": 200.0,
