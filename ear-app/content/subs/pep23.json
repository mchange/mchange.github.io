   "en": "Goodbye!",
   "i": 73,
   "zh": "再见！"
  },
  {
   "start": 261.001,
   "end": 262.0,
   "en": "Goodbye!",
   "i": 74,
   "zh": "再见！"
  },
  {
   "start": 262.001,
   "end": 263.001,
   "en": "Bye-bye!",
   "i": 75,
   "zh": "再见！"
  },
  {
   "start": 266.0,
   "end": 269.0,
   "en": "Ah, it's good to get our old car back again.",
   "i": 76,
   "zh": "啊，我们的旧车又回来了，真是太好了。"
  },
  {
   "start": 269.001,
   "end": 271.0,
   "en": "I like the new car.",
   "i": 77,
   "zh": "我喜欢这辆新车。"
