{
 "id": "pep23",
 "title": "The New Car",
 "source": "peppa-s1-en-srt + zh-translation",
 "note": "英文人工 SRT 与中文翻译逐条对齐；纯音效/水印行已剔除。",
 "lines": [
  {
   "start": 7.0,
   "end": 10.828,
   "en": "I'm Peppa Pig. This is my little brother George.",
   "i": 1,
   "zh": "我是佩奇。这是我的弟弟乔治。"
  },
  {
   "start": 10.852,
   "end": 15.012,
   "en": "This is Mommy Pig. And this is Daddy Pig. Peppa Pig.",
   "i": 2,
   "zh": "这是猪妈妈。这就是猪爸爸。佩奇。"
  },
  {
   "start": 20.2,
   "end": 22.0,
   "en": "The New Car",
   "i": 3,
   "zh": "新车"
  },
  {
   "start": 27.0,
   "end": 31.0,
   "en": "Today, Peppa and her family are going for a drive in their red car.",
   "i": 4,
   "zh": "今天，佩奇和她的家人要开着他们的红色汽车去兜风。"
  },
  {
   "start": 31.001,
   "end": 33.0,
   "en": "Shall we have the roof down?",
   "i": 5,
   "zh": "我们可以把屋顶拆下来吗？"
  },
  {
   "start": 33.099,
   "end": 35.0,
   "en": "Yes, please.",
   "i": 6,
   "zh": "好的，谢谢。"
  },
  {
   "start": 39.0,
   "end": 41.0,
   "en": "Peppa and George love their car.",
   "i": 7,
   "zh": "佩奇和乔治喜欢他们的车。"
  },
  {
   "start": 41.001,
   "end": 42.0,
   "en": "Is everybody ready?",
   "i": 8,
   "zh": "大家准备好了吗？"
  },
  {
   "start": 42.001,
   "end": 43.0,
   "en": "Ready!",
   "i": 9,
   "zh": "准备好了！"
  },
  {
   "start": 43.001,
   "end": 45.0,
   "en": "Then let's go!",
   "i": 10,
   "zh": "那我们走吧！"
  },
  {
   "start": 52.0,
   "end": 54.0,
   "en": "I love our car.",
   "i": 11,
   "zh": "我喜欢我们的车。"
  },
  {
   "start": 54.001,
   "end": 57.0,
   "en": "And our car loves us too, don't you?",
   "i": 12,
   "zh": "我们的车也爱我们，不是吗？"
  },
  {
   "start": 64.0,
   "end": 67.0,
   "en": "Oh dear, the car does not sound very well.",
   "i": 13,
   "zh": "噢，亲爱的，这辆车听起来不太好。"
  },
  {
   "start": 71.949,
   "end": 74.0,
   "en": "What's wrong, Daddy?",
   "i": 14,
   "zh": "怎么了，爸爸？"
  },
  {
   "start": 74.001,
   "end": 76.0,
   "en": "I don't know.",
   "i": 15,
   "zh": "我不知道。"
  },
  {
   "start": 76.001,
   "end": 80.0,
   "en": "Let's take it to Grandad Dog's garage. He can fix it.",
   "i": 16,
   "zh": "去狗爷爷的车库吧。他可以解决它。"
  },
  {
   "start": 80.001,
   "end": 82.0,
   "en": "That's a good idea, Mommy Pig.",
   "i": 17,
   "zh": "这是个好主意，猪妈妈。"
  },
  {
   "start": 85.0,
   "end": 90.0,
   "en": "Grandad Dog runs the garage. He is very good at mending cars.",
   "i": 18,
   "zh": "狗爷爷经营车库。他非常擅长修理汽车。"
  },
  {
   "start": 94.0,
   "end": 99.0,
   "en": "Oh dear, Daddy Pig. Your car does not sound very well.",
   "i": 19,
   "zh": "亲爱的猪爸爸。你的车听起来不太好。"
  },
  {
   "start": 99.199,
   "end": 102.0,
   "en": "Can you fix it please, Grandad Dog?",
   "i": 20,
   "zh": "狗爷爷你能修好吗？"
  },
  {
   "start": 102.001,
   "end": 106.0,
   "en": "Yes, but it will take all day.",
   "i": 21,
   "zh": "是的，但是需要一整天的时间。"
  },
  {
   "start": 107.0,
   "end": 110.0,
   "en": "We wanted to go for a drive in our car.",
   "i": 22,
   "zh": "我们想开车去兜风。"
  },
  {
   "start": 110.001,
   "end": 114.0,
   "en": "Don't worry, you can borrow this new car while I fix yours.",
   "i": 23,
   "zh": "别担心，你可以借这辆新车，我来修理你的车。"
  },
  {
   "start": 114.001,
   "end": 116.0,
   "en": "Hooray!",
   "i": 24,
   "zh": "好耶！"
  },
  {
   "start": 116.001,
   "end": 118.0,
   "en": "Thank you, Grandad Dog.",
   "i": 25,
   "zh": "谢谢狗爷爷。"
  },
  {
   "start": 118.001,
   "end": 119.0,
   "en": "Would you like the roof down?",
   "i": 26,
   "zh": "你想把屋顶放下吗？"
  },
  {
   "start": 119.001,
   "end": 121.0,
   "en": "Yes, please.",
   "i": 27,
   "zh": "好的，谢谢。"
  },
  {
   "start": 121.001,
   "end": 124.0,
   "en": "I'll just press this red button.",
   "i": 28,
   "zh": "我只需按这个红色按钮即可。"
  },
  {
   "start": 125.099,
   "end": 127.0,
   "en": "What a clever car.",
   "i": 29,
   "zh": "多么聪明的车啊。"
  },
  {
   "start": 127.001,
   "end": 129.0,
   "en": "Wow!",
   "i": 30,
   "zh": "哇！"
  },
  {
   "start": 129.15,
   "end": 132.0,
   "en": "When you come back, I will have fixed your car.",
   "i": 31,
   "zh": "当你回来时，我会修好你的车。"
  },
  {
   "start": 132.001,
   "end": 135.0,
   "en": "Thank you, Grandad Dog. Goodbye!",
   "i": 32,
   "zh": "谢谢狗爷爷。再见！"
  },
  {
   "start": 135.001,
   "end": 136.0,
   "en": "Goodbye!",
   "i": 33,
   "zh": "再见！"
  },
  {
   "start": 136.001,
   "end": 137.0,
   "en": "Bye-bye!",
   "i": 34,
   "zh": "再见！"
  },
  {
   "start": 137.001,
   "end": 138.001,
   "en": "Goodbye!",
   "i": 35,
   "zh": "再见！"
  },
  {
   "start": 141.0,
   "end": 144.0,
   "en": "Peppa and her family like the new blue car.",
   "i": 36,
   "zh": "佩奇和她的家人喜欢这辆新的蓝色汽车。"
  },
  {
   "start": 144.4,
   "end": 147.0,
