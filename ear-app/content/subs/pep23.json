  {
   "start": 151.824,
   "end": 154.0,
   "en": "Magic windows!",
   "i": 40,
   "zh": "神奇的窗户！"
  },
  {
   "start": 157.0,
   "end": 160.0,
   "en": "Daddy, make the magic windows go down.",
   "i": 41,
   "zh": "爸爸，让魔法窗户落下。"
  },
  {
   "start": 163.05,
   "end": 165.0,
   "en": "What does the blue button do?",
   "i": 42,
   "zh": "蓝色按钮有什么作用？"
  },
  {
   "start": 165.001,
   "end": 168.0,
   "en": "I don't know. Let's see.",
   "i": 43,
   "zh": "我不知道。让我们来看看。"
  },
  {
   "start": 170.0,
   "end": 173.0,
   "en": "I love this new car. Can we keep it?",
   "i": 44,
   "zh": "我喜欢这辆新车。我们可以保留它吗？"
  },
  {
   "start": 173.001,
   "end": 176.0,
   "en": "No, we can't keep it, Peppa.",
   "i": 45,
   "zh": "不，我们不能保留它，佩奇。"
